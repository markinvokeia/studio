# API Configuration
# IMPORTANTE: NO incluir /webhook al final — api.ts lo agrega automáticamente
# Playwright E2E credentials
E2E_USER=E2E_USER_MAIL
E2E_PASS=E2E_PASSWORD
NEXT_PUBLIC_API_URL=Backend URL (ej. https://api.invokeia.com)
GOOGLE_GENAI_API_KEY=Google GenAI API Key (ej. AIzaSyA-...)
NEXT_PUBLIC_LICENSE_KEY=ESTAESLAPASSPARAGENERARLICENCIAS
NEXT_PUBLIC_MASTER_SEC=MASTERSECUREKEYPARAELFRONTEND
NEXT_PUBLIC_CLIENT_ID=                  # Identificador del cliente (ej. ceoatlantida)
NEXT_PUBLIC_EVENT_PUSHER_KEY=           # API key para autenticar el browser contra el event-pusher
NEXT_PUBLIC_EVENT_PUSHER_URL=           # Origen del servidor de eventos SSE (ej. https://events.invokeia.com). Vacío = mismo origen vía reverse proxy