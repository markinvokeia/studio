    {
      "parameters": {
        "jsCode": "\nconst assertUuid = (value, field) => {\n  const text = String(value ?? '').trim();\n  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(text)) {\n    throw new Error(`Invalid ${field}: ${value}`);\n  }\n  return text;\n};\n\nconst item = $('users/signature/upload').first();\nconst body = item.json.body ?? item.json ?? {};\n\nconst userId = assertUuid(body.user_id, 'user_id');\n\n// El archivo llega en la propiedad binaria `data` (el front hace\n// formData.append('data', file), igual que el logo de clínica).\nconst binary = item.binary?.data0 || item.binary?.data;\nif (!binary) throw new Error('signature file is required (binary property \"data\")');\n\nconst allowed = ['image/png', 'image/jpeg', 'image/webp'];\nif (!allowed.includes(binary.mimeType)) {\n  throw new Error(`Unsupported signature type: ${binary.mimeType}`);\n}\n\n// 1 MB, el mismo límite que valida el front.\nif (binary.fileSize && Number(String(binary.fileSize).replace(/[^0-9]/g, '')) > 1024 * 1024) {\n  throw new Error('Signature file exceeds 1 MB');\n}\n\nreturn [{\n  json: {\n    user_id: userId,\n    filename: binary.fileName || `signature-${userId}.png`,\n    mimetype: binary.mimeType,\n  },\n  binary: item.binary,\n}];\n"
      },
      "id": "04ee2f56-a434-48c0-b223-52cb09b9d9aa",
      "name": "Validar Entrada2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// El borrado del archivo anterior es best-effort: si falla, la firma nueva ya\n// quedó guardada y no hay razón para devolver un error al usuario.\nconst saved = $('Guardar en users').first().json;\n\nif (!saved || saved.error || !saved.id) {\n  return [{ json: { statusCode: 500, body: { message: 'No se pudo guardar la firma.' } } }];\n}\n\nreturn [{ json: { statusCode: 200, body: {\n  success: true,\n  user_id: saved.id,\n  filename: saved.signature_filename,\n  mimetype: saved.signature_mimetype,\n  updated_at: saved.signature_updated_at,\n} } }];\n"
      },
