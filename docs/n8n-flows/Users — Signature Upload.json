      "parameters": {
        "jsCode": "\n// Si el borrado en Drive falla se ignora: la referencia en BD ya está limpia\n// y el archivo queda huérfano, no roto.\nconst cleared = $('Limpiar en users').first().json;\n\nif (!cleared || cleared.error || !cleared.id) {\n  return [{ json: { statusCode: 500, body: { message: 'No se pudo eliminar la firma.' } } }];\n}\n\nreturn [{ json: { statusCode: 200, body: { success: true, user_id: cleared.id } } }];\n"
