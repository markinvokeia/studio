      "parameters": {
        "operation": "executeQuery",
        "query": "-- `previous` ve la foto anterior al UPDATE: RETURNING devolvería los\n-- valores nuevos (ya NULL) y se perdería el file id que hay que borrar.\nWITH previous AS (\n    SELECT signature_drive_file_id\n    FROM public.users\n    WHERE id = $1::uuid\n), cleared AS (\n    UPDATE public.users\n    SET signature_filename      = NULL,\n        signature_mimetype      = NULL,\n        signature_drive_file_id = NULL,\n        signature_web_view_link = NULL,\n        signature_updated_at    = NOW()\n    WHERE id = $1::uuid\n    RETURNING id\n)\nSELECT cleared.id::text          AS id,\n       previous.signature_drive_file_id AS previous_drive_file_id\nFROM cleared\nCROSS JOIN previous;",
        "options": {
          "queryReplacement": "={{ [ $json.user_id ] }}"
        }
      },
