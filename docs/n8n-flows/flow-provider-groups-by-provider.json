    {
      "id": "pg-provider-groups-set",
      "name": "Set grupos del proveedor",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [40, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT CASE\n           WHEN NULLIF($2, '') IS NULL THEN ARRAY[]::uuid[]\n           ELSE string_to_array($2, ',')::uuid[]\n         END AS ids\n),\ndel AS (\n  DELETE FROM public.group_provider gp\n  USING target t\n  WHERE gp.provider_id = $1::uuid\n    AND NOT (gp.group_id = ANY(t.ids))\n  RETURNING gp.group_id\n),\nins AS (\n  INSERT INTO public.group_provider (group_id, provider_id)\n  SELECT x, $1::uuid\n  FROM target t, unnest(t.ids) AS x\n  ON CONFLICT (group_id, provider_id) DO NOTHING\n  RETURNING group_id\n)\nSELECT\n  (SELECT COUNT(*) FROM ins) AS added,\n  (SELECT COUNT(*) FROM del) AS removed;",
        "options": {
          "queryReplacement": "={{ [$json.body.provider_id, ($json.body.group_ids || []).join(',')] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "6b7Sjdnppbfve8ka",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "resp-provider-groups-set-ok",
      "name": "OK Set Grupos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [280, 420],
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    }
