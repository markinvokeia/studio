    {
      "id": "pg-provider-groups-select",
      "name": "Select grupos del proveedor",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [40, 200],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  g.id,\n  g.name,\n  g.description,\n  g.is_active\nFROM group_provider gp\nJOIN groups_prov g ON g.id = gp.group_id\nWHERE gp.provider_id = $1::uuid\nORDER BY g.name ASC;",
        "options": {
          "queryReplacement": "={{ [$json.query.provider_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "6b7Sjdnppbfve8ka",
          "name": "Postgres account"
        }
      }
    },
