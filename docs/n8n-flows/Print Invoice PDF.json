    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    -- 1. Detalles de la Factura\n    i.id AS invoice_id,\n    i.doc_no AS invoice_doc_no,\n    i.invoice_ref AS invoice_ref,\n    i.status AS invoice_status,\n    i.created_at AS invoice_date,\n    i.currency AS invoice_currency,\n    i.total AS total_amount,\n    i.paid_amount AS amount_paid,\n    i.type AS invoice_type,\n    i.payment_state AS payment_state,\n\n    -- 2. Detalles de la Orden Relacionada\n    o.id AS order_id,\n    o.doc_no AS order_doc_no,\n    o.status AS order_status,\n    o.is_sales AS is_sales_order,\n    o.quote_id AS quote_id,\n\n    q.doc_no AS quote_doc_no,\n\n    -- 3. Detalles del Cliente (User)\n    u.name AS client_name,\n    u.email AS client_email,\n    u.phone_number AS client_phone,\n    u.identity_document AS client_document,\n\n    -- 4. Ítems de la Factura (Subconsulta agregada en JSON)\n    COALESCE(\n        (\n            SELECT json_agg(\n                json_build_object(\n                    'item_id', ii.id,\n                    'quantity', ii.quantity,\n                    'unit_price', ii.unit_price,\n                    'total', ii.total,\n                    'service_name', sc.name,\n                    'description', sc.description,\n                    'category', sc.category\n                )\n            )\n            FROM public.invoice_items ii\n\t\t\tLEFT JOIN public.service_catalog sc ON ii.service_id = sc.id\n            LEFT JOIN public.order_items oi ON ii.order_item_id = oi.id\n            LEFT JOIN public.quote_items qi ON oi.quote_item_id = qi.id\n            WHERE ii.invoice_id = i.id\n        ), \n        '[]'::json\n    ) AS items\n\nFROM public.invoices i\nLEFT JOIN public.users u ON i.user_id = u.id\nLEFT JOIN public.orders o ON i.order_id = o.id\nLEFT JOIN public.quotes q ON o.quote_id = q.id\nWHERE i.id = $1;",
        "options": {
          "queryReplacement": "={{ $json.invoiceId }}"
        }
      },
