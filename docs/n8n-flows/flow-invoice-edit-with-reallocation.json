    {
      "parameters": {
        "jsCode": "const invoiceId = Number($('invoice/items/edit-with-reallocation').first().json.body.invoice_id);\nconst newTotal = Number($('Recalculate Invoice Total').first().json.total);\n\nconst paymentRows = $('Get Payment Allocations').all().map((i) => i.json);\nconst creditRows = $('Get Invoice Allocations').all().map((i) => i.json);\n\n// FIFO por fecha de aplicación original; empate por id ascendente.\nconst pool = [...paymentRows, ...creditRows].sort((a, b) => {\n  const ta = new Date(a.created_at).getTime();\n  const tb = new Date(b.created_at).getTime();\n  if (ta !== tb) return ta - tb;\n  return Number(a.id) - Number(b.id);\n});\n\nconst poolTotal = pool.reduce((sum, row) => sum + Number(row.amount), 0);\n\nlet remaining = newTotal;\nconst toReinsert = [];\n\nfor (const row of pool) {\n  if (remaining <= 0.0001) break;\n  const rowAmount = Number(row.amount);\n  const take = Math.min(rowAmount, remaining);\n  if (take <= 0.0001) continue;\n\n  // Proporción del monto original que efectivamente entra — se aplica también\n  // al target_amount para no perder la relación de tipo de cambio original.\n  const ratio = take / rowAmount;\n\n  toReinsert.push({\n    invoice_id: invoiceId,\n    origin_type: row.origin_type,\n    origin_id: row.origin_id,\n    amount: Math.round(take * 100) / 100,\n    allocated_currency: row.allocated_currency,\n    target_amount: Math.round(Number(row.target_amount) * ratio * 100) / 100,\n    exchange_rate: row.exchange_rate,\n    new_total: newTotal,\n    pool_total: Math.round(poolTotal * 100) / 100,\n  });\n\n  remaining = Math.round((remaining - take) * 100) / 100;\n}\n\nconst reinsertedTotal = toReinsert.reduce((s, r) => s + r.amount, 0);\nconst releasedAmount = Math.round((poolTotal - reinsertedTotal) * 100) / 100;\nfor (const item of toReinsert) item.released_amount = releasedAmount;\n\nif (toReinsert.length === 0) {\n  // No había nada que reasignar (o el nuevo total es 0) — igual se emite un\n  // item \"vacío\" con la metadata necesaria para armar la respuesta final; el\n  // loop de más abajo lo hace pasar sin insertar nada.\n  return [{\n    json: {\n      invoice_id: invoiceId,\n      new_total: newTotal,\n      pool_total: Math.round(poolTotal * 100) / 100,\n      released_amount: releasedAmount,\n      _empty: true,\n    },\n  }];\n}\n\nreturn toReinsert.map((item) => ({ json: item }));"
      },
