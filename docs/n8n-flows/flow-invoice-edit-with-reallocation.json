    {
      "parameters": {
        "jsCode": "const source = $('Merge & Reallocate FIFO').all().map((i) => i.json);\nconst meta = source[0] || {};\n\nconst grouped = {};\nfor (const item of source) {\n  if (item._empty) continue;\n  const key = item.origin_type + ':' + item.origin_id;\n  if (!grouped[key]) grouped[key] = { origin_type: item.origin_type, origin_id: item.origin_id, amount: 0 };\n  grouped[key].amount = Math.round((grouped[key].amount + Number(item.amount)) * 100) / 100;\n}\n\nreturn [{\n  json: {\n    success: true,\n    invoice_id: meta.invoice_id,\n    new_total: meta.new_total,\n    reallocated: Object.values(grouped),\n    released_amount: meta.released_amount,\n    code: 200,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        3120
      ],
