    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  u.id,\n  u.name,\n  u.email,\n  u.phone_number,\n  u.identity_document,\n  u.is_active,\n  COUNT(*) OVER() AS total_count\nFROM group_patients gp\nJOIN users u ON u.id = gp.patient_id\nWHERE gp.group_id = $1::uuid\n  AND (\n    $2::text IS NULL OR $2 = ''\n    OR u.name ILIKE '%' || $2 || '%'\n    OR u.email ILIKE '%' || $2 || '%'\n    OR u.phone_number ILIKE '%' || $2 || '%'\n    OR u.identity_document ILIKE '%' || $2 || '%'\n  )\nORDER BY u.name ASC\nLIMIT $3::int OFFSET $4::int;",
        "options": {
          "queryReplacement": "={{ [$json.query.group_id, $json.query.search || null, Number($json.query.limit || 25), (Number($json.query.page || 1) - 1) * Number($json.query.limit || 25)] }}"
        }
      },
