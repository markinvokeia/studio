        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT CASE\n           WHEN NULLIF($2, '') IS NULL THEN ARRAY[]::uuid[]\n           ELSE string_to_array($2, ',')::uuid[]\n         END AS ids\n),\ndel AS (\n  DELETE FROM public.group_patients gp\n  USING target t\n  WHERE gp.patient_id = $1::uuid\n    AND NOT (gp.group_id = ANY(t.ids))\n  RETURNING gp.group_id\n),\nins AS (\n  INSERT INTO public.group_patients (group_id, patient_id)\n  SELECT x, $1::uuid\n  FROM target t, unnest(t.ids) AS x\n  ON CONFLICT (group_id, patient_id) DO NOTHING\n  RETURNING group_id\n)\nSELECT\n  (SELECT COUNT(*) FROM ins) AS added,\n  (SELECT COUNT(*) FROM del) AS removed;",
