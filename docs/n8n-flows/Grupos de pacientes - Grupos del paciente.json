        "query": "SELECT\n  s.id,\n  s.name,\n  s.category,\n  mc.name AS category_name,\n  s.price,\n  s.currency,\n  s.duration_minutes,\n  s.is_active,\n  COUNT(*) OVER() AS total_count\nFROM group_services gs\nJOIN service_catalog s ON s.id = gs.service_id\nLEFT JOIN miscellaneous_categories mc ON mc.id = s.category_id\nWHERE gs.group_id = $1::uuid\n  AND (\n    $2::text IS NULL OR $2 = ''\n    OR s.name ILIKE '%' || $2 || '%'\n  )\nORDER BY s.name ASC\nLIMIT $3::int OFFSET $4::int;",
