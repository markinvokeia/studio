        "operation": "executeQuery",
        "query": "SELECT \n    (COALESCE(gns.is_enabled, false) AND COALESCE(ucp.is_enabled, true)) AS can_send_notification\nFROM public.global_notification_settings gns\nLEFT JOIN public.user_communication_preferences ucp \n    ON gns.channel_slug = ucp.channel_slug \n    AND gns.category_slug = ucp.category_slug\n    AND ucp.user_id = $1\nWHERE \n    gns.channel_slug = $2\n    AND gns.category_slug = $3",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.channel, $json.category] }}"
        }
