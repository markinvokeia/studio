  "nodes": [
    {
      "id": "3a8e77c3-fe09-41e1-a091-85e8aa003ac5",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -40
      ],
      "parameters": {
        "width": 420,
        "height": 420,
        "content": "## Aesthetic Record — ficha estética\n\nFlujo NUEVO (no reemplaza nada). Requiere database/scripts/151_20261030_aesthetic-record.sql.\n\nUnidades de medida, configuración estética del servicio (unidad + herramienta punto/área), sesiones con capas por servicio y marcas, fotos y consentimiento (binarios en Drive).\n\nErrores: 'AESTHETIC:<CODIGO>|<detalle>' ⇒ 400 { success:false, code, detail }.\n\nGenerado por scripts/n8n/generate-aesthetic-record-workflow.mjs — no editar a mano."
      }
    },
    {
      "name": "Map error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Las funciones lanzan 'AESTHETIC:<CODIGO>|<detalle>'. Cualquier otro error\n// (conexión, constraint inesperada) sale como UNKNOWN con el mensaje crudo.\nconst raw = $json.error?.message ?? $json.error ?? $json.message ?? '';\nconst text = String(raw);\nconst match = text.match(/AESTHETIC:([A-Z_]+)(?:\\|(.*))?/);\nreturn [{ json: {\n  success: false,\n  code: match ? match[1] : 'UNKNOWN',\n  detail: match && match[2] ? match[2].trim() : null,\n  message: text || 'Error',\n} }];"
      },
      "id": "f62d3650-f650-4ea8-b77b-91e11ca44370",
      "position": [
        1400,
        1400
      ]
    },
