    {
      "parameters": {
        "jsCode": "// Valida el body de POST /api/documents/send y arma asunto, cuerpo y nombre del adjunto.\n// El PDF lo genera el frontend con las mismas plantillas de impresión (ya no se usa Gotenberg).\nconst body = $('api/documents/send').first().json.body || {};\n\nconst LABELS = {\n  quote:       { subject: 'Presupuesto',      article: 'el presupuesto' },\n  invoice:     { subject: 'Factura',          article: 'la factura' },\n  credit_note: { subject: 'Nota de crédito',  article: 'la nota de crédito' },\n  payment:     { subject: 'Recibo de pago',   article: 'el recibo de pago' },\n  prepayment:  { subject: 'Recibo de anticipo', article: 'el recibo de anticipo' },\n};\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n// ~10 MB de PDF (base64 ocupa 4/3): Gmail admite 25 MB por mensaje.\nconst MAX_BASE64_LENGTH = 14 * 1024 * 1024;\n\nconst fail = (error) => [{ json: { valid: false, error } }];\n\nconst type = String(body.document_type || '');\nconst label = LABELS[type];\nif (!label) return fail('document_type inválido');\nif (body.document_id == null || body.document_id === '') return fail('document_id requerido');\n\nconst emails = (Array.isArray(body.emails) ? body.emails : [])\n  .map((e) => String(e || '').trim())\n  .filter(Boolean);\nif (emails.length === 0) return fail('Se requiere al menos un correo');\nconst invalid = emails.filter((e) => !EMAIL_RE.test(e));\nif (invalid.length > 0) return fail(`Correos inválidos: ${invalid.join(', ')}`);\n\n// Acepta data URI o base64 pelado; un PDF siempre empieza con \"%PDF\" (= \"JVBER\" en base64).\nconst pdf = String(body.pdf_base64 || '').replace(/^data:application\\/pdf;[^,]*,/, '').replace(/\\s/g, '');\nif (!pdf.startsWith('JVBER')) return fail('pdf_base64 no es un PDF válido');\nif (pdf.length > MAX_BASE64_LENGTH) return fail('El PDF supera el tamaño máximo permitido');\n\nconst docNo = String(body.doc_no || '').trim();\nconst ref = docNo ? ` ${docNo}` : '';\nconst safeName = String(body.file_name || '').replace(/[^\\w.\\- ]+/g, '').trim();\nconst fileName = (safeName || `${label.subject}${ref}`.replace(/\\s+/g, '-')).replace(/\\.pdf$/i, '') + '.pdf';\n\nreturn [{\n  json: {\n    valid: true,\n    emails,\n    pdf_base64: pdf,\n    file_name: fileName,\n    subject: `${label.subject}${ref}`,\n    content: `<p>Adjuntamos ${label.article}${ref} en formato PDF.</p><p>Ante cualquier consulta, responda a este correo o comuníquese con la clínica.</p>`,\n  },\n}];\n"
      },
