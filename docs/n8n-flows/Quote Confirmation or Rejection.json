    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO order_items (\n    order_id, \n    quote_item_id, \n    status, \n    tooth_number, \n    completed_date, \n    scheduled_date,\n    gross_total,\n    discount_mode,\n    discount_value,\n    discount_amount\n)\nSELECT \n    $1, \n    qi.id, \n    CASE \n        WHEN q.is_sales IS FALSE THEN 'Completed' \n        ELSE 'Pending' \n    END, \n    qi.tooth_number,\n    CASE \n        WHEN q.is_sales IS FALSE THEN CURRENT_TIMESTAMP \n        ELSE NULL \n    END,\n    CASE \n        WHEN q.is_sales IS FALSE THEN CURRENT_TIMESTAMP \n        ELSE NULL \n    END,\n    qi.gross_total,\n    qi.discount_mode,\n    qi.discount_value,\n    qi.discount_amount\nFROM quote_items qi\nJOIN quotes q ON qi.quote_id = q.id\nWHERE qi.quote_id = $2;",
        "options": {
          "queryReplacement": "={{ [$('Crear Orden').first().json.id, $('Get Quote').first().json.id] }}"
        }
      },
