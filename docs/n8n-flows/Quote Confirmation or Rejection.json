        "query": "SELECT \n    q.*,\n    (\n        SELECT jsonb_agg(to_jsonb(sub))\n        FROM (\n            SELECT qi.*, sc.name as service_name\n            FROM public.quote_items qi\n            LEFT JOIN public.service_catalog sc ON sc.id = qi.service_id\n            WHERE qi.quote_id = q.id\n        ) sub\n    ) AS items\nFROM \n    public.quotes q\nWHERE \n    q.id = $1;",
