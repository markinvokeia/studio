    {
      "parameters": {
        "jsCode": "const queryInput = $json.query;\nlet query = {};\ntry {\n  query = JSON.parse(queryInput);\n} catch (error) {  \n  query = {};\n}\n\n// Validar datos de entrada desde el trigger\nconst quote_number = $json.quote_number || query.quote_number;\nconst confirm_reject = $json.confirm_reject || query.action;\n\n// Validaciones básicas\nif (!quote_number || quote_number.trim() === '') {\n  return [{ json: { error: true, message: 'Numero de presupuesto es requerido' } }];\n}\n\nif (!confirm_reject || confirm_reject.trim() === '' || !['confirm', 'reject'].includes(confirm_reject)) {\n  return [{ json: { error: true, message: 'Debe especificar si desea confirmar o rechazar el presupuesto' } }];\n}\n\n\nreturn [{\n  json: {\n    quote_number,\n    confirm_reject\n  }\n}];"
      },
