    {
      "parameters": {
        "jsCode": "const payment = $('Get payment').first().json;\nconst activeSessionId = $json.data ? $json.data.id : null;\nconst hasOwnSession = payment.cash_session_id !== null && payment.cash_session_id !== undefined;\n// Un pago que nunca tuvo sesión de caja (histórico) no tiene nada que proteger;\n// uno que sí tuvo, solo se puede editar si esa sesión sigue siendo la activa.\nconst sessionOk = !hasOwnSession || (activeSessionId !== null && Number(activeSessionId) === Number(payment.cash_session_id));\n\nreturn [{ json: { session_ok: sessionOk, active_session_id: activeSessionId } }];"
