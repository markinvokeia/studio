    {
      "parameters": {
        "jsCode": "const paymentId = Number($('Get payment').first().json.id);\nconst newAmount = Math.abs(Number($('Detectar cambios').first().json.new_amount));\n\nconst rows = $('Get Payment Allocations (Pago)').all().map((i) => i.json);\nconst pool = [...rows].sort((a, b) => {\n  const ta = new Date(a.created_at).getTime();\n  const tb = new Date(b.created_at).getTime();\n  if (ta !== tb) return ta - tb;\n  return Number(a.id) - Number(b.id);\n});\n\nconst poolTotal = pool.reduce((sum, row) => sum + Number(row.amount), 0);\n\nlet remaining = newAmount;\nconst toReinsert = [];\n\nfor (const row of pool) {\n  if (remaining <= 0.0001) break;\n  const rowAmount = Number(row.amount);\n  const take = Math.min(rowAmount, remaining);\n  if (take <= 0.0001) continue;\n\n  // Misma lógica que el Flujo A: se preserva la proporción del tipo de\n  // cambio / target_amount original, no se recalcula de nuevo.\n  const ratio = take / rowAmount;\n\n  toReinsert.push({\n    payment_id: paymentId,\n    invoice_id: row.invoice_id,\n    amount: Math.round(take * 100) / 100,\n    allocated_currency: row.allocated_currency,\n    target_amount: Math.round(Number(row.target_amount) * ratio * 100) / 100,\n    exchange_rate: row.exchange_rate,\n  });\n\n  remaining = Math.round((remaining - take) * 100) / 100;\n}\n\nconst reinsertedTotal = toReinsert.reduce((s, r) => s + r.amount, 0);\nconst releasedAmount = Math.round((poolTotal - reinsertedTotal) * 100) / 100;\n\nif (toReinsert.length === 0) {\n  return [{\n    json: {\n      payment_id: paymentId,\n      new_amount: newAmount,\n      pool_total: Math.round(poolTotal * 100) / 100,\n      released_amount: releasedAmount,\n      _empty: true,\n    },\n  }];\n}\n\nreturn toReinsert.map((item) => ({\n  json: { ...item, new_amount: newAmount, released_amount: releasedAmount },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3280,
        4700
      ],
