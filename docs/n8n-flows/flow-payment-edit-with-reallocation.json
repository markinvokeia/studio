    {
      "parameters": {
        "jsCode": "const body = $('payment/edit-with-reallocation').first().json.body;\nconst current = $('Get payment').first().json;\n\nconst currentAmount = Math.abs(Number(current.amount));\nconst newAmount = Math.abs(Number(body.amount));\nconst methodChanged = String(body.payment_method_id) !== String(current.payment_method_id);\nconst amountChanged = Math.abs(newAmount - currentAmount) > 0.0001;\n\nreturn [{\n  json: {\n    payment_id: current.id,\n    needs_cash_check: methodChanged || amountChanged,\n    method_changed: methodChanged,\n    amount_changed: amountChanged,\n    new_payment_method_id: body.payment_method_id,\n    new_amount: newAmount,\n    new_payment_date: body.payment_date,\n    new_notes: body.notes || '',\n    new_is_historical: !!body.is_historical,\n  },\n}];"
      },
