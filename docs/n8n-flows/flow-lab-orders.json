    {
      "parameters": {
        "jsCode": "// Variables de la plantilla WHATSAPP (variables_schema: { variable_meta: clave })\n// con las claves de \"Explode recipients\". Respeta el modo prueba de WhatsApp\n// (whatsapp_test_mode_enabled / whatsapp_test_phone_whitelist).\nconst j = $json;\nconst fail = (reason) => [{ json: { ...j, ok: false, reason } }];\nconst tpl = j.template;\nif (!tpl || !tpl.code) return fail('Plantilla de WhatsApp inactiva o inexistente');\nconst digits = String(j.recipient?.phone || '').replace(/\\D/g, '');\nif (!digits) return fail(`${j.recipient?.name || j.recipient?.user_id}: sin teléfono`);\nconst phone = '+' + digits;\nif (j.test_mode) {\n  const whitelist = String(j.whitelist).split(',').map((p) => '+' + String(p).trim().replace(/\\D/g, '')).filter((p) => p !== '+');\n  if (!whitelist.includes(phone)) return fail(`Modo prueba de WhatsApp: ${phone} no está en la lista permitida`);\n}\nconst schema = tpl.variables_schema || {};\nconst parameters = [];\nfor (const [name, key] of Object.entries(schema)) {\n  if (!(key in j.fields)) return fail(`La plantilla ${tpl.code} usa la clave desconocida \"${key}\"`);\n  parameters.push({ type: 'text', parameter_name: name, text: String(j.fields[key] || '-') });\n}\nreturn [{ json: {\n  ...j, ok: true, phone,\n  body: {\n    from: $env.YCLOUD_WHATSAPP_FROM || '+59894024661',\n    to: phone,\n    type: 'template',\n    template: { name: tpl.code, language: { code: tpl.language || 'es' }, components: parameters.length ? [{ type: 'body', parameters }] : [] },\n  },\n} }];"
      },
