      "parameters": {
        "operation": "executeQuery",
        "query": "-- Siempre una fila (deleted = false si no existía o ya estaba borrada): así el\n-- nodo no necesita alwaysOutputData y un error solo sale por la salida de error.\nWITH d AS (\n    UPDATE public.lab_orders\n    SET is_deleted = true, updated_at = now(), updated_by = NULLIF($2, '')::uuid\n    WHERE id = $1::integer AND NOT is_deleted\n    RETURNING id\n)\nSELECT $1::integer AS id, EXISTS (SELECT 1 FROM d) AS deleted;",
        "options": {
          "queryReplacement": "={{ [$json.body.id, $json.jwtPayload?.userId ?? ''] }}"
