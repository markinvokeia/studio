        "jsCode": "// Un item por destinatario y canal. Cada entrada es un aviso NUEVO devuelto por\n// lab_stage_alert_on_enter / lab_stage_alerts_due (columna `payload`).\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json.payload;\n  if (!p || !p.alert_instance_id) continue;\n  const o = p.order || {};\n  const fmtDate = (d) => (d ? String(d).slice(0, 10).split('-').reverse().join('/') : '');\n  for (const r of p.recipients || []) {\n    const fields = {\n      'recipient.name': r.name || '',\n      'patient.name': o.patient_name || '',\n      'clinic.name': p.clinic_name || '',\n      'lab_order.number': String(o.id ?? ''),\n      'lab_order.work': o.work_description || '',\n      'lab_order.laboratory': o.laboratory_name || '',\n      'lab_order.stage': o.stage_name || '',\n      'lab_order.days_in_stage': String(o.days_in_stage ?? ''),\n      'lab_order.doctor': o.doctor_name || '',\n      'lab_order.teeth': (o.teeth || []).join(', '),\n      'lab_order.due_date': fmtDate(o.due_date),\n    };\n    const base = { alert_instance_id: p.alert_instance_id, trigger: p.trigger, title: p.title, summary: p.summary, recipient: r, fields };\n    if (p.channels?.in_app && r.notification) out.push({ json: { ...base, kind: 'in_app' } });\n    if (p.channels?.email) out.push({ json: { ...base, kind: 'email', template: p.email_template } });\n    if (p.channels?.whatsapp) out.push({ json: {\n      ...base, kind: 'whatsapp', template: p.whatsapp_template,\n      test_mode: !!p.whatsapp_test_mode, whitelist: p.whatsapp_test_whitelist || '',\n    } });\n  }\n}\nreturn out;"
      },
