    {
      "parameters": {
        "jsCode": "// Arma el email: con plantilla EMAIL reemplaza {{clave}} (ver claves en\n// \"Explode recipients\"); sin plantilla usa un texto por defecto. Nunca lanza:\n// devuelve ok:false con el motivo para dejarlo en alert_actions.\nconst j = $json;\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst to = j.recipient?.email;\nif (!to || !EMAIL_RE.test(to)) {\n  return [{ json: { ...j, ok: false, reason: `${j.recipient?.name || j.recipient?.user_id}: sin email válido` } }];\n}\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst fill = (text, html) => String(text || '').replace(/\\{\\{\\s*([\\w.]+)\\s*\\}\\}/g, (_, k) => (k in j.fields ? (html ? esc(j.fields[k]) : j.fields[k]) : ''));\nlet subject;\nlet html;\nif (j.template && (j.template.body_html || j.template.body_text)) {\n  subject = fill(j.template.subject || j.title, false);\n  html = j.template.body_html ? fill(j.template.body_html, true) : `<p>${esc(fill(j.template.body_text, false))}</p>`;\n} else {\n  const f = j.fields;\n  subject = j.title;\n  html = [\n    `<p>Hola ${esc(f['recipient.name'])},</p>`,\n    `<p><strong>${esc(j.title)}</strong></p>`,\n    `<p>Paciente: ${esc(f['patient.name'])}<br>Trabajo: ${esc(f['lab_order.work'])}`\n      + (f['lab_order.laboratory'] ? `<br>Laboratorio: ${esc(f['lab_order.laboratory'])}` : '')\n      + `<br>Etapa: ${esc(f['lab_order.stage'])} (${esc(f['lab_order.days_in_stage'])} días)</p>`,\n    `<p>${esc(f['clinic.name'])}</p>`,\n  ].join('');\n}\nreturn [{ json: { ...j, ok: true, to, subject, html } }];"
      },
