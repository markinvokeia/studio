        "jsCode": "const sent = $input.first().json;\nconst req = $('Build lab email').item.json;\nconst ok = !!(sent && (sent.id || sent.threadId)) && !sent.error;\nreturn [{ json: {\n  alert_instance_id: req.alert_instance_id,\n  action_type: 'SEND_EMAIL',\n  result_status: ok ? 'SUCCESS' : 'FAILED',\n  result_message: ok ? `Email a ${req.to}` : `Email a ${req.to} falló: ${sent?.error?.message || sent?.error || 'sin respuesta de Gmail'}`,\n  action_data: { to: req.to, user_id: req.recipient?.user_id, message_id: sent?.id || null },\n} }];"
