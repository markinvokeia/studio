    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.alert_rules\nSET \n    next_execution_at = CASE \n        WHEN recurrence_type = 'DAILY'   THEN (CAST($1 AS TIMESTAMP) + INTERVAL '1 day')\n        WHEN recurrence_type = 'WEEKLY'  THEN (CAST($1 AS TIMESTAMP) + INTERVAL '1 week')\n        WHEN recurrence_type = 'MONTHLY' THEN (CAST($1 AS TIMESTAMP) + INTERVAL '1 month')\n        WHEN recurrence_type = 'ONCE'    THEN NULL\n        ELSE next_execution_at \n    END,\n    is_active = CASE \n        WHEN recurrence_type = 'ONCE' THEN false\n        ELSE is_active \n    END,\n    updated_at = CURRENT_TIMESTAMP\nWHERE id = $2;",
        "options": {
