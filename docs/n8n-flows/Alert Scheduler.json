      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ar.*\nFROM public.alert_rules ar\nWHERE ar.is_active = true\n  AND (\n    (\n      ar.next_execution_at IS NULL\n      OR CAST(ar.next_execution_at AS DATE) <= CAST($1 AS DATE)\n    )\n    OR (\n      $2 ILIKE 'MANUAL'\n    )\n  );",
        "options": {
          "queryReplacement": "={{ [$('When Executed by Another Workflow').item.json.target_date, $('When Executed by Another Workflow').item.json.triggered_by] }}"
        }
