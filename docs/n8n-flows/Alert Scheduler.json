    {
      "parameters": {
        "jsCode": "let metrics = {\n    rules_processed: 0,\n    alerts_created: 0,\n    alerts_skipped: 0,\n    emails_queued: 0,\n    emails_sent: 0,\n    sms_sent: 0,\n    errors_count: 0,\n    error_details: [],\n    execution_log_summary: []\n};\n\nconst items = Array.isArray($input.all()) ? $input.all() : [$input.all()];\nmetrics.rules_processed = items.length;\n\nfor (const item of items) {\n    const data = item.json;\n\n    if (data.success === false) {\n        metrics.errors_count++;\n        const detail = data.error || (data.error_details ? JSON.stringify(data.error_details) : 'Sin detalle');\n        metrics.error_details.push(`Error en ejecución: ${detail}`);\n        continue;\n    }\n\n    metrics.emails_sent += Number(data.emails_sent) || 0;\n\n    if (data.execution_log && Array.isArray(data.execution_log)) {\n        for (const log of data.execution_log) {\n            if (Object.keys(log).length === 0) {\n                metrics.alerts_skipped++;\n                continue;\n            }\n\n            if (log.id) {\n                metrics.alerts_created++;\n\n                if (log.status === \"PENDING\") {\n                    if (log.details_json?.patient?.email && log.details_json.patient.email !== \"null\") {\n                        metrics.emails_queued++;\n                    }\n                }\n\n                // Estimate only (mirrors emails_queued): counts alerts whose patient has a phone,\n                // not confirmed WhatsApp deliveries. The authoritative record of what was actually\n                // sent/failed lives in alert_actions (SEND_WHATSAPP rows written by the\n                // \"Alert WhatsApp Auto-Send\" sub-workflow), surfaced in alerts/page.tsx.\n                if (log.details_json?.patient?.phone) metrics.sms_sent++;\n\n                metrics.execution_log_summary.push({\n                    id: log.id,\n                    rule_id: log.rule_id,\n                    title: log.title,\n                    status: log.status,\n                    patient: log.details_json?.patient?.full_name || \"N/A\"\n                });\n            } else {\n                metrics.alerts_skipped++;\n            }\n        }\n    }\n}\n\nreturn [{\n    json: metrics\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2688,
        144
      ],
      "id": "42075017-b988-42e9-8fae-51d0d5bc4e44",
      "name": "Calculate metrics"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst target_date = $(\"When Executed by Another Workflow\").first().json\n  .target_date;\n\n// El origen de una regla puede ser una tabla o una vista \"v_alert_*\". Todo lo\n// que se interpola como identificador se valida para no inyectar SQL.\nconst IDENT = /^[a-z_][a-z0-9_]*$/;\nconst ident = (name, what) => {\n  if (typeof name !== \"string\" || !IDENT.test(name)) {\n    throw new Error(`Alert rule: invalid ${what} \"${name}\"`);\n  }\n  return name;\n};\nconst lit = (v) => `'${String(v ?? \"\").replace(/'/g, \"''\")}'`;\n\nfor (const item of items) {\n  const rule = item.json;\n\n  const conditionConfig = rule.condition_config || {};\n  const conditions = conditionConfig.conditions || [];\n  const userIdField =\n    conditionConfig.user_id_field !== undefined &&\n    conditionConfig.user_id_field !== null &&\n    conditionConfig.user_id_field !== \"\"\n      ? ident(conditionConfig.user_id_field, \"user_id_field\")\n      : null;\n\n  const sourceTable = ident(rule.source_table, \"source_table\");\n  // Con una vista, las alert_instances siguen apuntando a la tabla real\n  // (reference_table/reference_id): el envio de WhatsApp resuelve la entidad\n  // por reference_table y el anti-duplicado tambien la usa. El frontend guarda\n  // condition_config.reference_table al elegir la vista (sale del COMMENT de\n  // la vista via GET /system/tables). Sin ese dato se usa el propio origen.\n  const referenceTable = ident(\n    conditionConfig.reference_table || sourceTable,\n    \"reference_table\",\n  );\n\n  const daysBefore = Math.max(0, Number(rule.days_before) || 0);\n  const daysAfter = Math.max(0, Number(rule.days_after) || 0);\n\n  const dateOffsetSql = ` + INTERVAL '${daysBefore} days' - INTERVAL '${daysAfter} days'`;\n\n  let isYearlyRecurring = false;\n\n  const whereClauses = conditions.map((c, index) => {\n    const column = ident(c.column, \"condition column\");\n    let val = c.value;\n\n    if (typeof val === \"string\" && val.includes(\"{{\") && val.includes(\"}}\")) {\n      const cleanVar = val.replace(/[{}\\s]/g, \"\").toUpperCase();\n\n      const dateMappings = {\n        TODAY_NO_YEAR: `TO_CHAR('${target_date}'::date${dateOffsetSql}, 'MM-DD')`,\n        TODAY: `('${target_date}'::date${dateOffsetSql})::date`,\n        TOMORROW: `('${target_date}'::date + INTERVAL '1 day'${dateOffsetSql})::date`,\n        YESTERDAY: `('${target_date}'::date - INTERVAL '1 day'${dateOffsetSql})::date`,\n        WEEK_START: `(DATE_TRUNC('week', '${target_date}'::date)${dateOffsetSql})::date`,\n        WEEK_END: `(DATE_TRUNC('week', '${target_date}'::date) + INTERVAL '6 days'${dateOffsetSql})::date`,\n        DOW: `EXTRACT(DOW FROM '${target_date}'::date${dateOffsetSql})`,\n        MONTH_START: `(DATE_TRUNC('month', '${target_date}'::date)${dateOffsetSql})::date`,\n        MONTH_END: `(DATE_TRUNC('month', '${target_date}'::date) + INTERVAL '1 month - 1 day'${dateOffsetSql})::date`,\n        YEAR_START: `(DATE_TRUNC('year', '${target_date}'::date)${dateOffsetSql})::date`,\n        YEAR_END: `(DATE_TRUNC('year', '${target_date}'::date) + INTERVAL '1 year - 1 day'${dateOffsetSql})::date`,\n      };\n\n      const baseKey = Object.keys(dateMappings).find((key) =>\n        cleanVar.startsWith(key),\n      );\n\n      if (baseKey) {\n        let baseSql = dateMappings[baseKey];\n        const arithmetic = cleanVar.replace(baseKey, \"\");\n\n        if (arithmetic) {\n          val = `(${baseSql} ${arithmetic})`;\n        } else {\n          val = baseSql;\n        }\n      }\n    } else if (typeof val === \"string\") {\n      val = lit(val);\n    }\n\n    const columnSql = String(val).includes(\"MM-DD\")\n      ? `TO_CHAR(t.${column}, 'MM-DD')`\n      : `t.${column}`;\n\n    if (columnSql.includes(\"MM-DD\")) {\n      isYearlyRecurring = true;\n    }\n\n    let clause = \"\";\n    const operator = String(c.operator || \"\").toUpperCase();\n    if (operator === \"BETWEEN\") {\n      // days_before / days_after son offsets respecto al EVENTO, no una ventana\n      // que siempre incluye el dia de hoy:\n      //   days_before = N -> el evento ocurre N dias despues del target\n      //   days_after  = N -> el evento ocurrio N dias antes del target\n      // Si ambos son > 0 el rango cubre la ventana completa entre ambos extremos\n      // (ej. facturas a vencer dentro de +/- 5 dias). Si solo uno esta seteado,\n      // apunta a ese dia exacto (ej. recordatorio 24h: 1 y 0 -> solo manana).\n      let startOffset;\n      let endOffset;\n      if (daysBefore > 0 && daysAfter > 0) {\n        startOffset = -daysAfter;\n        endOffset = daysBefore + 1;\n      } else if (daysBefore > 0) {\n        startOffset = daysBefore;\n        endOffset = daysBefore + 1;\n      } else if (daysAfter > 0) {\n        startOffset = -daysAfter;\n        endOffset = -daysAfter + 1;\n      } else {\n        startOffset = 0;\n        endOffset = 1;\n      }\n      const startRange = `('${target_date}'::date + INTERVAL '${startOffset} days')`;\n      const endRange = `('${target_date}'::date + INTERVAL '${endOffset} days')`;\n      clause = `${columnSql} >= ${startRange} AND ${columnSql} < ${endRange}`;\n    } else if (operator === \"IS NULL\" || operator === \"IS NOT NULL\") {\n      clause = `${columnSql} ${operator}`;\n    } else {\n      clause = `${columnSql} ${c.operator} ${val}`;\n    }\n\n    const logic = index === 0 ? \"\" : c.logic || \"\";\n    return `${logic} ${clause}`.trim();\n  });\n\n  const shouldJoinUser = userIdField !== null;\n  const u = shouldJoinUser ? \"u\" : \"t\";\n\n  const userJoinClause = shouldJoinUser\n    ? `LEFT JOIN public.users u ON t.${userIdField} = u.id`\n    : \"\";\n\n  const finalUserId = shouldJoinUser ? `t.${userIdField}` : \"t.id\";\n\n  // Telefono de contacto: el del paciente o, si es dependiente sin telefono\n  // propio, el de su responsable. Snapshot sin normalizar: el envio de\n  // WhatsApp normaliza (Uruguay) y valida el numero por su cuenta.\n  // Solo cuando \"u\" es la tabla users (join por user_id_field u origen users).\n  const canResolveResponsible = shouldJoinUser || sourceTable === \"users\";\n  const responsibleJoinClause = canResolveResponsible\n    ? `LEFT JOIN public.users r ON r.id = ${u}.responsible_contact_id`\n    : \"\";\n  const phoneSql = canResolveResponsible\n    ? `COALESCE(NULLIF(${u}.phone_number, ''), CASE WHEN ${u}.is_dependant THEN NULLIF(r.phone_number, '') END)`\n    : `${u}.phone_number`;\n  const phoneFromResponsibleSql = canResolveResponsible\n    ? `(NULLIF(${u}.phone_number, '') IS NULL AND ${u}.is_dependant AND NULLIF(r.phone_number, '') IS NOT NULL)`\n    : \"false\";\n  const responsibleNameSql = canResolveResponsible ? \"r.name\" : \"NULL\";\n\n  // Anti-duplicado:\n  //  - Reglas anuales (cumpleaños, aniversarios): una alerta por año.\n  //  - Resto de reglas: no re-crear mientras exista una alerta ABIERTA para\n  //    este item, y nunca dos para el mismo alert_date (el scheduler puede\n  //    dispararse mas de una vez por dia). Si la alerta anterior ya fue\n  //    resuelta y la condicion sigue vigente, se genera una nueva.\n  const dedupExtraClause = isYearlyRecurring\n    ? `AND EXTRACT(YEAR FROM ai.alert_date) = EXTRACT(YEAR FROM CAST('${target_date}' AS DATE))`\n    : `AND (ai.alert_date = CAST('${target_date}' AS DATE) OR ai.status NOT IN ('COMPLETED', 'ACTION_TAKEN', 'IGNORED', 'SUPPRESSED', 'SNOOZED'))`;\n\n  const duplicatePrevention = `NOT EXISTS (\n    SELECT 1 FROM public.alert_instances ai\n    WHERE ai.rule_id::text = ${lit(rule.id)}::text\n      AND ai.reference_table = '${referenceTable}'\n      AND ai.reference_id::text = t.id::text\n      ${dedupExtraClause}\n  )`;\n\n  const whereSql =\n    whereClauses.length > 0\n      ? `WHERE (${whereClauses.join(\" \")}) AND ${duplicatePrevention}`\n      : `WHERE ${duplicatePrevention}`;\n\n  const dynamicQuery = `\n    SELECT\n      ${lit(rule.id)} as rule_id,\n      '${referenceTable}' as reference_table,\n      t.id as reference_id,\n      ${finalUserId} as user_id,\n      CAST('${target_date}' AS DATE) as alert_date,\n      ${lit(rule.name)} as title,\n      ${lit(rule.priority)} as priority,\n      ${lit(rule.description)} as description,\n      jsonb_build_object(\n        'data', to_jsonb(t.*),\n        'patient', jsonb_build_object(\n          'full_name', ${u}.name,\n          'email', ${u}.email,\n          'phone', ${phoneSql},\n          'phone_from_responsible', ${phoneFromResponsibleSql},\n          'responsible_name', ${responsibleNameSql},\n          'document_id', ${u}.identity_document\n        ),\n        'clinic', jsonb_build_object(\n          'name', c.name,\n          'address', c.address,\n          'phone', c.phone,\n          'email', c.email\n        )\n      ) as details_json\n    FROM public.${sourceTable} t\n    ${userJoinClause}\n    ${responsibleJoinClause}\n    CROSS JOIN (SELECT * FROM public.clinic LIMIT 1) c\n    ${whereSql}\n  `;\n\n  results.push({\n    json: { ...rule, dynamicQuery },\n  });\n}\n\nreturn results;\n"
      },
