      "parameters": {
        "jsCode": "// Las alertas creadas se leen de \"Create alert instance\" (ultima corrida = esta\n// iteracion del loop), no de $input: aqui llegan filas de \"Update rule next\n// execution\" o la respuesta del sub-workflow de WhatsApp, que no son alertas.\n// Se filtra por rule_id para no contar las de una iteracion anterior cuando\n// esta regla no genero resultados.\nconst ruleId = String($('Loop Over Results').first().json.id);\nlet created = [];\ntry {\n  created = $('Create alert instance').all()\n    .map((item) => item.json)\n    .filter((a) => a && a.id != null && String(a.rule_id) === ruleId);\n} catch (e) {\n  created = [];\n}\n\n// Emails enviados en esta iteracion: resultados de \"Send Alert Email\" que\n// corresponden a alertas de esta regla (el nodo conserva datos de iteraciones\n// anteriores si esta vez no se ejecuto).\nconst createdIds = new Set(created.map((a) => String(a.id)));\nlet emailsSent = 0;\ntry {\n  emailsSent = $('Send Alert Email').all()\n    .filter((item) => item.json?.success === true && createdIds.has(String(item.json.alert_instance_id)))\n    .length;\n} catch (e) {\n  emailsSent = 0;\n}\n\nreturn {\n  success: true,\n  execution_log: created.length ? created : [{}],\n  emails_sent: emailsSent\n};"
