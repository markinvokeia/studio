    {
      "parameters": {
        "jsCode": "let metrics = {\n    rules_processed: 0,\n    alerts_created: 0,\n    alerts_skipped: 0,\n    emails_queued: 0,\n    emails_sent: 0,\n    sms_sent: 0,\n    errors_count: 0,\n    error_details: [],\n    execution_log_summary: []\n};\n\nconst items = Array.isArray($input.all()) ? $input.all() : [$input.all()];\nmetrics.rules_processed = items.length;\n\nfor (const item of items) {\n    const data = item.json;\n\n    if (data.success === false) {\n        metrics.errors_count++;\n        metrics.error_details.push(`Error en ejecución: ${data.error || 'Sin detalle'}`);\n        continue;\n    }\n\n    if (data.execution_log && Array.isArray(data.execution_log)) {\n        for (const log of data.execution_log) {\n            if (Object.keys(log).length === 0) {\n                metrics.alerts_skipped++;\n                continue;\n            }\n\n            if (log.id) {\n                metrics.alerts_created++;\n\n                if (log.status === \"PENDING\") {\n                    if (log.details_json?.patient?.email && log.details_json.patient.email !== \"null\") {\n                        metrics.emails_queued++;\n                    }\n                }\n\n                // if (log.details_json?.patient?.phone) metrics.sms_sent++;\n\n                metrics.execution_log_summary.push({\n                    id: log.id,\n                    rule_id: log.rule_id,\n                    title: log.title,\n                    status: log.status,\n                    patient: log.details_json?.patient?.full_name || \"N/A\"\n                });\n            } else {\n                metrics.alerts_skipped++;\n            }\n        }\n    }\n}\n\nreturn [{\n    json: metrics\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        -128
      ],
      "id": "03d65dcb-274a-42d6-8f5a-367ed825ea49",
      "name": "Calculate metrics"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst target_date = $('When Executed by Another Workflow').first().json.target_date;\n\nfor (const item of items) {\n  const rule = item.json;\n\n  const conditionConfig = rule.condition_config || {};\n  const conditions = conditionConfig.conditions || [];\n  const userIdField = conditionConfig.user_id_field !== undefined ? conditionConfig.user_id_field : null;\n  \n  const daysBefore = rule.days_before || 0;\n  const daysAfter = rule.days_after || 0;\n\n  const dateOffsetSql = ` + INTERVAL '${daysBefore} days' - INTERVAL '${daysAfter} days'`;\n\n  let isYearlyRecurring = false;\n\n  const whereClauses = conditions.map((c, index) => {\n    let val = c.value;\n\n    if (typeof val === 'string' && val.includes('{{') && val.includes('}}')) {\n      const cleanVar = val.replace(/[{{\\\\s}}]/g, '').toUpperCase();\n      \n      const dateMappings = {\n        'TODAY_NO_YEAR':  `TO_CHAR('${target_date}'::date${dateOffsetSql}, 'MM-DD')`,\n        'TODAY':          `('${target_date}'::date${dateOffsetSql})::date`,\n        'TOMORROW':       `('${target_date}'::date + INTERVAL '1 day'${dateOffsetSql})::date`,\n        'YESTERDAY':      `('${target_date}'::date - INTERVAL '1 day'${dateOffsetSql})::date`,\n        'WEEK_START':     `(DATE_TRUNC('week', '${target_date}'::date)${dateOffsetSql})::date`,\n        'WEEK_END':       `(DATE_TRUNC('week', '${target_date}'::date) + INTERVAL '6 days'${dateOffsetSql})::date`,\n        'DOW':            `EXTRACT(DOW FROM '${target_date}'::date${dateOffsetSql})`,\n        'MONTH_START':    `(DATE_TRUNC('month', '${target_date}'::date)${dateOffsetSql})::date`,\n        'MONTH_END':      `(DATE_TRUNC('month', '${target_date}'::date) + INTERVAL '1 month - 1 day'${dateOffsetSql})::date`,\n        'YEAR_START':     `(DATE_TRUNC('year', '${target_date}'::date)${dateOffsetSql})::date`,\n        'YEAR_END':       `(DATE_TRUNC('year', '${target_date}'::date) + INTERVAL '1 year - 1 day'${dateOffsetSql})::date`\n      };\n\n      const baseKey = Object.keys(dateMappings).find(key => cleanVar.startsWith(key));\n\n      if (baseKey) {\n        let baseSql = dateMappings[baseKey];\n        const arithmetic = cleanVar.replace(baseKey, '');\n        \n        if (arithmetic) {\n          val = `(${baseSql} ${arithmetic})`;\n        } else {\n          val = baseSql;\n        }\n      }\n    } else if (typeof val === 'string') {\n      val = `'${val}'`;\n    }\n\n    const columnSql = val.includes('MM-DD') ? `TO_CHAR(t.${c.column}, 'MM-DD')` : `t.${c.column}`;\n\n    if (columnSql.includes('MM-DD')) {\n      isYearlyRecurring = true;\n    }\n\n    let clause = \"\";\n    if (c.operator.toUpperCase() === 'BETWEEN') {\n      const startRange = `'${target_date}'::date`;\n      const endRange = val;\n      clause = `${columnSql} BETWEEN ${startRange} AND ${endRange}`;\n    } else {\n      clause = `${columnSql} ${c.operator} ${val}`;\n    }\n\n    return `${c.logic === undefined ? '' : c.logic} ${clause}`;\n\n    const logic = index === 0 ? '' : (c.logic || '');\n    return `${logic} ${clause}`.trim();\n  });\n\n  const shouldJoinUser = userIdField !== null;\n  const u = shouldJoinUser ? 'u' : 't';\n  \n  const userJoinClause = shouldJoinUser \n    ? `LEFT JOIN public.users u ON t.${userIdField} = u.id` \n    : '';\n\n  const finalUserId = shouldJoinUser ? `t.${userIdField}` : 't.id';\n\n  const yearlyDedupClause = isYearlyRecurring \n    ? `AND EXTRACT(YEAR FROM ai.alert_date) = EXTRACT(YEAR FROM CAST('${target_date}' AS DATE))` \n    : '';\n\n  const duplicatePrevention = `NOT EXISTS (\n    SELECT 1 FROM public.alert_instances ai \n    WHERE ai.rule_id::text = '${rule.id}'::text \n      AND ai.reference_table = '${rule.source_table}' \n      AND ai.reference_id::text = t.id::text\n      ${yearlyDedupClause}\n  )`;\n\n  const whereSql = whereClauses.length > 0 \n    ? `WHERE (${whereClauses.join(' ')}) AND ${duplicatePrevention}` \n    : `WHERE ${duplicatePrevention}`;\n\n  const dynamicQuery = `\n    SELECT \n      '${rule.id}' as rule_id,\n      '${rule.source_table}' as reference_table,\n      t.id as reference_id,\n      ${finalUserId} as user_id,\n      CAST('${target_date}' AS DATE) as alert_date,\n      '${rule.name}' as title,\n      '${rule.priority}' as priority,\n      '${rule.description}' as description,\n      jsonb_build_object(\n        'data', to_jsonb(t.*),\n        'patient', jsonb_build_object(\n          'full_name', ${u}.name,\n          'email', ${u}.email,\n          'phone', ${u}.phone_number,\n          'document_id', ${u}.identity_document\n        ),\n        'clinic', jsonb_build_object(\n          'name', c.name,\n          'address', c.address,\n          'phone', c.phone,\n          'email', c.email\n        )\n      ) as details_json\n    FROM ${rule.source_table} t\n    ${userJoinClause}\n    CROSS JOIN (SELECT * FROM public.clinic LIMIT 1) c\n    ${whereSql}\n  `;\n\n  results.push({\n    json: { ...rule, dynamicQuery }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "59a6bdb1-1ef3-41a5-901b-812df0930373",
      "name": "Build dynamic query"
