        "query": "SELECT EXISTS (\n    SELECT 1\n    FROM public.user_roles ur\n    INNER JOIN public.role_permissions rp ON rp.role_id = ur.role_id\n    INNER JOIN public.permissions p ON p.id = rp.permission_id\n    WHERE ur.user_id = $1\n      AND p.code = 'USERS_SET_INITIAL_PASSWORD'\n) AS has_permission",
