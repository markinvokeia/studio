{
  "name": "study_order_extraction",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "is_study_order",
      "document_quality",
      "doctor",
      "patient",
      "order_date",
      "items",
      "modifiers",
      "regions",
      "texts",
      "delivery_methods",
      "unmatched_text_lines",
