    "properties": {
      "is_study_order": {
        "type": "boolean",
        "description": "false si la imagen no es una orden de estudios (receta, factura, foto cualquiera...)."
      },
      "document_quality": {
        "type": "string",
        "enum": [
          "good",
          "poor",
          "unreadable"
        ]
      },
      "doctor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "license",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "description": "Entre 0 y 1: qué tan seguro estás de haber leído bien este dato."
          }
        }
      },
      "patient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "document",
          "document_type",
          "birth_date",
          "phone",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cédula o pasaporte tal como está escrito."
          },
          "document_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "cedula",
              "passport",
              "other",
              null
            ]
          },
          "birth_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "description": "Entre 0 y 1: qué tan seguro estás de haber leído bien este dato."
          }
        }
      },
      "order_date": {
        "type": [
