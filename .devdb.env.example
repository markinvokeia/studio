# Plantilla de conexión a la base de datos de DEV vía psql (sin MCP).
# Copiar a .devdb.env (ignorado por git) y completar los datos:
#   cp .devdb.env.example .devdb.env && chmod 600 .devdb.env
#
# Uso:  set -a; source .devdb.env; set +a; psql -c "SELECT 1"
# Son las variables estándar de libpq, así que psql/pg_dump las toman solas.
# Si la contraseña tiene caracteres especiales ($, #, !, espacios), ponerla entre comillas simples.

PGHOST=<host>
PGPORT=5432
PGDATABASE=<database>
PGUSER=<user>
PGPASSWORD=<password>
# "require" si el servidor exige SSL
PGSSLMODE=disable

# Guardarraíl: toda sesión abre en modo solo lectura y corta consultas de más de 30 s.
# Cualquier INSERT/UPDATE/DDL falla salvo que se desactive explícitamente.
PGOPTIONS="-c default_transaction_read_only=on -c statement_timeout=30000"
