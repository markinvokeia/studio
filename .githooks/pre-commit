#!/bin/sh
# Mantiene el mapa del producto (base de conocimiento del asistente) al día con
# el código en cada commit. Ver docs/onboarding-asistente.md.
#
#   - Regenera src/generated/help-catalog.json (y .en.json) y los suma al commit.
#   - Falla si una guía de knowledge/ apunta a una ruta o help id que ya no existe,
#     o si falta su versión en inglés en knowledge/en/.
#   - Si cambió el generador de workflows del asistente, regenera n8n-workflows/help-*.json.
#
# Emergencia: git commit --no-verify (y corré `pnpm knowledge:build` después).

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

STAGED="$(git diff --cached --name-only --diff-filter=ACMRD)"

if printf '%s\n' "$STAGED" | grep -qE '^(src/|knowledge/|scripts/knowledge/)'; then
  if ! node scripts/knowledge/build-catalog.mjs; then
    echo ""
    echo "✖ Catálogo de ayuda con errores (ver arriba): corregí la guía en knowledge/ (o su versión en knowledge/en/) o el help id en el código."
    exit 1
  fi
  git add src/generated/help-catalog.json src/generated/help-catalog.en.json
fi

if printf '%s\n' "$STAGED" | grep -q '^scripts/n8n/generate-help-workflows.mjs$'; then
  node scripts/n8n/generate-help-workflows.mjs > /dev/null || exit 1
  git add n8n-workflows/help-*.json
fi
