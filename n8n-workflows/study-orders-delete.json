      "parameters": {
        "jsCode": "const userId = $json.jwtPayload?.userId;\nif (!userId) return [{ json: { __error: true, __code: 401, __message: 'Token sin userId' } }];\nconst id = ($json.body?.id || $json.query?.id || '').toString().trim();\nif (!id) return [{ json: { __error: true, __code: 400, __message: 'id es requerido' } }];\nreturn [{ json: { user_id: String(userId), id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
