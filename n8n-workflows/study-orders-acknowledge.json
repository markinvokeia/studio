{
  "name": "Study Orders - Acknowledge",
  "nodes": [
    {
      "parameters": {
        "content": "## POST /study-orders/acknowledge\n\nLa clínica \"toma\" la orden: la saca del bucket **nuevas** y la pasa a **sin agendar**.\n\nEs el paso de revisión previa. No es un estado persistido: se guarda `acknowledged_at` y la vista `v_study_orders_board` deriva el resto.\n\n**Body:** `{ \"id\": \"uuid\" }` · Requiere STUDY_ORDERS_ACKNOWLEDGE.",
        "height": 420,
        "width": 460,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -560,
        -180
      ],
      "id": "ack-doc",
      "name": "Contrato"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "study-orders/acknowledge",
        "authentication": "jwtAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "ack-wh",
      "name": "Webhook",
      "webhookId": "study-orders-ack",
      "credentials": {
        "jwtAuth": {
          "id": "C6sB1r7ab5H5EmJj",
          "name": "JWT Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const userId = $json.jwtPayload?.userId;\nif (!userId) return [{ json: { __error: true, __code: 401, __message: 'Token sin userId' } }];\nconst id = ($json.body?.id || '').toString().trim();\nif (!id) return [{ json: { __error: true, __code: 400, __message: 'id es requerido' } }];\nreturn [{ json: { user_id: String(userId), id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "ack-val",
      "name": "Validar Datos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ack-cond",
              "leftValue": "={{ $json.__error }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "id": "ack-if",
      "name": "¿Hubo error?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n-- $1 userId (token)  $2 id. Saca la orden del bucket \"nuevas\".\nWITH \nperms AS (\n    SELECT bool_or(p.code = 'STUDY_ORDERS_VIEW_ALL')  AS can_view_all,\n           bool_or(p.code = 'STUDY_ORDERS_CREATE_FOR_DOCTOR') AS can_create_for_doctor,\n           bool_or(p.code = 'STUDY_ORDERS_CANCEL')    AS can_cancel,\n           bool_or(p.code = 'STUDY_ORDERS_ACKNOWLEDGE') AS can_acknowledge,\n           bool_or(p.code = 'STUDY_ORDERS_SCHEDULE') AS can_schedule\n      FROM public.user_roles ur\n      JOIN public.role_permissions rp ON rp.role_id = ur.role_id\n      JOIN public.permissions p       ON p.id = rp.permission_id\n     WHERE ur.user_id = $1::uuid\n       AND ur.is_active IS NOT FALSE\n       AND p.code LIKE 'STUDY_ORDERS_%'\n)\nUPDATE public.study_orders so\n   SET acknowledged_at = now(), acknowledged_by = $1::uuid\n WHERE so.id = $2::uuid\n   AND so.status = 'submitted'\n   AND so.acknowledged_at IS NULL\n   AND (SELECT can_acknowledge FROM perms)\nRETURNING so.id::text, so.acknowledged_at;",
        "options": {
          "queryReplacement": "={{ [ $json.user_id, $json.id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        120
      ],
      "id": "ack-sql",
      "name": "Consulta",
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Arma el sobre { code, message, data, meta }. Un resultado vacío en una\n// operación de escritura significa que el WHERE de guarda no dejó pasar:\n// es un 409/404, no un 500.\nconst rows = $input.all().map((i) => i.json);\n\nif (!rows.length) {\n  return [{ json: { __error: true, __code: 409,\n    __message: 'La orden ya fue tomada, no está enviada, o no tenés permiso' } }];\n}\nreturn [{ json: { __data: rows[0], __message: 'Orden tomada' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ],
      "id": "ack-fmt",
      "name": "Formatear Respuesta"
    },
