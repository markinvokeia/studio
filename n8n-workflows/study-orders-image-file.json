{
  "name": "Study Orders - Image File",
  "nodes": [
    {
      "parameters": {
        "content": "## GET /study-orders/images/file (generado)\n\nEl frente o el dorso de una orden, bajado de Drive. El navegador nunca habla con Drive.\n\n**Query:** `order_id` (uuid), `id` (attachments.id).\n\nEl SQL exige todo a la vez: que el archivo sea de esa orden y que el usuario pueda abrirla (misma regla que el detalle). **404** si falta cualquiera.\n\nNo editar a mano: `scripts/n8n/generate-study-order-image-workflows.mjs`.",
        "height": 300,
        "width": 520,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -600,
        -260
      ],
      "id": "img-file-1",
      "name": "Contrato"
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "study-orders/images/file",
        "authentication": "jwtAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "img-file-2",
      "name": "Webhook",
      "webhookId": "study-orders-img-file",
      "credentials": {
        "jwtAuth": {
          "id": "C6sB1r7ab5H5EmJj",
          "name": "JWT Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const userId = $json.jwtPayload?.userId;\nif (!userId) return [{ json: { __error: true, __code: 401, __message: 'Token sin userId' } }];\nconst q = $json.query || {};\nconst orderId = (q.order_id || '').toString().trim();\nconst fileId = parseInt(q.id, 10);\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(orderId) || !Number.isFinite(fileId)) {\n  return [{ json: { __error: true, __code: 400, __message: 'order_id e id son requeridos' } }];\n}\nreturn [{ json: { user_id: String(userId), order_id: orderId, file_id: fileId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "img-file-3",
      "name": "Validar Datos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "img-file-4-cond",
              "leftValue": "={{ !$json.__error }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "id": "img-file-4",
      "name": "¿Datos OK?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { code: $json.__code || 500, message: $json.__message || \"No se pudo completar la operación\", data: null } }}",
        "options": {
          "responseCode": "={{ $json.__code || 400 }}"
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        720,
        220
      ],
      "id": "img-file-5",
      "name": "Responder Error"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n-- $1 userId (token)  $2 id de la orden  $3 id del adjunto\n-- El archivo tiene que ser de esa orden y quien lo pide poder abrirla (misma regla que DETAIL_SQL).\nWITH \nperms AS (\n    SELECT bool_or(p.code = 'STUDY_ORDERS_VIEW_ALL')  AS can_view_all,\n           bool_or(p.code = 'STUDY_ORDERS_CREATE_FOR_DOCTOR') AS can_create_for_doctor,\n           bool_or(p.code = 'STUDY_ORDERS_CANCEL')    AS can_cancel,\n           bool_or(p.code = 'STUDY_ORDERS_ACKNOWLEDGE') AS can_acknowledge,\n           bool_or(p.code = 'STUDY_ORDERS_SCHEDULE') AS can_schedule,\n           -- Acceso a la ficha del paciente: alcanza para ver sus órdenes (tab Órdenes de estudio).\n           bool_or(p.code = 'PATIENTS_VIEW_DETAIL') AS can_view_patient\n      FROM public.user_roles ur\n      JOIN public.role_permissions rp ON rp.role_id = ur.role_id\n      JOIN public.permissions p       ON p.id = rp.permission_id\n     WHERE ur.user_id = $1::uuid\n       AND ur.is_active IS NOT FALSE\n       AND (p.code LIKE 'STUDY_ORDERS_%' OR p.code = 'PATIENTS_VIEW_DETAIL')\n)\nSELECT at.drive_file_id, at.file_name, at.mime_type\n  FROM public.attachments at\n  JOIN public.study_orders so ON so.id::text = at.source_id\n WHERE at.id = $3::int\n   AND at.source_name IN ('study_order_front', 'study_order_back')\n   AND at.source_id = $2::text\n   AND (so.doctor_id = $1::uuid OR (SELECT can_view_all FROM perms)\n        OR ((SELECT can_view_patient FROM perms) AND so.patient_id IS NOT NULL AND so.status <> 'draft'));",
        "options": {
          "queryReplacement": "={{ [ $json.user_id, $json.order_id, $json.file_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        0
      ],
      "id": "img-file-6",
      "name": "Buscar Archivo",
      "credentials": {
        "postgres": {
          "id": "6b7Sjdnppbfve8ka",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "img-file-7-cond",
              "leftValue": "={{ !!$json.drive_file_id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "id": "img-file-7",
      "name": "¿Encontrado?"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.drive_file_id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1200,
        -80
      ],
      "id": "img-file-8",
      "name": "Descargar de Drive",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "k3vQaAkau21se8nC",
          "name": "Google Drive account 2"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "binary",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1440,
        -80
      ],
      "id": "img-file-9",
      "name": "Responder Archivo"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { code: 404, message: \"Archivo no encontrado o sin permiso\", data: null } }}",
        "options": {
          "responseCode": 404
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1200,
        120
      ],
      "id": "img-file-10",
      "name": "Responder 404"
    }
  ],
