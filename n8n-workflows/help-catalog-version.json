{
  "name": "Help - Catálogo Versión",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "parameters": {
        "httpMethod": "GET",
        "path": "help/catalog/version",
        "authentication": "jwtAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "credentials": {
        "jwtAuth": {
          "id": "C6sB1r7ab5H5EmJj",
          "name": "JWT Auth account"
        }
      },
      "position": [
        100,
        300
      ]
    },
    {
      "id": "node-auth",
      "name": "Extraer User ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Usuario autenticado: el Webhook ya verificó el JWT (credencial JWT Auth account)\nconst input = $input.first().json;\nconst userId = input.jwtPayload?.userId ?? input.jwtPayload?.sub;\nif (!userId) throw new Error('userId no encontrado en el token');\n\nreturn [{ json: { user_id: String(userId) } }];"
      },
      "position": [
        330,
        300
      ]
    },
    {
      "id": "node-pg-version",
      "name": "Última Publicación",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT catalog_version AS version, synced_at\n  FROM public.help_catalog_syncs\n ORDER BY synced_at DESC\n LIMIT 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "6b7Sjdnppbfve8ka",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true,
      "position": [
        560,
        300
      ]
    },
    {
      "id": "node-format",
      "name": "Formatear Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const row = $input.first()?.json || {};\nif (row.error) throw new Error('Error en base de datos: ' + (row.error?.message || String(row.error)));\nreturn [{ json: { body: { version: row.version ?? null, synced_at: row.synced_at ?? null } } }];"
      },
      "position": [
        790,
        300
      ]
    },
    {
      "id": "node-respond",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": 200
        }
      },
      "position": [
        1020,
        300
      ]
    }
  ],
