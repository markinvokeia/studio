    {
      "id": "pg-honorarios-generate",
      "name": "Generate Honorario Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        280
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT\n    COALESCE((SELECT (setting_value #>> '{}')::numeric FROM payroll_settings WHERE setting_key='honorarios_iva_rate'),0.22)            AS iva_rate,\n    COALESCE((SELECT (setting_value #>> '{}')::numeric FROM payroll_settings WHERE setting_key='honorarios_irpf_servicios_rate'),0.07) AS irpf_rate,\n    COALESCE((SELECT (setting_value #>> '{}')::numeric FROM payroll_settings WHERE setting_key='honorarios_retencion_iva_rate'),0)      AS ret_iva_rate,\n    COALESCE((SELECT (setting_value #>> '{}')::numeric FROM payroll_settings WHERE setting_key='honorarios_retencion_min_uyu'),0)       AS ret_min\n)\nINSERT INTO payroll_honorarios (\n  payroll_period_id, user_id, doctor_rut, modalidad, clinic_id,\n  produccion_base, porcentaje, descuentos, bruto, iva, retenciones, liquido, estado\n)\nSELECT\n  pe.payroll_period_id,\n  pe.user_id,\n  NULL::varchar,\n  (CASE pe.contract_type WHEN 'empresa_unipersonal' THEN 'empresa_unipersonal' ELSE 'honorarios' END)::honorarios_modalidad_enum,\n  pe.clinic_id,\n  pe.services_revenue_billed,\n  COALESCE(empl.productividad_porcentaje,0),\n  0,\n  pe.gross_salary,\n  ROUND(pe.gross_salary * s.iva_rate, 2),\n  ROUND((CASE WHEN pe.gross_salary >= s.ret_min THEN pe.gross_salary * s.irpf_rate ELSE 0 END)\n        + pe.gross_salary * s.iva_rate * s.ret_iva_rate, 2),\n  ROUND(pe.gross_salary + pe.gross_salary * s.iva_rate\n        - ((CASE WHEN pe.gross_salary >= s.ret_min THEN pe.gross_salary * s.irpf_rate ELSE 0 END)\n           + pe.gross_salary * s.iva_rate * s.ret_iva_rate), 2),\n  'pendiente'\nFROM payroll_entries pe\nCROSS JOIN s\nJOIN users u ON u.id = pe.user_id\nLEFT JOIN payroll_employments empl ON empl.id = pe.payroll_employment_id\nWHERE pe.payroll_period_id = $1::uuid\n  AND pe.contract_type IN ('honorarios','empresa_unipersonal','arrendamiento')\nON CONFLICT (payroll_period_id, user_id) DO UPDATE SET\n  produccion_base = EXCLUDED.produccion_base,\n  porcentaje      = EXCLUDED.porcentaje,\n  bruto           = EXCLUDED.bruto,\n  iva             = EXCLUDED.iva,\n  retenciones     = EXCLUDED.retenciones,\n  liquido         = EXCLUDED.liquido\nWHERE payroll_honorarios.estado IN ('pendiente','rechazada')\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [$input.first().json.body?.period_id || $input.first().json.query?.period_id || null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      }
