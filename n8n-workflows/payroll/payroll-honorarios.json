    {
      "id": "pg-honorarios-list",
      "name": "List Honorarios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ph.*, u.name AS doctor_name,\n  pp.period_year, pp.period_month\nFROM payroll_honorarios ph\nLEFT JOIN users u ON ph.user_id = u.id\nLEFT JOIN payroll_periods pp ON ph.payroll_period_id = pp.id\nWHERE ($1::uuid IS NULL OR ph.payroll_period_id = $1::uuid)\n  AND ($2::uuid IS NULL OR ph.user_id = $2::uuid)\n  AND ($3::text IS NULL OR ph.estado::text = $3)\nORDER BY pp.period_year DESC, pp.period_month DESC, u.name",
        "additionalFields": {
          "queryParams": "={{ [($input.first().json.query?.period_id||null),($input.first().json.query?.user_id||null),($input.first().json.query?.status||null)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      }
    },
    {
