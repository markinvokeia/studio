      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  id:             b.id || '',\n  factura_numero: b.factura_numero || '',\n  factura_fecha:  b.factura_fecha || ''\n} }];"
      }
    },
    {
      "id": "pg-honorarios-validate",
      "name": "Validate Invoice",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        540,
        460
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE payroll_honorarios\nSET estado = 'validada',\n    factura_numero = NULLIF($2,''),\n    factura_fecha = NULLIF($3,'')::date\nWHERE id = $1::uuid AND estado = 'pendiente'\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [$json.id,$json.factura_numero,$json.factura_fecha] }}"
        }
