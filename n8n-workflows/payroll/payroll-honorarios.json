    {
      "id": "wh-honorarios-generate",
      "name": "POST /payroll/honorarios/generate-order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        280
      ],
      "parameters": {
        "httpMethod": "POST",
