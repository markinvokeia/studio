      "position": [
        100,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "const b=$input.first().json.body||$input.first().json;\nconst s=v=>v==null?'':String(v);\nreturn [{json:{\n  id:s(b.id), payroll_period_id:s(b.payroll_period_id), user_id:s(b.user_id),\n  doctor_rut:s(b.doctor_rut), modalidad:s(b.modalidad), clinic_id:s(b.clinic_id),\n  produccion_base:s(b.produccion_base), porcentaje:s(b.porcentaje), descuentos:s(b.descuentos),\n  bruto:s(b.bruto), iva:s(b.iva), retenciones:s(b.retenciones), notes:s(b.notes)\n}}];"
      },
      "name": "Parse Upsert Honorario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        1200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO payroll_honorarios (\n  id, payroll_period_id, user_id, doctor_rut, modalidad, clinic_id,\n  produccion_base, porcentaje, descuentos, bruto, iva, retenciones, liquido, notes, estado\n) VALUES (\n  COALESCE(NULLIF($1,'')::uuid, gen_random_uuid()),\n  $2::uuid, $3::uuid, NULLIF($4,''),\n  COALESCE(NULLIF($5,'')::honorarios_modalidad_enum,'honorarios'),\n  NULLIF($6,'')::int,\n  COALESCE(NULLIF($7,'')::numeric,0), COALESCE(NULLIF($8,'')::numeric,0), COALESCE(NULLIF($9,'')::numeric,0),\n  COALESCE(NULLIF($10,'')::numeric,0), COALESCE(NULLIF($11,'')::numeric,0), COALESCE(NULLIF($12,'')::numeric,0),\n  COALESCE(NULLIF($10,'')::numeric,0) + COALESCE(NULLIF($11,'')::numeric,0)\n    - COALESCE(NULLIF($12,'')::numeric,0) - COALESCE(NULLIF($9,'')::numeric,0),\n  NULLIF($13,''), 'pendiente'\n)\nON CONFLICT (payroll_period_id, user_id) DO UPDATE SET\n  doctor_rut=EXCLUDED.doctor_rut, modalidad=EXCLUDED.modalidad,\n  produccion_base=EXCLUDED.produccion_base, porcentaje=EXCLUDED.porcentaje,\n  descuentos=EXCLUDED.descuentos, bruto=EXCLUDED.bruto, iva=EXCLUDED.iva,\n  retenciones=EXCLUDED.retenciones, liquido=EXCLUDED.liquido, notes=EXCLUDED.notes\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [$json.id,$json.payroll_period_id,$json.user_id,$json.doctor_rut,$json.modalidad,$json.clinic_id,$json.produccion_base,$json.porcentaje,$json.descuentos,$json.bruto,$json.iva,$json.retenciones,$json.notes] }}"
        }
      },
      "name": "Upsert Honorario",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
