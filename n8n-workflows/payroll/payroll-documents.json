    {
      "id": "code-docs-upsert-parse",
      "name": "Parse Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  period_id: b.period_id || '',\n  clinic_id: b.clinic_id != null && b.clinic_id !== '' ? Number(b.clinic_id) : null,\n  tipo: b.tipo || '',\n  estado: b.estado || 'pendiente',\n  formato: b.formato || '',\n  generated_by: b.generated_by || '',\n  error_message: b.error_message || ''\n} }];"
      }
    },
    {
      "id": "pg-docs-upsert",
      "name": "Upsert Document",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        540,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO payroll_documents\n  (payroll_period_id, clinic_id, tipo, estado, formato, generated_at, generated_by, error_message)\nVALUES\n  ($1::uuid, $2::integer, $3::payroll_document_tipo_enum, $4::payroll_document_estado_enum, NULLIF($5,''),\n   CASE WHEN $4 = 'generado' THEN NOW() ELSE NULL END, NULLIF($6,'')::uuid, NULLIF($7,''))\nON CONFLICT (payroll_period_id, tipo) DO UPDATE SET\n  estado        = EXCLUDED.estado,\n  formato       = COALESCE(NULLIF(EXCLUDED.formato,''), payroll_documents.formato),\n  generated_at  = CASE WHEN EXCLUDED.estado = 'generado' THEN NOW() ELSE payroll_documents.generated_at END,\n  generated_by  = COALESCE(EXCLUDED.generated_by, payroll_documents.generated_by),\n  error_message = EXCLUDED.error_message\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [$json.period_id,$json.clinic_id,$json.tipo,$json.estado,$json.formato,$json.generated_by,$json.error_message] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      }
    },
    {
