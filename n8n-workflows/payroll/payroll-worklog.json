    {
      "id": "code-wl-up",
      "name": "Parse WorkLog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst num = (v) => (v===undefined||v===null||v==='')?0:Number(v);\nreturn [{ json: {\n  id: b.id || '',\n  emp: b.employee_id || b.user_id || '',\n  fecha: b.fecha || '',\n  horas_normales: num(b.horas_normales),\n  horas_extra_habiles: num(b.horas_extra_habiles),\n  horas_extra_feriados: num(b.horas_extra_feriados),\n  sesiones: b.sesiones!=null?Number(b.sesiones):0,\n  produccion_facturada: num(b.produccion_facturada),\n  produccion_listada: num(b.produccion_listada),\n  notas: b.notas || '',\n  created_by: b.created_by || ''\n} }];"
      }
    },
    {
      "id": "pg-wl-up",
      "name": "Upsert WorkLog",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        540,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO payroll_work_log\n  (id, employee_id, clinic_id, fecha, horas_normales, horas_extra_habiles, horas_extra_feriados, sesiones, produccion_facturada, produccion_listada, origen, notas, created_by)\nSELECT COALESCE(NULLIF($1,'')::uuid, gen_random_uuid()), e.id, e.clinic_id, $3::date,\n  $4::decimal, $5::decimal, $6::decimal, $7::int, $8::decimal, $9::decimal, 'manual', NULLIF($10,''), NULLIF($11,'')::uuid\nFROM payroll_employees e WHERE e.id = $2::uuid OR e.user_id = $2::uuid LIMIT 1\nON CONFLICT (employee_id, fecha) DO UPDATE SET\n  horas_normales = EXCLUDED.horas_normales,\n  horas_extra_habiles = EXCLUDED.horas_extra_habiles,\n  horas_extra_feriados = EXCLUDED.horas_extra_feriados,\n  sesiones = EXCLUDED.sesiones,\n  produccion_facturada = EXCLUDED.produccion_facturada,\n  produccion_listada = EXCLUDED.produccion_listada,\n  origen = 'manual',\n  notas = EXCLUDED.notas\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [$json.id,$json.emp,$json.fecha,$json.horas_normales,$json.horas_extra_habiles,$json.horas_extra_feriados,$json.sesiones,$json.produccion_facturada,$json.produccion_listada,$json.notas,$json.created_by] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      }
    },
