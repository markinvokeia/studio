    },
    {
      "id": "pg-wl-prep",
      "name": "Prepopulate WorkLog",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        700
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH sess AS (\n  SELECT sc.doctor_id, sc.fecha_sesion::date AS fecha, sc.appointment_id, sc.invoice_id\n  FROM sesiones_clinicas sc\n  WHERE sc.fecha_sesion::date BETWEEN $1::date AND $2::date AND sc.doctor_id IS NOT NULL\n    AND ($3::uuid IS NULL OR sc.doctor_id = $3::uuid)\n),\ncounts AS (\n  SELECT s.doctor_id, s.fecha, COUNT(*)::int AS sesiones,\n    ROUND(COALESCE(SUM(COALESCE(EXTRACT(EPOCH FROM (a.end_datetime - a.start_datetime))/60.0,0)),0)/60.0, 2) AS horas\n  FROM sess s LEFT JOIN appointments a ON a.id = s.appointment_id\n  GROUP BY s.doctor_id, s.fecha\n),\nrev AS (\n  SELECT d.doctor_id, d.fecha, COALESCE(SUM(i.total),0) AS prod_listada, COALESCE(SUM(i.paid_amount),0) AS prod_facturada\n  FROM (SELECT DISTINCT doctor_id, fecha, invoice_id FROM sess WHERE invoice_id IS NOT NULL) d\n  JOIN invoices i ON i.id = d.invoice_id GROUP BY d.doctor_id, d.fecha\n)\nINSERT INTO payroll_work_log (employee_id, clinic_id, fecha, horas_normales, sesiones, produccion_facturada, produccion_listada, origen)\nSELECT e.id, e.clinic_id, c.fecha, c.horas, c.sesiones, COALESCE(r.prod_facturada,0), COALESCE(r.prod_listada,0), 'auto'\nFROM counts c\nJOIN payroll_employees e ON e.user_id = c.doctor_id\nLEFT JOIN rev r ON r.doctor_id = c.doctor_id AND r.fecha = c.fecha\nON CONFLICT (employee_id, fecha) DO UPDATE SET\n  horas_normales = EXCLUDED.horas_normales,\n  sesiones = EXCLUDED.sesiones,\n  produccion_facturada = EXCLUDED.produccion_facturada,\n  produccion_listada = EXCLUDED.produccion_listada\nWHERE payroll_work_log.origen = 'auto'\nRETURNING *",
        "additionalFields": {
          "queryParams": "={{ [($input.first().json.body||$input.first().json).date_from, ($input.first().json.body||$input.first().json).date_to, (($input.first().json.body||$input.first().json).user_id)||null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres"
        }
      }
    },
