    {
      "id": "wh-wl-prep",
      "name": "POST /payroll/worklog/prepopulate",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        700
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "payroll/worklog/prepopulate",
        "responseMode": "responseNode",
