    {
      "id": "pg-wl-by",
      "name": "WorkLog By Employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT w.* FROM payroll_work_log w\nJOIN payroll_employees pe ON pe.id = w.employee_id\nWHERE (pe.id = $1::uuid OR pe.user_id = $1::uuid)\n  AND w.fecha BETWEEN $2::date AND $3::date\nORDER BY w.fecha",
        "additionalFields": {
          "queryParams": "={{ [$input.first().json.query?.employee_id, $input.first().json.query?.date_from, $input.first().json.query?.date_to] }}"
        }
      },
