{
  "id": "config.schedules.create",
  "title": "Crear un horario",
  "module": "Configuración de Negocio",
  "summary": "Alta de un horario.",
  "screens": [
    "config.schedules"
  ],
  "inputs": {
    "start_time": "Desde",
    "end_time": "Hasta",
    "days_of_week": "Lista de días, 0=domingo, 1=lunes … 6=sábado (ej. [1,2,3,4,5])"
  },
  "keywords": [
    "nuevo horario",
    "nueva horario",
    "crear horario",
    "agregar horario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/schedules",
      "title": "Menú → Configuración de Negocio → Horarios",
      "details": "El horario de atención de cada sede, por día. Fuera de este horario la agenda no ofrece turnos."
    },
    {
      "id": "new",
      "action": "click",
      "target": "config.schedules.btn.new",
      "title": "Crear",
      "until": "config.schedules.field.days_of_week"
    },
    {
      "id": "days_of_week",
      "action": "fill",
      "target": "config.schedules.field.days_of_week",
      "title": "Días",
      "details": "Obligatorio: marcá todos los días con el mismo horario; se crea una franja por día.",
      "value": "{{values.days_of_week}}"
    },
    {
      "id": "start_time",
      "action": "fill",
      "target": "config.schedules.field.start_time",
      "title": "Desde",
      "details": "Hora de apertura.",
      "value": "{{values.start_time}}"
    },
    {
      "id": "end_time",
      "action": "fill",
      "target": "config.schedules.field.end_time",
      "title": "Hasta",
      "details": "Hora de cierre.",
      "value": "{{values.end_time}}"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.schedules.btn.submit",
      "title": "Guardar"
    }
  ]
}
