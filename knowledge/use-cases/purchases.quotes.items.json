{
  "id": "purchases.quotes.items",
  "title": "Ver y cambiar los ítems de un presupuesto",
  "module": "Compras",
  "summary": "Pestaña Artículos: las líneas del presupuesto; en borrador se agregan, editan o quitan.",
  "screens": [
    "purchases.quotes"
  ],
  "inputs": {
    "query": "Número o proveedor"
  },
  "keywords": [
    "ítems del presupuesto",
    "artículos",
    "líneas",
    "agregar servicio al presupuesto"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/quotes",
      "title": "Menú → Compras → Presupuestos de Compra",
      "details": "La cotización de un proveedor: qué productos o servicios, a qué precio. Confirmada, se factura al recibirla."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.quotes.filter.search",
      "title": "Buscá el presupuesto",
      "details": "Por número o por proveedor.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.quotes.section.first-row",
      "title": "Abrí el presupuesto",
      "details": "Tocá el presupuesto en la lista. La guía sigue cuando se abre su detalle.",
      "until": "purchases.quotes.section.detail-header",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "purchases.quotes.tab.items",
      "title": "Artículos"
    },
    {
      "id": "row",
      "action": "highlight",
      "target": "purchases.quotes.detail.section.first-row",
      "title": "Un ítem",
      "details": "Tocalo para editarlo o quitarlo (sólo en borradores).",
      "skipIfMissing": true
    },
    {
      "id": "add",
      "action": "highlight",
      "target": "purchases.quotes.detail.btn.new",
      "title": "Agregar ítem",
      "skipIfMissing": true
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "purchases.quotes.btn.item-edit",
      "title": "Editar ítem",
      "skipIfMissing": true
    },
    {
      "id": "remove",
      "action": "highlight",
      "target": "purchases.quotes.btn.item-delete",
      "title": "Quitar ítem",
      "skipIfMissing": true
    }
  ]
}
