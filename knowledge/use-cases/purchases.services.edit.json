{
  "id": "purchases.services.edit",
  "title": "Cambiar el precio o los datos de un producto o servicio",
  "module": "Compras",
  "summary": "Ficha del producto o servicio → Datos: se edita directo.",
  "screens": [
    "purchases.services"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar producto o servicio",
    "cambiar precio",
    "actualizar precio",
    "modificar duración"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/services",
      "title": "Menú → Compras → Productos y Servicios de Proveedores",
      "details": "Lo que la clínica le compra a proveedores, con su precio de referencia: se usa en presupuestos y facturas de compra."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.services.filter.search",
      "title": "Buscá el producto o servicio",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.services.section.first-row",
      "title": "Elegí el producto o servicio",
      "details": "Tocalo para abrir su ficha.",
      "until": "purchases.services.section.detail",
      "autoClick": true
    },
    {
      "id": "details",
      "action": "click",
      "target": "purchases.services.tab.details",
      "title": "Datos",
      "skipIfMissing": true
    },
    {
      "id": "price",
      "action": "highlight",
      "target": "purchases.services.field.price",
      "title": "Precio",
      "details": "El precio nuevo rige para presupuestos y facturas nuevas; los ya emitidos no cambian."
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "purchases.services.field.currency",
      "title": "Moneda",
      "skipIfMissing": true
    },
    {
      "id": "active",
      "action": "highlight",
      "target": "purchases.services.field.is_active",
      "title": "Activo",
      "details": "Inactivo deja de ofrecerse sin perder el historial.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.services.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
