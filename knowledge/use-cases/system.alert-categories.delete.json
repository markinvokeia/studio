{
  "id": "system.alert-categories.delete",
  "title": "Eliminar la categoría",
  "module": "Sistema",
  "summary": "Borrar (pide confirmación).",
  "screens": [
    "system.alert-categories"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar categoría",
    "borrar categoría"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/alert-categories",
      "title": "Menú → Sistema → Categorías de Alertas",
      "details": "Agrupan las alertas en el Centro de Alertas (cobranza, citas, cumpleaños…), con color, ícono y orden."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.alert-categories.filter.search",
      "title": "Buscá la categoría",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.alert-categories.section.first-row",
      "title": "Elegí la categoría",
      "until": "system.alert-categories.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "system.alert-categories.btn.delete",
      "title": "Eliminar",
      "until": "system.alert-categories.btn.confirm-action",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "system.alert-categories.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer.",
      "skipIfMissing": true
    }
  ]
}
