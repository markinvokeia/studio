{
  "id": "clinic-catalog.dental-conditions.create",
  "title": "Agregar una condición dental",
  "module": "Catálogo de la Clínica",
  "summary": "Alta en el catálogo de condiciones dentales.",
  "screens": [
    "clinic-catalog.dental-conditions"
  ],
  "inputs": {
    "name": "Nombre",
    "visual_code": "Código visual (corto, ej. CAR)"
  },
  "keywords": [
    "nuevo condición dental",
    "agregar condición dental"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-conditions",
      "title": "Menú → Catálogo de la Clínica → Condiciones Dentales",
      "details": "Lo que se marca en el odontograma (caries, corona, ausente…), con su color y código visual."
    },
    {
      "id": "new",
      "action": "click",
      "target": "clinic-catalog.dental-conditions.btn.new",
      "title": "Crear",
      "until": "clinic-catalog.dental-conditions.field.nombre"
    },
    {
      "id": "nombre",
      "action": "fill",
      "target": "clinic-catalog.dental-conditions.field.nombre",
      "title": "Nombre",
      "value": "{{values.name}}"
    },
    {
      "id": "codigo_visual",
      "action": "fill",
      "target": "clinic-catalog.dental-conditions.field.codigo_visual",
      "title": "Código visual",
      "details": "Obligatorio: el código corto con que se dibuja en el odontograma.",
      "value": "{{values.visual_code}}"
    },
    {
      "id": "color_hex",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.field.color_hex",
      "title": "Color",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.dental-conditions.btn.submit",
      "title": "Guardar"
    }
  ]
}
