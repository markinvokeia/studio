{
  "id": "config.doctor-availability.create",
  "title": "Crear una regla de disponibilidad",
  "module": "Configuración de Negocio",
  "summary": "Alta de una regla de disponibilidad.",
  "screens": [
    "config.doctor-availability"
  ],
  "inputs": {
    "start_time": "Desde",
    "end_time": "Hasta"
  },
  "keywords": [
    "nuevo regla de disponibilidad",
    "nueva regla de disponibilidad",
    "crear regla de disponibilidad",
    "agregar regla de disponibilidad"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctor-availability",
      "title": "Menú → Configuración de Negocio → Disponibilidad Médica",
      "details": "Cuándo atiende cada profesional: días y horas, desde y hasta cuándo. La agenda sólo ofrece turnos dentro de esta disponibilidad."
    },
    {
      "id": "new",
      "action": "click",
      "target": "config.doctor-availability.btn.new",
      "title": "Crear",
      "until": "config.doctor-availability.field.user_id"
    },
    {
      "id": "user_id",
      "action": "highlight",
      "target": "config.doctor-availability.field.user_id",
      "title": "Profesional"
    },
    {
      "id": "recurrence",
      "action": "highlight",
      "target": "config.doctor-availability.field.recurrence",
      "title": "Recurrencia",
      "details": "Semanal, quincenal o mensual."
    },
    {
      "id": "days_of_week",
      "action": "highlight",
      "target": "config.doctor-availability.field.days_of_week",
      "title": "Días"
    },
    {
      "id": "start_time",
      "action": "fill",
      "target": "config.doctor-availability.field.start_time",
      "title": "Desde",
      "value": "{{values.start_time}}"
    },
    {
      "id": "end_time",
      "action": "fill",
      "target": "config.doctor-availability.field.end_time",
      "title": "Hasta",
      "value": "{{values.end_time}}"
    },
    {
      "id": "start_date",
      "action": "highlight",
      "target": "config.doctor-availability.field.start_date",
      "title": "Vigente desde",
      "skipIfMissing": true
    },
    {
      "id": "end_date",
      "action": "highlight",
      "target": "config.doctor-availability.field.end_date",
      "title": "Vigente hasta",
      "details": "Opcional.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.doctor-availability.btn.submit",
      "title": "Guardar"
    }
  ]
}
