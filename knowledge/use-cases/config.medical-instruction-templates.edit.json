{
  "id": "config.medical-instruction-templates.edit",
  "title": "Editar la plantilla de indicación",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de una plantilla de indicación existente.",
  "screens": [
    "config.medical-instruction-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar plantilla de indicación",
    "modificar plantilla de indicación",
    "cambiar plantilla de indicación"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/medical-instruction-templates",
      "title": "Menú → Configuración de Negocio → Plantillas de Indicaciones Médicas",
      "details": "Textos base de indicaciones (post operatorio, cuidados) con variables del paciente; se eligen al dar una indicación."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.medical-instruction-templates.filter.search",
      "title": "Buscá la plantilla de indicación",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.medical-instruction-templates.section.first-row",
      "title": "Elegí la plantilla de indicación",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.medical-instruction-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.medical-instruction-templates.btn.edit",
      "title": "Editar",
      "until": "config.medical-instruction-templates.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "config.medical-instruction-templates.field.name",
      "title": "Nombre"
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "config.medical-instruction-templates.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "content_html",
      "action": "highlight",
      "target": "config.medical-instruction-templates.field.content_html",
      "title": "Contenido",
      "details": "Texto con variables ({paciente}, {fecha}…) que se completan solas."
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.medical-instruction-templates.field.is_active",
      "title": "Activa",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.medical-instruction-templates.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
