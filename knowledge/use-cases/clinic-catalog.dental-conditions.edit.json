{
  "id": "clinic-catalog.dental-conditions.edit",
  "title": "Editar la condición dental",
  "module": "Catálogo de la Clínica",
  "summary": "Cambiar sus datos.",
  "screens": [
    "clinic-catalog.dental-conditions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar condición dental",
    "modificar condición dental"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-conditions",
      "title": "Menú → Catálogo de la Clínica → Condiciones Dentales",
      "details": "Lo que se marca en el odontograma (caries, corona, ausente…), con su color y código visual."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.dental-conditions.filter.search",
      "title": "Buscá la condición dental",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.section.first-row",
      "title": "Elegí la condición dental",
      "until": "clinic-catalog.dental-conditions.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "clinic-catalog.dental-conditions.btn.edit",
      "title": "Editar",
      "until": "clinic-catalog.dental-conditions.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "nombre",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.field.nombre",
      "title": "Nombre",
      "skipIfMissing": true
    },
    {
      "id": "codigo_visual",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.field.codigo_visual",
      "title": "Código visual",
      "details": "Cómo se dibuja en la pieza.",
      "skipIfMissing": true
    },
    {
      "id": "color_hex",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.field.color_hex",
      "title": "Color",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.dental-conditions.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
