{
  "id": "system.communication-templates.edit",
  "title": "Editar la plantilla",
  "module": "Sistema",
  "summary": "Cambiar una plantilla existente.",
  "screens": [
    "system.communication-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar plantilla",
    "modificar plantilla"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/communication-templates",
      "title": "Menú → Sistema → Plantillas de Alertas",
      "details": "Los textos de correo, SMS y WhatsApp que usan las alertas, con variables del paciente y del caso."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.communication-templates.filter.search",
      "title": "Buscá la plantilla",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.communication-templates.section.first-row",
      "title": "Elegí la plantilla",
      "until": "system.communication-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "system.communication-templates.btn.edit",
      "title": "Editar",
      "until": "system.communication-templates.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "system.communication-templates.field.name",
      "title": "Nombre",
      "skipIfMissing": true
    },
    {
      "id": "code",
      "action": "highlight",
      "target": "system.communication-templates.field.code",
      "title": "Código",
      "skipIfMissing": true
    },
    {
      "id": "type",
      "action": "highlight",
      "target": "system.communication-templates.field.type",
      "title": "Tipo",
      "details": "Correo, SMS o WhatsApp.",
      "skipIfMissing": true
    },
    {
      "id": "category_id",
      "action": "highlight",
      "target": "system.communication-templates.field.category_id",
      "title": "Categoría",
      "skipIfMissing": true
    },
    {
      "id": "subject",
      "action": "highlight",
      "target": "system.communication-templates.field.subject",
      "title": "Asunto",
      "details": "Sólo correo.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.communication-templates.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
