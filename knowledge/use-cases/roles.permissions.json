{
  "id": "roles.permissions",
  "title": "Asignar permisos a un rol",
  "module": "Sistema",
  "summary": "Pestaña Permisos del rol: qué puede ver y hacer quien lo tenga.",
  "screens": [
    "roles"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "permisos del rol",
    "dar permiso",
    "quitar permiso",
    "acceso a una pantalla"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/roles",
      "title": "Menú → Sistema → Roles"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "roles.filter.search",
      "title": "Buscá el rol",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "roles.section.first-row",
      "title": "Elegí el rol",
      "until": "roles.section.detail",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "roles.detail.tab.permissions",
      "title": "Permisos",
      "details": "Marcá o desmarcá los permisos; los usuarios con este rol los toman al volver a entrar."
    }
  ]
}
