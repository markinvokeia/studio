{
  "id": "config.doctors.create",
  "title": "Dar de alta un profesional",
  "module": "Configuración de Negocio",
  "summary": "Alta con sus datos de contacto; el correo es su usuario para entrar.",
  "screens": [
    "config.doctors"
  ],
  "inputs": {
    "name": "Nombre",
    "email": "Correo",
    "phone": "Teléfono"
  },
  "keywords": [
    "nuevo profesional",
    "dar de alta",
    "agregar al equipo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctors",
      "title": "Menú → Configuración de Negocio → Doctores"
    },
    {
      "id": "new",
      "action": "click",
      "target": "config.doctors.btn.new",
      "title": "Crear",
      "details": "Si la clínica llegó al máximo de usuarios de su licencia, en vez del formulario aparece un aviso.",
      "until": "config.doctors.field.name"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "config.doctors.field.name",
      "title": "Nombre",
      "value": "{{values.name}}"
    },
    {
      "id": "email",
      "action": "fill",
      "target": "config.doctors.field.email",
      "title": "Correo",
      "details": "Con este correo entra al sistema.",
      "value": "{{values.email}}"
    },
    {
      "id": "phone",
      "action": "fill",
      "target": "config.doctors.field.phone",
      "title": "Teléfono",
      "value": "{{values.phone}}",
      "optional": true
    },
    {
      "id": "identity_document",
      "action": "highlight",
      "target": "config.doctors.field.identity_document",
      "title": "Documento",
      "skipIfMissing": true
    },
    {
      "id": "color",
      "action": "highlight",
      "target": "config.doctors.field.color",
      "title": "Color",
      "details": "Color de sus citas en la agenda.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.doctors.btn.submit",
      "title": "Guardar",
      "details": "Después enviale la contraseña inicial desde su ficha."
    }
  ]
}
