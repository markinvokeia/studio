{
  "id": "system.communication-history.overview",
  "title": "Consultar Historial de Alertas",
  "module": "Sistema",
  "summary": "Cada correo, WhatsApp o SMS enviado: a quién, cuándo, con qué plantilla y si llegó.",
  "screens": [
    "system.communication-history"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "comunicaciones enviadas",
    "historial de mensajes",
    "correos enviados"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/communication-history",
      "title": "Menú → Sistema → Historial de Alertas",
      "details": "Cada correo, WhatsApp o SMS enviado: a quién, cuándo, con qué plantilla y si llegó."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.communication-history.filter.search",
      "title": "Buscar",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.communication-history.section.first-row",
      "title": "El más reciente",
      "details": "Tocalo para ver el detalle.",
      "until": "system.communication-history.section.detail",
      "autoClick": true,
      "skipIfMissing": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "system.communication-history.section.detail",
      "title": "Detalle",
      "skipIfMissing": true
    }
  ]
}
