{
  "id": "sales.services.edit",
  "title": "Cambiar el precio o los datos de un servicio",
  "module": "Ventas",
  "summary": "Ficha del servicio → Datos: se edita directo.",
  "screens": [
    "sales.services"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar servicio",
    "cambiar precio",
    "actualizar precio",
    "modificar duración"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/services",
      "title": "Menú → Ventas → Servicios",
      "details": "Lo que la clínica ofrece y cobra: precio, moneda, duración en la agenda, color, categoría y si se reserva en línea. Es la lista de precios de presupuestos, facturas y citas."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.services.filter.search",
      "title": "Buscá el servicio",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.services.section.first-row",
      "title": "Elegí el servicio",
      "details": "Tocalo para abrir su ficha.",
      "until": "sales.services.section.detail",
      "autoClick": true
    },
    {
      "id": "details",
      "action": "click",
      "target": "sales.services.tab.details",
      "title": "Datos",
      "skipIfMissing": true
    },
    {
      "id": "price",
      "action": "highlight",
      "target": "sales.services.field.price",
      "title": "Precio",
      "details": "El precio nuevo rige para presupuestos y facturas nuevas; los ya emitidos no cambian."
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "sales.services.field.currency",
      "title": "Moneda",
      "skipIfMissing": true
    },
    {
      "id": "duration",
      "action": "highlight",
      "target": "sales.services.field.duration_minutes",
      "title": "Duración",
      "skipIfMissing": true
    },
    {
      "id": "active",
      "action": "highlight",
      "target": "sales.services.field.is_active",
      "title": "Activo",
      "details": "Inactivo deja de ofrecerse sin perder el historial.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "sales.services.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
