{
  "id": "roles.overview",
  "title": "Recorrer Roles",
  "module": "Sistema",
  "summary": "Los perfiles de acceso (Recepción, Doctor, Administración…): cada uno agrupa permisos.",
  "screens": [
    "roles"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "roles",
    "rol",
    "ver rol"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/roles",
      "title": "Menú → Sistema → Roles",
      "details": "Los perfiles de acceso (Recepción, Doctor, Administración…): cada uno agrupa permisos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "roles.filter.search",
      "title": "Buscá el rol",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "roles.section.first-row",
      "title": "Elegí el rol",
      "until": "roles.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "roles.section.detail",
      "title": "Ficha"
    },
    {
      "id": "tab-details",
      "action": "click",
      "target": "roles.detail.tab.details",
      "title": "Datos",
      "skipIfMissing": true
    },
    {
      "id": "tab-users",
      "action": "click",
      "target": "roles.detail.tab.users",
      "title": "Usuarios",
      "details": "Quiénes tienen este rol.",
      "skipIfMissing": true
    },
    {
      "id": "tab-permissions",
      "action": "click",
      "target": "roles.detail.tab.permissions",
      "title": "Permisos",
      "details": "Qué puede ver y hacer quien tenga el rol.",
      "skipIfMissing": true
    }
  ]
}
