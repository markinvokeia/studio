{
  "id": "system.config.overview",
  "title": "Recorrer Configuraciones",
  "module": "Sistema",
  "summary": "Parámetros técnicos del sistema (clave y valor). Cambiarlos afecta el funcionamiento: hacelo sólo si sabés qué controla cada clave.",
  "screens": [
    "system.config"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "configuraciones",
    "configuración"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/config",
      "title": "Menú → Sistema → Configuraciones",
      "details": "Parámetros técnicos del sistema (clave y valor). Cambiarlos afecta el funcionamiento: hacelo sólo si sabés qué controla cada clave."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.config.filter.search",
      "title": "Buscá la configuración",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.config.section.first-row",
      "title": "Elegí la configuración",
      "until": "system.config.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "system.config.section.detail",
      "title": "Detalle"
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "system.config.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "system.config.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    }
  ]
}
