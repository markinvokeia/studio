{
  "id": "purchases.providers.quote",
  "title": "Pedir un presupuesto al proveedor",
  "module": "Compras",
  "summary": "Crear → Presupuesto: queda en Compras → Presupuestos de Compra.",
  "screens": [
    "purchases.providers"
  ],
  "group": "Compras al proveedor",
  "inputs": {
    "query": "Nombre, correo o RUT"
  },
  "keywords": [
    "pedir un presupuesto al proveedor",
    "proveedor"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/providers",
      "title": "Menú → Compras → Proveedores",
      "details": "Laboratorios, depósitos y servicios a los que la clínica les compra; con su cuenta: presupuestos, facturas y pagos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.providers.filter.search",
      "title": "Buscá el proveedor",
      "details": "Por nombre, correo o RUT.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.providers.section.first-row",
      "title": "Abrí su ficha",
      "until": "purchases.providers.section.detail",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "purchases.providers.btn.create-menu",
      "title": "Crear",
      "until": "purchases.providers.btn.new-quote"
    },
    {
      "id": "item",
      "action": "click",
      "target": "purchases.providers.btn.new-quote",
      "title": "Pedir un presupuesto al proveedor",
      "details": "Crear → Presupuesto: queda en Compras → Presupuestos de Compra.",
      "until": "purchases.providers.btn.submit"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.providers.btn.submit",
      "title": "Guardar",
      "details": "Completá los datos del formulario y guardá."
    }
  ]
}
