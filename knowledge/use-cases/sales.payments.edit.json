{
  "id": "sales.payments.edit",
  "title": "Corregir el medio de pago",
  "module": "Ventas",
  "summary": "Cambiar el medio de pago de un pago registrado (el monto no se cambia).",
  "screens": [
    "sales.payments"
  ],
  "inputs": {
    "query": "Número de pago"
  },
  "keywords": [
    "editar pago",
    "cambiar medio de pago",
    "corregir pago",
    "me equivoqué de método"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/payments",
      "title": "Menú → Ventas → Pagos",
      "details": "Los cobros a pacientes: pagos de facturas y prepagos (dinero a cuenta que después se aplica a facturas)."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.payments.filter.search",
      "title": "Buscá el pago",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "actions",
      "action": "highlight",
      "target": "sales.payments.btn.row-actions",
      "title": "Acciones del pago",
      "details": "Abrí el menú de la fila.",
      "until": [
        "sales.payments.btn.row-edit",
        "sales.payments.btn.row-print",
        "sales.payments.btn.row-email"
      ],
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "sales.payments.btn.row-edit",
      "title": "Editar",
      "details": "Sólo pagos que se pueden corregir (de la caja abierta).",
      "until": "sales.payments.field.payment-edit-method",
      "skipIfMissing": true
    },
    {
      "id": "method",
      "action": "highlight",
      "target": "sales.payments.field.payment-edit-method",
      "title": "Medio de pago",
      "details": "El monto queda fijo; para cambiarlo, anulá y registrá de nuevo.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "sales.payments.btn.payment-edit-save",
      "title": "Guardar",
      "skipIfMissing": true
    }
  ]
}
