    {
      "id": "delete",
      "action": "highlight",
      "target": "config.sequences.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.sequences.btn.new",
