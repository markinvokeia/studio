{
  "id": "purchases.providers.overview",
  "title": "Recorrer la ficha de un proveedor",
  "module": "Compras",
  "summary": "Encabezado con acciones (crear, preferencias, activar, email, WhatsApp) y pestañas Información, Servicios, Presupuestos, Facturas, Pagos y Notas.",
  "screens": [
    "purchases.providers"
  ],
  "group": "Listado y alta",
  "inputs": {
    "query": "Nombre, correo o RUT"
  },
  "keywords": [
    "proveedores",
    "ficha del proveedor",
    "ver proveedor"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/providers",
      "title": "Menú → Compras → Proveedores",
      "details": "Laboratorios, depósitos y servicios a los que la clínica les compra; con su cuenta: presupuestos, facturas y pagos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.providers.filter.search",
      "title": "Buscá el proveedor",
      "details": "Por nombre, correo o RUT.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.providers.section.first-row",
      "title": "Abrí su ficha",
      "until": "purchases.providers.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "purchases.providers.section.detail",
      "title": "Encabezado",
      "details": "Nombre, estado y acciones."
    },
    {
      "id": "create",
      "action": "highlight",
      "target": "purchases.providers.btn.create-menu",
      "title": "Crear",
      "details": "Presupuesto, factura o anticipo para este proveedor.",
      "skipIfMissing": true
    },
    {
      "id": "email",
      "action": "highlight",
      "target": "purchases.providers.btn.email",
      "title": "Email",
      "skipIfMissing": true
    },
    {
      "id": "wa",
      "action": "highlight",
      "target": "purchases.providers.btn.whatsapp",
      "title": "WhatsApp",
      "skipIfMissing": true
    },
    {
      "id": "info",
      "action": "click",
      "target": "purchases.providers.tab.info",
      "title": "Información",
      "details": "Datos de contacto, RUT y cuenta bancaria.",
      "skipIfMissing": true
    },
    {
      "id": "services",
      "action": "click",
      "target": "purchases.providers.tab.services",
      "title": "Servicios",
      "details": "Lo que le compramos a este proveedor.",
      "skipIfMissing": true
    },
    {
      "id": "quotes",
      "action": "click",
      "target": "purchases.providers.tab.quotes",
      "title": "Presupuestos",
      "skipIfMissing": true
    },
    {
      "id": "invoices",
      "action": "click",
      "target": "purchases.providers.tab.invoices",
      "title": "Facturas",
      "details": "Lo que le debemos.",
      "skipIfMissing": true
    },
    {
      "id": "payments",
      "action": "click",
      "target": "purchases.providers.tab.payments",
      "title": "Pagos",
      "details": "Lo que le pagamos.",
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "click",
      "target": "purchases.providers.tab.notes",
      "title": "Notas",
      "skipIfMissing": true
    }
  ]
}
