{
  "id": "sales.payment-methods.edit",
  "title": "Editar un método de pago",
  "module": "Ventas",
  "summary": "Cambiar nombre, código o si cuenta como efectivo.",
  "screens": [
    "sales.payment-methods"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar método de pago",
    "cambiar método"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/payment-methods",
      "title": "Menú → Ventas → Métodos de Pago",
      "details": "Efectivo, tarjetas, transferencias… con los que se cobra y paga. Los equivalentes a efectivo suman al arqueo de caja."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.payment-methods.filter.search",
      "title": "Buscá el método",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.payment-methods.section.first-row",
      "title": "Elegí el método",
      "until": "sales.payment-methods.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "sales.payment-methods.btn.edit",
      "title": "Editar",
      "until": "sales.payment-methods.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "sales.payment-methods.field.name",
      "title": "Nombre"
    },
    {
      "id": "code",
      "action": "highlight",
      "target": "sales.payment-methods.field.code",
      "title": "Código",
      "details": "Corto, para reportes (EFE, TC, TRF)."
    },
    {
      "id": "is_cash_equivalent",
      "action": "highlight",
      "target": "sales.payment-methods.field.is_cash_equivalent",
      "title": "Equivale a efectivo",
      "details": "Si lo marcás, suma al arqueo de caja como el efectivo."
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "sales.payment-methods.field.is_active",
      "title": "Activo"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "sales.payment-methods.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
