{
  "id": "sales.quotes.delete",
  "title": "Eliminar un presupuesto en borrador",
  "module": "Ventas",
  "summary": "Borrar un presupuesto que no se confirmó (los confirmados no se eliminan).",
  "screens": [
    "sales.quotes"
  ],
  "inputs": {
    "query": "Número o paciente"
  },
  "keywords": [
    "eliminar presupuesto",
    "borrar presupuesto",
    "anular presupuesto"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/quotes",
      "title": "Menú → Ventas → Presupuestos",
      "details": "El plan de tratamiento con precios para que el paciente lo apruebe; confirmado se factura, se agenda y se cobra."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.quotes.filter.search",
      "title": "Buscá el presupuesto",
      "details": "Por número o por paciente.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.quotes.section.first-row",
      "title": "Abrí el presupuesto",
      "details": "Tocá el presupuesto en la lista. La guía sigue cuando se abre su detalle.",
      "until": "sales.quotes.section.detail-header",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "sales.quotes.btn.delete",
      "title": "Eliminar",
      "details": "Sólo en borradores.",
      "until": "sales.quotes.btn.delete-confirm",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "sales.quotes.btn.delete-confirm",
      "title": "Confirmar eliminación",
      "details": "No se puede deshacer.",
      "skipIfMissing": true
    }
  ]
}
