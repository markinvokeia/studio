{
  "id": "purchases.payments.prepaid",
  "title": "Registrar un anticipo a un proveedor",
  "module": "Compras",
  "summary": "Pago a cuenta sin factura; queda como saldo para aplicar después.",
  "screens": [
    "purchases.payments"
  ],
  "inputs": {
    "party": "Proveedor",
    "amount": "Monto",
    "notes": "Notas",
    "payment_method": "Medio de pago (ej. Efectivo)"
  },
  "keywords": [
    "prepago",
    "seña",
    "pago a cuenta",
    "anticipo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/payments",
      "title": "Menú → Compras → Pagos de Compra",
      "details": "Lo que la clínica le paga a proveedores: pagos de facturas de compra y anticipos."
    },
    {
      "id": "new",
      "action": "click",
      "target": "purchases.payments.btn.new",
      "title": "Crear anticipo",
      "details": "Dinero que se le adelanta al proveedor; después se aplica a facturas.",
      "until": "purchases.payments.field.payment_amount"
    },
    {
      "id": "party",
      "action": "fill",
      "target": "purchases.payments.field.user_id",
      "title": "Proveedor",
      "value": "{{values.party}}"
    },
    {
      "id": "amount",
      "action": "fill",
      "target": "purchases.payments.field.payment_amount",
      "title": "Monto",
      "value": "{{values.amount}}",
      "optional": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "purchases.payments.field.currency",
      "title": "Moneda"
    },
    {
      "id": "method",
      "action": "fill",
      "target": "purchases.payments.field.payment_method_id",
      "title": "Medio de pago",
      "details": "Obligatorio. Los pagos en efectivo salen de la caja abierta.",
      "value": "{{values.payment_method}}"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "purchases.payments.field.created_at",
      "title": "Fecha",
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "fill",
      "target": "purchases.payments.field.notes",
      "title": "Notas",
      "value": "{{values.notes}}",
      "optional": true
    },
    {
      "id": "historical",
      "action": "highlight",
      "target": "purchases.payments.field.is_historical",
      "title": "Histórico",
      "details": "Para registrar pagos viejos sin caja abierta.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.payments.btn.submit",
      "title": "Guardar",
      "details": "Necesita la caja abierta (salvo histórico)."
    }
  ]
}
