{
  "id": "system.config.edit",
  "title": "Editar la configuración",
  "module": "Sistema",
  "summary": "Cambiar una configuración existente.",
  "screens": [
    "system.config"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar configuración",
    "modificar configuración"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/config",
      "title": "Menú → Sistema → Configuraciones",
      "details": "Parámetros técnicos del sistema (clave y valor). Cambiarlos afecta el funcionamiento: hacelo sólo si sabés qué controla cada clave."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.config.filter.search",
      "title": "Buscá la configuración",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.config.section.first-row",
      "title": "Elegí la configuración",
      "until": "system.config.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "system.config.btn.edit",
      "title": "Editar",
      "until": "system.config.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "key",
      "action": "highlight",
      "target": "system.config.field.key",
      "title": "Clave",
      "skipIfMissing": true
    },
    {
      "id": "value",
      "action": "highlight",
      "target": "system.config.field.value",
      "title": "Valor",
      "skipIfMissing": true
    },
    {
      "id": "data_type",
      "action": "highlight",
      "target": "system.config.field.data_type",
      "title": "Tipo de dato",
      "skipIfMissing": true
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "system.config.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "is_public",
      "action": "highlight",
      "target": "system.config.field.is_public",
      "title": "Público",
      "details": "Visible para la app sin permisos especiales.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.config.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
