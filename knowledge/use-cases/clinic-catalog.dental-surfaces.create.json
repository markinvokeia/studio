{
  "id": "clinic-catalog.dental-surfaces.create",
  "title": "Agregar una superficie dental",
  "module": "Catálogo de la Clínica",
  "summary": "Alta en el catálogo de superficies dentales.",
  "screens": [
    "clinic-catalog.dental-surfaces"
  ],
  "inputs": {
    "name": "Nombre"
  },
  "keywords": [
    "nuevo superficie dental",
    "agregar superficie dental"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-surfaces",
      "title": "Menú → Catálogo de la Clínica → Superficies Dentales",
      "details": "Las caras de cada pieza (oclusal, mesial, distal…) que se eligen en el odontograma."
    },
    {
      "id": "new",
      "action": "click",
      "target": "clinic-catalog.dental-surfaces.btn.new",
      "title": "Crear",
      "until": "clinic-catalog.dental-surfaces.field.nombre"
    },
    {
      "id": "nombre",
      "action": "fill",
      "target": "clinic-catalog.dental-surfaces.field.nombre",
      "title": "Nombre",
      "value": "{{values.name}}"
    },
    {
      "id": "codigo",
      "action": "highlight",
      "target": "clinic-catalog.dental-surfaces.field.codigo",
      "title": "Código",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.dental-surfaces.btn.submit",
      "title": "Guardar"
    }
  ]
}
