{
  "id": "workspace.prescribe",
  "title": "Hacer una receta desde la cita",
  "module": "Mi Consultorio",
  "summary": "Crear la receta del paciente: plantilla, diagnóstico, medicamentos con dosis y frecuencia, e imprimirla.",
  "screens": [
    "workspace"
  ],
  "inputs": {
    "template": "Nombre de la plantilla",
    "diagnosis": "Diagnóstico",
    "medication": "Medicamento",
    "dosage": "Dosis (ej. 500 mg)",
    "frequency": "Frecuencia (ej. cada 8 horas)",
    "duration_days": "Días de tratamiento (número)",
    "instructions": "Indicaciones"
  },
  "keywords": [
    "receta",
    "recetar",
    "prescripcion",
    "medicamento",
    "dosis",
    "indicaciones",
    "imprimir receta"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/workspace",
      "title": "Menú → Mi Consultorio",
      "details": "La vista del profesional: su agenda y el panel clínico del paciente que atiende."
    },
    {
      "id": "select",
      "action": "highlight",
      "target": "workspace.section.appointment",
      "title": "Elegí la cita del paciente",
      "until": "workspace.section.focus",
      "autoClick": true,
      "details": "Tocá la cita en la agenda: a la derecha se abre el panel del paciente. Si no ves citas, cambiá el día o el período arriba."
    },
    {
      "id": "open",
      "action": "click",
      "target": "workspace.btn.prescribe",
      "title": "Recetar"
    },
    {
      "id": "template",
      "action": "fill",
      "target": "workspace.field.rx-template",
      "value": "{{values.template}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true,
      "title": "Plantilla",
      "details": "Una receta armada de antemano (Configuración → Plantillas de indicaciones) que completa los medicamentos."
    },
    {
      "id": "diagnosis",
      "action": "fill",
      "target": "workspace.field.rx-diagnosis",
      "value": "{{values.diagnosis}}",
      "optional": true,
      "ask": true,
      "title": "Diagnóstico"
    },
    {
      "id": "add",
      "action": "highlight",
      "target": "workspace.btn.rx-add-medication",
      "title": "Agregar medicamento",
      "until": "workspace.field.rx-medication",
      "autoClick": true,
      "details": "Cada medicamento lleva presentación, dosis, vía, frecuencia, duración, cantidad e indicaciones."
    },
    {
      "id": "medication",
      "action": "fill",
      "target": "workspace.field.rx-medication",
      "value": "{{values.medication}}",
      "title": "Medicamento"
    },
    {
      "id": "dosage",
      "action": "fill",
      "target": "workspace.field.rx-dosage",
      "value": "{{values.dosage}}",
      "title": "Dosis"
    },
    {
      "id": "frequency",
      "action": "fill",
      "target": "workspace.field.rx-frequency",
      "value": "{{values.frequency}}",
      "title": "Frecuencia"
    },
    {
      "id": "duration",
      "action": "fill",
      "target": "workspace.field.rx-duration",
      "value": "{{values.duration_days}}",
      "optional": true,
      "ask": true,
      "title": "Duración (días)"
    },
    {
      "id": "instructions",
      "action": "fill",
      "target": "workspace.field.rx-instructions",
      "value": "{{values.instructions}}",
      "optional": true,
      "ask": true,
      "title": "Indicaciones"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "workspace.btn.submit",
      "title": "Guardar la receta",
      "details": "Después podés imprimirla con el botón de imprimir."
    }
  ]
}
