{
  "id": "config.prescription-templates.overview",
  "title": "Recorrer Plantillas de Receta",
  "module": "Configuración de Negocio",
  "summary": "Recetas habituales con medicamentos e indicaciones; se eligen al recetar.",
  "screens": [
    "config.prescription-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "plantillas de receta",
    "plantilla de receta",
    "ver plantilla de receta",
    "qué es plantilla de receta"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/prescription-templates",
      "title": "Menú → Configuración de Negocio → Plantillas de Receta",
      "details": "Recetas habituales con medicamentos e indicaciones; se eligen al recetar."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.prescription-templates.filter.search",
      "title": "Buscá la plantilla de receta",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.prescription-templates.section.first-row",
      "title": "Elegí la plantilla de receta",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.prescription-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.prescription-templates.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.prescription-templates.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.prescription-templates.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.prescription-templates.btn.new",
      "title": "Crear",
      "details": "Agrega una nueva plantilla de receta.",
      "skipIfMissing": true
    }
  ]
}
