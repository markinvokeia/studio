{
  "id": "config.calendars.overview",
  "title": "Recorrer Calendarios",
  "module": "Configuración de Negocio",
  "summary": "Los consultorios o sillones: cada uno es una columna de la agenda, con su sede, color y quién atiende ahí.",
  "screens": [
    "config.calendars"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "calendarios",
    "calendario",
    "ver calendario",
    "qué es calendario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/calendars",
      "title": "Menú → Configuración de Negocio → Calendarios",
      "details": "Los consultorios o sillones: cada uno es una columna de la agenda, con su sede, color y quién atiende ahí."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.calendars.filter.search",
      "title": "Buscá el calendario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.calendars.section.first-row",
      "title": "Elegí el calendario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.calendars.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.calendars.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.calendars.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.calendars.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.calendars.btn.new",
      "title": "Crear",
      "details": "Agrega un nuevo calendario.",
      "skipIfMissing": true
    }
  ]
}
