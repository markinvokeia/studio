{
  "id": "clinic-catalog.dental-conditions.overview",
  "title": "Recorrer Condiciones Dentales",
  "module": "Catálogo de la Clínica",
  "summary": "Lo que se marca en el odontograma (caries, corona, ausente…), con su color y código visual.",
  "screens": [
    "clinic-catalog.dental-conditions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "condiciones dentales",
    "condición dental",
    "catálogo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-conditions",
      "title": "Menú → Catálogo de la Clínica → Condiciones Dentales",
      "details": "Lo que se marca en el odontograma (caries, corona, ausente…), con su color y código visual."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.dental-conditions.filter.search",
      "title": "Buscá la condición dental",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.section.first-row",
      "title": "Elegí la condición dental",
      "until": "clinic-catalog.dental-conditions.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.section.detail",
      "title": "Detalle"
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.btn.new",
      "title": "Crear",
      "skipIfMissing": true
    }
  ]
}
