{
  "id": "config.medical-instruction-templates.overview",
  "title": "Recorrer Plantillas de Indicaciones Médicas",
  "module": "Configuración de Negocio",
  "summary": "Textos base de indicaciones (post operatorio, cuidados) con variables del paciente; se eligen al dar una indicación.",
  "screens": [
    "config.medical-instruction-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "plantillas de indicaciones médicas",
    "plantilla de indicación",
    "ver plantilla de indicación",
    "qué es plantilla de indicación"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/medical-instruction-templates",
      "title": "Menú → Configuración de Negocio → Plantillas de Indicaciones Médicas",
      "details": "Textos base de indicaciones (post operatorio, cuidados) con variables del paciente; se eligen al dar una indicación."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.medical-instruction-templates.filter.search",
      "title": "Buscá la plantilla de indicación",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.medical-instruction-templates.section.first-row",
      "title": "Elegí la plantilla de indicación",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.medical-instruction-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.medical-instruction-templates.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.medical-instruction-templates.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.medical-instruction-templates.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.medical-instruction-templates.btn.new",
      "title": "Crear",
      "details": "Agrega una nueva plantilla de indicación.",
      "skipIfMissing": true
    }
  ]
}
