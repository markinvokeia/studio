{
  "id": "purchases.payments.overview",
  "title": "Recorrer pagos de compra",
  "module": "Compras",
  "summary": "Listado con filtro por tipo (prepago, pago directo, asignaciones), detalle del pago, saldo a favor y asignaciones.",
  "screens": [
    "purchases.payments"
  ],
  "inputs": {
    "query": "Número de pago"
  },
  "keywords": [
    "pagos de compra",
    "pagos a proveedores",
    "anticipos"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/payments",
      "title": "Menú → Compras → Pagos de Compra",
      "details": "Lo que la clínica le paga a proveedores: pagos de facturas de compra y anticipos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.payments.filter.search",
      "title": "Buscar",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "filters",
      "action": "click",
      "target": "purchases.payments.btn.filters",
      "title": "Filtrar por tipo",
      "until": "purchases.payments.section.filters",
      "skipIfMissing": true
    },
    {
      "id": "type",
      "action": "highlight",
      "target": "purchases.payments.section.filters",
      "title": "Tipo",
      "details": "Prepago (a cuenta), pago directo de factura, asignación de pago o de nota de crédito.",
      "doneOnClose": true,
      "skipIfMissing": true
    },
    {
      "id": "export",
      "action": "highlight",
      "target": "purchases.payments.btn.export",
      "title": "Exportar",
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.payments.section.first-row",
      "title": "Abrí un pago",
      "until": "purchases.payments.section.detail-header",
      "autoClick": true
    },
    {
      "id": "header",
      "action": "highlight",
      "target": "purchases.payments.section.detail-header",
      "title": "Detalle",
      "details": "Monto, medio de pago, moneda, factura y fecha."
    },
    {
      "id": "actions",
      "action": "highlight",
      "target": "purchases.payments.section.actions",
      "title": "Acciones",
      "details": "Imprimir el recibo o enviarlo por correo. «Histórico» marca pagos cargados sin caja."
    },
    {
      "id": "credit",
      "action": "highlight",
      "target": "purchases.payments.section.credit-balance",
      "title": "Saldo a favor",
      "details": "Sólo en prepagos: cuánto queda disponible para aplicar a facturas.",
      "skipIfMissing": true
    },
    {
      "id": "alloc",
      "action": "click",
      "target": "purchases.payments.tab.allocations",
      "title": "Asignaciones",
      "details": "A qué facturas se aplicó el prepago.",
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "click",
      "target": "purchases.payments.tab.notes",
      "title": "Notas"
    }
  ]
}
