{
  "id": "config.sedes.edit",
  "title": "Editar la sede",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de una sede existente.",
  "screens": [
    "config.sedes"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar sede",
    "modificar sede",
    "cambiar sede"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/sedes",
      "title": "Menú → Configuración de Negocio → Sedes",
      "details": "Los lugares físicos donde atiende la clínica: cada consultorio, horario y caja pertenece a una sede."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.sedes.filter.search",
      "title": "Buscá la sede",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.sedes.section.first-row",
      "title": "Elegí la sede",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.sedes.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.sedes.btn.edit",
      "title": "Editar",
      "until": "config.sedes.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "config.sedes.field.name",
      "title": "Nombre",
      "details": "Nombre corto que reconoce el equipo (Centro, Pocitos…)."
    },
    {
      "id": "address",
      "action": "highlight",
      "target": "config.sedes.field.address",
      "title": "Dirección",
      "details": "Se usa en recordatorios y en el portal del paciente.",
      "skipIfMissing": true
    },
    {
      "id": "phone",
      "action": "highlight",
      "target": "config.sedes.field.phone",
      "title": "Teléfono",
      "skipIfMissing": true
    },
    {
      "id": "email",
      "action": "highlight",
      "target": "config.sedes.field.email",
      "title": "Correo",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.sedes.field.is_active",
      "title": "Activa",
      "details": "Desmarcada no aparece para agendar ni para elegir.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.sedes.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
