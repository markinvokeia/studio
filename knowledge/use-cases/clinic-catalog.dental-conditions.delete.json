{
  "id": "clinic-catalog.dental-conditions.delete",
  "title": "Eliminar la condición dental",
  "module": "Catálogo de la Clínica",
  "summary": "Borrarlo del catálogo (pide confirmación).",
  "screens": [
    "clinic-catalog.dental-conditions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar condición dental",
    "borrar condición dental"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-conditions",
      "title": "Menú → Catálogo de la Clínica → Condiciones Dentales",
      "details": "Lo que se marca en el odontograma (caries, corona, ausente…), con su color y código visual."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.dental-conditions.filter.search",
      "title": "Buscá la condición dental",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.dental-conditions.section.first-row",
      "title": "Elegí la condición dental",
      "until": "clinic-catalog.dental-conditions.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "clinic-catalog.dental-conditions.btn.delete",
      "title": "Eliminar",
      "until": "clinic-catalog.dental-conditions.btn.delete-confirm"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "clinic-catalog.dental-conditions.btn.delete-confirm",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
