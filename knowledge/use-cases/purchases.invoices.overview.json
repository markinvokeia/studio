{
  "id": "purchases.invoices.overview",
  "title": "Recorrer facturas de compra",
  "module": "Compras",
  "summary": "Listado con filtro por tipo (factura o nota de crédito), detalle con estado, cobro y vencimiento, acciones y pestañas.",
  "screens": [
    "purchases.invoices"
  ],
  "inputs": {
    "query": "Número de factura"
  },
  "keywords": [
    "facturas de compra",
    "facturas de proveedores",
    "deuda con proveedores"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/invoices",
      "title": "Menú → Compras → Facturas de Compra",
      "details": "Lo que la clínica le debe a un proveedor: sale de un presupuesto de compra o se carga/importa directo."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.invoices.filter.search",
      "title": "Buscar",
      "details": "Por número de documento.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "filters",
      "action": "click",
      "target": "purchases.invoices.btn.filters",
      "title": "Filtrar por tipo",
      "details": "Facturas o notas de crédito.",
      "until": "purchases.invoices.section.filters"
    },
    {
      "id": "type",
      "action": "highlight",
      "target": "purchases.invoices.section.filters",
      "title": "Tipo de documento",
      "details": "Todas, sólo facturas o sólo notas de crédito.",
      "doneOnClose": true
    },
    {
      "id": "import",
      "action": "highlight",
      "target": "purchases.invoices.btn.import",
      "title": "Importar",
      "details": "Carga facturas de proveedores desde un archivo.",
      "skipIfMissing": true
    },
    {
      "id": "export",
      "action": "highlight",
      "target": "purchases.invoices.btn.export",
      "title": "Exportar",
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.invoices.section.first-row",
      "title": "Abrí una factura",
      "until": "purchases.invoices.section.summary",
      "autoClick": true
    },
    {
      "id": "summary",
      "action": "highlight",
      "target": "purchases.invoices.section.summary",
      "title": "Resumen",
      "details": "Estado (borrador o confirmada), estado de pago, total, proveedor, presupuesto de origen, vencimiento y fecha."
    },
    {
      "id": "actions",
      "action": "highlight",
      "target": "purchases.invoices.section.actions",
      "title": "Acciones",
      "details": "Borrador: confirmar. Confirmada con saldo: agregar pago. Siempre: imprimir y enviar."
    },
    {
      "id": "items",
      "action": "click",
      "target": "purchases.invoices.tab.items",
      "title": "Artículos"
    },
    {
      "id": "payments",
      "action": "click",
      "target": "purchases.invoices.tab.payments",
      "title": "Pagos",
      "details": "Los pagos aplicados a esta factura."
    },
    {
      "id": "notes",
      "action": "click",
      "target": "purchases.invoices.tab.notes",
      "title": "Notas"
    },
    {
      "id": "credit",
      "action": "click",
      "target": "purchases.invoices.tab.creditNotes",
      "title": "Notas de crédito",
      "details": "Las notas de crédito que descuentan de esta factura.",
      "skipIfMissing": true
    }
  ]
}
