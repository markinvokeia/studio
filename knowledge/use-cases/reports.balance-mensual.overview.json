{
  "id": "reports.balance-mensual.overview",
  "title": "Usar el reporte Balance Mensual",
  "module": "Reportes",
  "summary": "Producido, cobrado y pendiente de cada mes.",
  "screens": [
    "reports.balance-mensual"
  ],
  "keywords": [
    "balance mensual",
    "balance",
    "mes a mes"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/reports/balance-mensual",
      "title": "Menú → Reportes → Balance Mensual",
      "details": "Producido, cobrado y pendiente de cada mes."
    },
    {
      "id": "period",
      "action": "highlight",
      "target": "reports.balance-mensual.filter.period",
      "title": "Período",
      "details": "Hoy, esta semana, este mes, el mes pasado, este año o un rango propio.",
      "skipIfMissing": true
    },
    {
      "id": "currency-filter",
      "action": "highlight",
      "target": "reports.balance-mensual.filter.currency-filter",
      "title": "Moneda",
      "details": "Sólo si la clínica trabaja con dos monedas: todas o una.",
      "skipIfMissing": true
    },
    {
      "id": "filters",
      "action": "highlight",
      "target": "reports.balance-mensual.section.filters",
      "title": "Filtros",
      "details": "Moneda."
    },
    {
      "id": "generate",
      "action": "click",
      "target": "reports.balance-mensual.btn.generate",
      "title": "Generar",
      "details": "Calcula el reporte con los filtros elegidos.",
      "until": [
        "reports.balance-mensual.section.results",
        "reports.balance-mensual.section.empty"
      ]
    },
    {
      "id": "empty",
      "action": "highlight",
      "target": "reports.balance-mensual.section.empty",
      "title": "Sin datos",
      "details": "No hay datos para esos filtros: probá con otro período.",
      "onlyIf": "reports.balance-mensual.section.empty",
      "skipIfMissing": true
    },
    {
      "id": "kpis",
      "action": "highlight",
      "target": "reports.balance-mensual.section.kpi",
      "title": "Indicadores",
      "details": "Producido, cobrado y pendiente.",
      "skipIfMissing": true
    },
    {
      "id": "results",
      "action": "highlight",
      "target": "reports.balance-mensual.section.results",
      "title": "Resultados",
      "details": "Una fila por mes y el detalle.",
      "skipIfMissing": true
    },
    {
      "id": "table",
      "action": "highlight",
      "target": "reports.balance-mensual.section.table",
      "title": "Detalle",
      "details": "Ordená por columna tocando el encabezado.",
      "skipIfMissing": true
    },
    {
      "id": "export",
      "action": "highlight",
      "target": "reports.balance-mensual.btn.export",
      "title": "Exportar",
      "details": "Excel, CSV o PDF con lo que estás viendo.",
      "skipIfMissing": true
    },
    {
      "id": "print",
      "action": "highlight",
      "target": "reports.balance-mensual.btn.print",
      "title": "Imprimir",
      "details": "Con el encabezado de la clínica.",
      "skipIfMissing": true
    }
  ]
}
