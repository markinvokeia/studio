{
  "id": "patients.treatment-plans",
  "title": "Ver los planes de tratamiento",
  "module": "Pacientes",
  "summary": "Clínica → Planes de tratamiento: etapas, avance y citas de cada plan del paciente.",
  "screens": [
    "patients"
  ],
  "group": "Historia clínica",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente"
  },
  "keywords": [
    "plan de tratamiento",
    "etapas",
    "avance del tratamiento",
    "secuencia",
    "tratamiento en curso"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "clinical",
      "action": "click",
      "target": "patients.tab.clinical",
      "title": "Historia clínica",
      "until": "patients.tab.treatment-plans"
    },
    {
      "id": "tab",
      "action": "click",
      "target": "patients.tab.treatment-plans",
      "title": "Planes de tratamiento",
      "until": "patients.section.treatment-plans"
    },
    {
      "id": "plans",
      "action": "highlight",
      "target": "patients.section.treatment-plans",
      "title": "Planes",
      "details": "Activos arriba con sus etapas, citas y sesiones; los finalizados, abajo. Los planes salen de los presupuestos aceptados."
    },
    {
      "id": "historical",
      "action": "highlight",
      "target": "patients.btn.plans-historical",
      "title": "Ver finalizados",
      "skipIfMissing": true
    }
  ]
}
