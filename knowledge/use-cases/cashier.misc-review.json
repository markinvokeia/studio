{
  "id": "cashier.misc-review",
  "title": "Ver, editar o anular un movimiento vario",
  "module": "Caja",
  "summary": "Buscar un movimiento por beneficiario, abrirlo para editarlo o eliminarlo (sólo los de la caja abierta).",
  "screens": [
    "cashier.miscellaneous-transactions"
  ],
  "inputs": {
    "query": "Beneficiario"
  },
  "keywords": [
    "editar movimiento",
    "anular gasto",
    "borrar gasto",
    "buscar gasto",
    "movimientos varios",
    "corregir"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/cashier/miscellaneous-transactions",
      "title": "Menú → Caja → Transacciones Misceláneas",
      "details": "Entradas y salidas de dinero que no son cobros a pacientes: gastos menores, retiros, aportes."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.filter.search",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "title": "Buscar por beneficiario"
    },
    {
      "id": "row",
      "action": "highlight",
      "target": "cashier.miscellaneous-transactions.section.first-row",
      "title": "El movimiento más reciente",
      "details": "En verde los ingresos y en rojo los gastos. Tocá la fila para editarla. Sólo se pueden editar o eliminar los de la sesión de caja abierta.",
      "skipIfMissing": true
    },
    {
      "id": "actions",
      "action": "highlight",
      "target": "cashier.miscellaneous-transactions.btn.row-actions",
      "title": "Acciones",
      "details": "Editar o Eliminar el movimiento.",
      "until": [
        "cashier.miscellaneous-transactions.btn.row-edit"
      ],
      "autoClick": true,
      "skipIfMissing": true
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "cashier.miscellaneous-transactions.btn.row-edit",
      "title": "Editar",
      "details": "Abre el formulario con los datos para corregirlos.",
      "doneOnClose": true,
      "skipIfMissing": true
    }
  ]
}
