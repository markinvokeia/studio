{
  "id": "config.mutual-societies.delete",
  "title": "Eliminar la sociedad mutual",
  "module": "Configuración de Negocio",
  "summary": "Borrar una sociedad mutual (pide confirmación).",
  "screens": [
    "config.mutual-societies"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar sociedad mutual",
    "borrar sociedad mutual",
    "quitar sociedad mutual"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/mutual-societies",
      "title": "Menú → Configuración de Negocio → Sociedades Mutuales",
      "details": "Mutualistas, seguros o convenios a los que pertenecen los pacientes (se elige en la ficha del paciente)."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.mutual-societies.filter.search",
      "title": "Buscá la sociedad mutual",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.mutual-societies.section.first-row",
      "title": "Elegí la sociedad mutual",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.mutual-societies.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "config.mutual-societies.btn.delete",
      "title": "Eliminar",
      "until": "config.mutual-societies.btn.confirm-action"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "config.mutual-societies.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
