{
  "id": "config.holidays.edit",
  "title": "Editar el horario de excepción",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de un horario de excepción existente.",
  "screens": [
    "config.holidays"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar horario de excepción",
    "modificar horario de excepción",
    "cambiar horario de excepción"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/holidays",
      "title": "Menú → Configuración de Negocio → Horarios de Excepción",
      "details": "Feriados, cierres puntuales o recurrentes, o días con horario distinto. Ganan sobre el horario normal."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.holidays.filter.search",
      "title": "Buscá el horario de excepción",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.holidays.section.first-row",
      "title": "Elegí el horario de excepción",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.holidays.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.holidays.btn.edit",
      "title": "Editar",
      "until": "config.holidays.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "recurrence",
      "action": "highlight",
      "target": "config.holidays.field.recurrence",
      "title": "Recurrencia",
      "details": "Una vez, semanal, quincenal o mensual."
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "config.holidays.field.date",
      "title": "Fecha",
      "details": "El día del feriado o cierre.",
      "skipIfMissing": true
    },
    {
      "id": "dates",
      "action": "highlight",
      "target": "config.holidays.field.dates",
      "title": "Fechas",
      "details": "Para una excepción que no se repite, se pueden marcar varios días.",
      "skipIfMissing": true
    },
    {
      "id": "sede_id",
      "action": "highlight",
      "target": "config.holidays.field.sede_id",
      "title": "Sede",
      "details": "Dejá «Todas las sedes» para aplicarla a toda la clínica.",
      "skipIfMissing": true
    },
    {
      "id": "is_open",
      "action": "highlight",
      "target": "config.holidays.field.is_open",
      "title": "¿Está abierto?",
      "details": "Abierto con otro horario, o cerrado.",
      "skipIfMissing": true
    },
    {
      "id": "start_time",
      "action": "highlight",
      "target": "config.holidays.field.start_time",
      "title": "Desde",
      "details": "Dejá ambas horas vacías para cerrar todo el día; con un rango se cierra sólo ese tramo.",
      "skipIfMissing": true
    },
    {
      "id": "end_time",
      "action": "highlight",
      "target": "config.holidays.field.end_time",
      "title": "Hasta",
      "skipIfMissing": true
    },
    {
      "id": "end_date",
      "action": "highlight",
      "target": "config.holidays.field.end_date",
      "title": "Hasta cuándo",
      "details": "Vacío: la recurrencia aplica indefinidamente.",
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "highlight",
      "target": "config.holidays.field.notes",
      "title": "Notas",
      "details": "Motivo (Feriado, inventario…).",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.holidays.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
