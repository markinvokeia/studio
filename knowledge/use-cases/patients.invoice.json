{
  "id": "patients.invoice",
  "title": "Hacer una factura desde la ficha",
  "module": "Pacientes",
  "summary": "Crear → Factura: fecha, vencimiento, moneda, sede y servicios facturados.",
  "screens": [
    "patients"
  ],
  "group": "Finanzas",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente"
  },
  "keywords": [
    "factura",
    "facturar",
    "emitir factura"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "patients.btn.create-menu",
      "title": "Crear",
      "details": "Todo lo que se puede crear para este paciente: clínico, financiero y agenda.",
      "until": "patients.btn.new-invoice"
    },
    {
      "id": "item",
      "action": "click",
      "target": "patients.btn.new-invoice",
      "title": "Factura",
      "details": "Abre la factura con el paciente cargado.",
      "until": "patients.field.currency"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "patients.field.created_at",
      "title": "Fecha",
      "skipIfMissing": true
    },
    {
      "id": "due",
      "action": "highlight",
      "target": "patients.field.due_date",
      "title": "Vencimiento",
      "skipIfMissing": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "patients.field.currency",
      "title": "Moneda"
    },
    {
      "id": "sede",
      "action": "highlight",
      "target": "patients.field.sede_id",
      "title": "Sede",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.submit",
      "title": "Guardar la factura",
      "details": "Queda pendiente de pago en la cuenta del paciente."
    }
  ]
}
