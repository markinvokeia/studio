{
  "id": "config.availability-exceptions.overview",
  "title": "Recorrer Excepciones de Disponibilidad",
  "module": "Configuración de Negocio",
  "summary": "Días puntuales en que un profesional no atiende (licencia, congreso) o atiende fuera de su disponibilidad habitual.",
  "screens": [
    "config.availability-exceptions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "excepciones de disponibilidad",
    "excepción",
    "ver excepción",
    "qué es excepción"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/availability-exceptions",
      "title": "Menú → Configuración de Negocio → Excepciones de Disponibilidad",
      "details": "Días puntuales en que un profesional no atiende (licencia, congreso) o atiende fuera de su disponibilidad habitual."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.availability-exceptions.filter.search",
      "title": "Buscá la excepción",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.availability-exceptions.section.first-row",
      "title": "Elegí la excepción",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.availability-exceptions.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.availability-exceptions.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.availability-exceptions.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.availability-exceptions.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.availability-exceptions.btn.new",
      "title": "Crear",
      "details": "Agrega una nueva excepción.",
      "skipIfMissing": true
    }
  ]
}
