{
  "id": "purchases.services.delete",
  "title": "Eliminar un producto o servicio",
  "module": "Compras",
  "summary": "Borrarlo de la lista (pide confirmación). Si ya se usó, conviene desactivarlo.",
  "screens": [
    "purchases.services"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar producto o servicio",
    "borrar producto o servicio"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/services",
      "title": "Menú → Compras → Productos y Servicios de Proveedores",
      "details": "Lo que la clínica le compra a proveedores, con su precio de referencia: se usa en presupuestos y facturas de compra."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.services.filter.search",
      "title": "Buscá el producto o servicio",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.services.section.first-row",
      "title": "Elegí el producto o servicio",
      "details": "Tocalo para abrir su ficha.",
      "until": "purchases.services.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "purchases.services.btn.delete",
      "title": "Eliminar",
      "until": "purchases.services.btn.delete-confirm"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "purchases.services.btn.delete-confirm",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
