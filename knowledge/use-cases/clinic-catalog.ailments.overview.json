{
  "id": "clinic-catalog.ailments.overview",
  "title": "Recorrer Padecimientos",
  "module": "Catálogo de la Clínica",
  "summary": "Las enfermedades y condiciones que se cargan en la anamnesis; las de nivel de alerta alto aparecen como alerta en la ficha del paciente.",
  "screens": [
    "clinic-catalog.ailments"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "padecimientos",
    "padecimiento",
    "catálogo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/ailments",
      "title": "Menú → Catálogo de la Clínica → Padecimientos",
      "details": "Las enfermedades y condiciones que se cargan en la anamnesis; las de nivel de alerta alto aparecen como alerta en la ficha del paciente."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.ailments.filter.search",
      "title": "Buscá el padecimiento",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.ailments.section.first-row",
      "title": "Elegí el padecimiento",
      "until": "clinic-catalog.ailments.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "clinic-catalog.ailments.section.detail",
      "title": "Detalle"
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "clinic-catalog.ailments.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "clinic-catalog.ailments.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "clinic-catalog.ailments.btn.new",
      "title": "Crear",
      "skipIfMissing": true
    }
  ]
}
