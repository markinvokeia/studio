{
  "id": "system.users.overview",
  "title": "Recorrer Usuarios",
  "module": "Sistema",
  "summary": "Todas las personas que entran al sistema (doctores, secretarias, administración) con sus roles.",
  "screens": [
    "system.users"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "usuarios",
    "usuario",
    "ver usuario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/users",
      "title": "Menú → Sistema → Usuarios",
      "details": "Todas las personas que entran al sistema (doctores, secretarias, administración) con sus roles."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.users.filter.search",
      "title": "Buscá el usuario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.users.section.first-row",
      "title": "Elegí el usuario",
      "until": "system.users.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "system.users.section.detail",
      "title": "Ficha"
    },
    {
      "id": "tab-details",
      "action": "click",
      "target": "system.users.detail.tab.details",
      "title": "Datos",
      "skipIfMissing": true
    },
    {
      "id": "tab-roles",
      "action": "click",
      "target": "system.users.detail.tab.roles",
      "title": "Roles",
      "details": "Qué roles tiene: cada rol suma permisos.",
      "skipIfMissing": true
    },
    {
      "id": "tab-logs",
      "action": "click",
      "target": "system.users.detail.tab.logs",
      "title": "Registros",
      "details": "Lo que hizo en el sistema.",
      "skipIfMissing": true
    },
    {
      "id": "tab-signature",
      "action": "click",
      "target": "system.users.detail.tab.signature",
      "title": "Firma",
      "skipIfMissing": true
    },
    {
      "id": "tab-preferences",
      "action": "click",
      "target": "system.users.detail.tab.preferences",
      "title": "Preferencias",
      "skipIfMissing": true
    }
  ]
}
