{
  "id": "config.schedules.overview",
  "title": "Recorrer Horarios",
  "module": "Configuración de Negocio",
  "summary": "El horario de atención de cada sede, por día. Fuera de este horario la agenda no ofrece turnos.",
  "screens": [
    "config.schedules"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "horarios",
    "horario",
    "ver horario",
    "qué es horario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/schedules",
      "title": "Menú → Configuración de Negocio → Horarios",
      "details": "El horario de atención de cada sede, por día. Fuera de este horario la agenda no ofrece turnos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.schedules.filter.search",
      "title": "Buscá el horario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.schedules.section.first-row",
      "title": "Elegí el horario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.schedules.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.schedules.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.schedules.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.schedules.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.schedules.btn.new",
      "title": "Crear",
      "details": "Agrega un nuevo horario.",
      "skipIfMissing": true
    }
  ]
}
