{
  "id": "clinic-catalog.medications.edit",
  "title": "Editar el medicamento",
  "module": "Catálogo de la Clínica",
  "summary": "Cambiar sus datos.",
  "screens": [
    "clinic-catalog.medications"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar medicamento",
    "modificar medicamento"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/medications",
      "title": "Menú → Catálogo de la Clínica → Medicamentos",
      "details": "Los medicamentos que se usan en recetas y en la medicación habitual del paciente."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.medications.filter.search",
      "title": "Buscá el medicamento",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.medications.section.first-row",
      "title": "Elegí el medicamento",
      "until": "clinic-catalog.medications.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "clinic-catalog.medications.btn.edit",
      "title": "Editar",
      "until": "clinic-catalog.medications.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "nombre_generico",
      "action": "highlight",
      "target": "clinic-catalog.medications.field.nombre_generico",
      "title": "Nombre genérico",
      "skipIfMissing": true
    },
    {
      "id": "nombre_comercial",
      "action": "highlight",
      "target": "clinic-catalog.medications.field.nombre_comercial",
      "title": "Nombre comercial",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.medications.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
