{
  "id": "system.staff.edit",
  "title": "Editar los datos de una persona del equipo",
  "module": "Configuración de Negocio",
  "summary": "Pestaña Datos de la ficha.",
  "screens": [
    "system.staff"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar persona del equipo",
    "cambiar correo",
    "cambiar rol"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/staff",
      "title": "Menú → Configuración de Negocio → Secretarias y Administración"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.staff.filter.search",
      "title": "Buscá",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.staff.section.first-row",
      "title": "Elegí al persona del equipo",
      "until": "system.staff.section.detail",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "system.staff.detail.tab.details",
      "title": "Datos",
      "until": "system.staff.detail.field.name"
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "system.staff.detail.field.name",
      "title": "Nombre"
    },
    {
      "id": "email",
      "action": "highlight",
      "target": "system.staff.detail.field.email",
      "title": "Correo"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.staff.detail.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
