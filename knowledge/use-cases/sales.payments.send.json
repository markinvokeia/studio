{
  "id": "sales.payments.send",
  "title": "Imprimir o enviar un recibo",
  "module": "Ventas",
  "summary": "Imprimir el recibo de un pago o mandarlo por correo en PDF.",
  "screens": [
    "sales.payments"
  ],
  "inputs": {
    "query": "Número de pago"
  },
  "keywords": [
    "recibo",
    "imprimir recibo",
    "enviar recibo",
    "comprobante de pago"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/payments",
      "title": "Menú → Ventas → Pagos",
      "details": "Los cobros a pacientes: pagos de facturas y prepagos (dinero a cuenta que después se aplica a facturas)."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.payments.filter.search",
      "title": "Buscá el pago",
      "details": "Por número de documento.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.payments.section.first-row",
      "title": "Abrí el pago",
      "details": "Tocalo en la lista. La guía sigue cuando se abre su detalle.",
      "until": "sales.payments.section.detail-header",
      "autoClick": true
    },
    {
      "id": "print",
      "action": "highlight",
      "target": "sales.payments.btn.print",
      "title": "Imprimir recibo"
    },
    {
      "id": "email",
      "action": "click",
      "target": "sales.payments.btn.email",
      "title": "Enviar por correo",
      "until": "sales.payments.field.doc-email-to"
    },
    {
      "id": "to",
      "action": "highlight",
      "target": "sales.payments.field.doc-email-to",
      "title": "Destinatarios"
    },
    {
      "id": "send",
      "action": "confirm",
      "target": "sales.payments.btn.doc-email-send",
      "title": "Enviar"
    }
  ]
}
