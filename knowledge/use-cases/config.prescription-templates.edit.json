{
  "id": "config.prescription-templates.edit",
  "title": "Editar la plantilla de receta",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de una plantilla de receta existente.",
  "screens": [
    "config.prescription-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar plantilla de receta",
    "modificar plantilla de receta",
    "cambiar plantilla de receta"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/prescription-templates",
      "title": "Menú → Configuración de Negocio → Plantillas de Receta",
      "details": "Recetas habituales con medicamentos e indicaciones; se eligen al recetar."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.prescription-templates.filter.search",
      "title": "Buscá la plantilla de receta",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.prescription-templates.section.first-row",
      "title": "Elegí la plantilla de receta",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.prescription-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.prescription-templates.btn.edit",
      "title": "Editar",
      "until": "config.prescription-templates.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "config.prescription-templates.field.name",
      "title": "Nombre"
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "config.prescription-templates.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "content_html",
      "action": "highlight",
      "target": "config.prescription-templates.field.content_html",
      "title": "Contenido"
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.prescription-templates.field.is_active",
      "title": "Activa",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.prescription-templates.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
