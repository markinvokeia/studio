{
  "id": "config.schedules.delete",
  "title": "Eliminar el horario",
  "module": "Configuración de Negocio",
  "summary": "Borrar un horario (pide confirmación).",
  "screens": [
    "config.schedules"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar horario",
    "borrar horario",
    "quitar horario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/schedules",
      "title": "Menú → Configuración de Negocio → Horarios",
      "details": "El horario de atención de cada sede, por día. Fuera de este horario la agenda no ofrece turnos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.schedules.filter.search",
      "title": "Buscá el horario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.schedules.section.first-row",
      "title": "Elegí el horario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.schedules.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "config.schedules.btn.delete",
      "title": "Eliminar",
      "until": "config.schedules.btn.confirm-action"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "config.schedules.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
