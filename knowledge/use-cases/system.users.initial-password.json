{
  "id": "system.users.initial-password",
  "title": "Enviar la contraseña inicial a un usuario",
  "module": "Sistema",
  "summary": "Le manda por correo una contraseña para su primer ingreso.",
  "screens": [
    "system.users"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "contraseña",
    "no puede entrar",
    "acceso",
    "clave"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/users",
      "title": "Menú → Sistema → Usuarios"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.users.filter.search",
      "title": "Buscá el usuario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.users.section.first-row",
      "title": "Elegí el usuario",
      "until": "system.users.section.detail",
      "autoClick": true
    },
    {
      "id": "pw",
      "action": "confirm",
      "target": "system.users.btn.initial-password",
      "title": "Enviar contraseña inicial",
      "details": "Se envía al tocarlo. Sólo aparece si tenés permiso para gestionar contraseñas.",
      "skipIfMissing": true
    }
  ]
}
