{
  "id": "patients.edit",
  "title": "Editar los datos de un paciente",
  "module": "Pacientes",
  "summary": "Cambiar nombre, contacto, documento, mutualista, doctor por defecto o responsable desde Información → Datos.",
  "screens": [
    "patients"
  ],
  "group": "Información",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente",
    "phone": "Teléfono nuevo",
    "email": "Correo nuevo"
  },
  "keywords": [
    "editar paciente",
    "modificar paciente",
    "cambiar teléfono",
    "cambiar correo",
    "actualizar datos",
    "corregir paciente"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "info",
      "action": "click",
      "target": "patients.tab.info",
      "title": "Información",
      "skipIfMissing": true
    },
    {
      "id": "details",
      "action": "click",
      "target": "patients.tab.details",
      "title": "Datos",
      "details": "El formulario con todos los datos del paciente.",
      "skipIfMissing": true,
      "until": "patients.field.name"
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "patients.field.name",
      "title": "Nombre y apellido"
    },
    {
      "id": "phone",
      "action": "fill",
      "target": "patients.field.phone",
      "title": "Teléfono",
      "details": "Con código de país; es el número de los recordatorios.",
      "value": "{{values.phone}}",
      "optional": true
    },
    {
      "id": "email",
      "action": "fill",
      "target": "patients.field.email",
      "title": "Correo",
      "value": "{{values.email}}",
      "optional": true
    },
    {
      "id": "address",
      "action": "highlight",
      "target": "patients.field.address",
      "title": "Dirección",
      "skipIfMissing": true
    },
    {
      "id": "responsible",
      "action": "highlight",
      "target": "patients.field.responsible_contact_id",
      "title": "Contacto responsable",
      "details": "Sólo si es dependiente: a quién se le envían los avisos.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.submit",
      "title": "Guardar cambios",
      "details": "Guarda los datos. Si el correo o teléfono ya es de otro paciente, te avisa antes."
    }
  ]
}
