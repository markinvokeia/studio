{
  "id": "sales.services.create",
  "title": "Crear un servicio",
  "module": "Ventas",
  "summary": "Alta de un servicio con precio y moneda.",
  "screens": [
    "sales.services"
  ],
  "inputs": {
    "name": "Nombre",
    "price": "Precio",
    "duration_minutes": "Duración"
  },
  "keywords": [
    "nuevo servicio",
    "crear servicio",
    "agregar a la lista de precios"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/services",
      "title": "Menú → Ventas → Servicios",
      "details": "Lo que la clínica ofrece y cobra: precio, moneda, duración en la agenda, color, categoría y si se reserva en línea. Es la lista de precios de presupuestos, facturas y citas."
    },
    {
      "id": "new",
      "action": "click",
      "target": "sales.services.btn.new",
      "title": "Crear",
      "until": "sales.services.field.name"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "sales.services.field.name",
      "title": "Nombre",
      "details": "Como aparece en citas, presupuestos y facturas.",
      "value": "{{values.name}}",
      "optional": false
    },
    {
      "id": "service_type",
      "action": "highlight",
      "target": "sales.services.field.service_type",
      "title": "Tipo",
      "details": "Simple o por etapas (tratamiento con varias sesiones: abre la pestaña Etapas).",
      "skipIfMissing": true
    },
    {
      "id": "category_id",
      "action": "highlight",
      "target": "sales.services.field.category_id",
      "title": "Categoría",
      "details": "Agrupa servicios en reportes y en el portal.",
      "skipIfMissing": true
    },
    {
      "id": "price",
      "action": "fill",
      "target": "sales.services.field.price",
      "title": "Precio",
      "value": "{{values.price}}",
      "optional": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "sales.services.field.currency",
      "title": "Moneda",
      "skipIfMissing": true
    },
    {
      "id": "duration_minutes",
      "action": "fill",
      "target": "sales.services.field.duration_minutes",
      "title": "Duración",
      "details": "Minutos que ocupa en la agenda.",
      "value": "{{values.duration_minutes}}",
      "optional": true
    },
    {
      "id": "color",
      "action": "highlight",
      "target": "sales.services.field.color",
      "title": "Color",
      "details": "Color de la cita en la agenda.",
      "skipIfMissing": true
    },
    {
      "id": "bookable_online",
      "action": "highlight",
      "target": "sales.services.field.bookable_online",
      "title": "Reservable en línea",
      "details": "Aparece en el portal del paciente.",
      "skipIfMissing": true
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "sales.services.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "indications",
      "action": "highlight",
      "target": "sales.services.field.indications",
      "title": "Indicaciones",
      "details": "Lo que se le avisa al paciente antes de la cita.",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "sales.services.field.is_active",
      "title": "Activo",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "sales.services.btn.submit",
      "title": "Guardar"
    }
  ]
}
