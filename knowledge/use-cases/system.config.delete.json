{
  "id": "system.config.delete",
  "title": "Eliminar la configuración",
  "module": "Sistema",
  "summary": "Borrar (pide confirmación).",
  "screens": [
    "system.config"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar configuración",
    "borrar configuración"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/config",
      "title": "Menú → Sistema → Configuraciones",
      "details": "Parámetros técnicos del sistema (clave y valor). Cambiarlos afecta el funcionamiento: hacelo sólo si sabés qué controla cada clave."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.config.filter.search",
      "title": "Buscá la configuración",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.config.section.first-row",
      "title": "Elegí la configuración",
      "until": "system.config.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "system.config.btn.delete",
      "title": "Eliminar",
      "until": "system.config.btn.confirm-action",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "system.config.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer.",
      "skipIfMissing": true
    }
  ]
}
