{
  "id": "system.staff.initial-password",
  "title": "Enviar la contraseña inicial",
  "module": "Configuración de Negocio",
  "summary": "Le manda por correo una contraseña para su primer ingreso.",
  "screens": [
    "system.staff"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "contraseña",
    "acceso",
    "no puede entrar",
    "enviar clave"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/staff",
      "title": "Menú → Configuración de Negocio → Secretarias y Administración"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.staff.filter.search",
      "title": "Buscá",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.staff.section.first-row",
      "title": "Elegí al persona del equipo",
      "until": "system.staff.section.detail",
      "autoClick": true
    },
    {
      "id": "pw",
      "action": "confirm",
      "target": "system.staff.btn.initial-password",
      "title": "Enviar contraseña inicial",
      "details": "Se envía al tocarlo al correo de su ficha."
    }
  ]
}
