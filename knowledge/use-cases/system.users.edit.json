{
  "id": "system.users.edit",
  "title": "Editar un usuario",
  "module": "Sistema",
  "summary": "Pestaña Datos de la ficha.",
  "screens": [
    "system.users"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar usuario",
    "modificar usuario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/users",
      "title": "Menú → Sistema → Usuarios",
      "details": "Todas las personas que entran al sistema (doctores, secretarias, administración) con sus roles."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.users.filter.search",
      "title": "Buscá el usuario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.users.section.first-row",
      "title": "Elegí el usuario",
      "until": "system.users.section.detail",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "system.users.detail.tab.details",
      "title": "Datos",
      "until": "system.users.detail.field.name",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "system.users.detail.field.name",
      "title": "Nombre"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.users.detail.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
