{
  "id": "sales.payment-methods.delete",
  "title": "Eliminar un método de pago",
  "module": "Ventas",
  "summary": "Borrarlo (pide confirmación). Si ya tiene pagos, conviene desactivarlo.",
  "screens": [
    "sales.payment-methods"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar método de pago",
    "borrar método de pago"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/payment-methods",
      "title": "Menú → Ventas → Métodos de Pago",
      "details": "Efectivo, tarjetas, transferencias… con los que se cobra y paga. Los equivalentes a efectivo suman al arqueo de caja."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.payment-methods.filter.search",
      "title": "Buscá el método",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.payment-methods.section.first-row",
      "title": "Elegí el método",
      "until": "sales.payment-methods.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "sales.payment-methods.btn.delete",
      "title": "Eliminar",
      "until": "sales.payment-methods.btn.delete-confirm"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "sales.payment-methods.btn.delete-confirm",
      "title": "Confirmar"
    }
  ]
}
