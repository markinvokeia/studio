{
  "id": "system.execution-history.overview",
  "title": "Consultar Ejecuciones de Alertas",
  "module": "Sistema",
  "summary": "Cada corrida del generador de alertas: cuándo, cuánto tardó, cuántas alertas creó y si falló.",
  "screens": [
    "system.execution-history"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "ejecuciones",
    "generador de alertas",
    "corridas"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/execution-history",
      "title": "Menú → Sistema → Ejecuciones de Alertas",
      "details": "Cada corrida del generador de alertas: cuándo, cuánto tardó, cuántas alertas creó y si falló."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.execution-history.filter.search",
      "title": "Buscar",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.execution-history.section.first-row",
      "title": "El más reciente",
      "details": "Tocalo para ver el detalle.",
      "until": "system.execution-history.section.detail",
      "autoClick": true,
      "skipIfMissing": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "system.execution-history.section.detail",
      "title": "Detalle",
      "skipIfMissing": true
    }
  ]
}
