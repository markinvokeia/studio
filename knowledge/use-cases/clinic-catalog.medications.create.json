{
  "id": "clinic-catalog.medications.create",
  "title": "Agregar un medicamento",
  "module": "Catálogo de la Clínica",
  "summary": "Alta en el catálogo de medicamentos.",
  "screens": [
    "clinic-catalog.medications"
  ],
  "inputs": {
    "name": "Nombre"
  },
  "keywords": [
    "nuevo medicamento",
    "agregar medicamento"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/medications",
      "title": "Menú → Catálogo de la Clínica → Medicamentos",
      "details": "Los medicamentos que se usan en recetas y en la medicación habitual del paciente."
    },
    {
      "id": "new",
      "action": "click",
      "target": "clinic-catalog.medications.btn.new",
      "title": "Crear",
      "until": "clinic-catalog.medications.field.nombre_generico"
    },
    {
      "id": "nombre_generico",
      "action": "fill",
      "target": "clinic-catalog.medications.field.nombre_generico",
      "title": "Nombre genérico",
      "value": "{{values.name}}"
    },
    {
      "id": "nombre_comercial",
      "action": "highlight",
      "target": "clinic-catalog.medications.field.nombre_comercial",
      "title": "Nombre comercial",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.medications.btn.submit",
      "title": "Guardar"
    }
  ]
}
