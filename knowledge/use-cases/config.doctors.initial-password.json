{
  "id": "config.doctors.initial-password",
  "title": "Enviar la contraseña inicial",
  "module": "Configuración de Negocio",
  "summary": "Le manda por correo una contraseña para su primer ingreso.",
  "screens": [
    "config.doctors"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "contraseña",
    "acceso",
    "no puede entrar",
    "enviar clave"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctors",
      "title": "Menú → Configuración de Negocio → Doctores"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.doctors.filter.search",
      "title": "Buscá",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.doctors.section.first-row",
      "title": "Elegí al profesional",
      "until": "config.doctors.section.detail",
      "autoClick": true
    },
    {
      "id": "pw",
      "action": "confirm",
      "target": "config.doctors.btn.initial-password",
      "title": "Enviar contraseña inicial",
      "details": "Se envía al tocarlo al correo de su ficha."
    }
  ]
}
