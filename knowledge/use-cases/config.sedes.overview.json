{
  "id": "config.sedes.overview",
  "title": "Recorrer Sedes",
  "module": "Configuración de Negocio",
  "summary": "Los lugares físicos donde atiende la clínica: cada consultorio, horario y caja pertenece a una sede.",
  "screens": [
    "config.sedes"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "sedes",
    "sede",
    "ver sede",
    "qué es sede"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/sedes",
      "title": "Menú → Configuración de Negocio → Sedes",
      "details": "Los lugares físicos donde atiende la clínica: cada consultorio, horario y caja pertenece a una sede."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.sedes.filter.search",
      "title": "Buscá la sede",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.sedes.section.first-row",
      "title": "Elegí la sede",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.sedes.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.sedes.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.sedes.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.sedes.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.sedes.btn.new",
      "title": "Crear",
      "details": "Agrega una nueva sede.",
      "skipIfMissing": true
    }
  ]
}
