{
  "id": "clinic-catalog.medications.delete",
  "title": "Eliminar el medicamento",
  "module": "Catálogo de la Clínica",
  "summary": "Borrarlo del catálogo (pide confirmación).",
  "screens": [
    "clinic-catalog.medications"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar medicamento",
    "borrar medicamento"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/medications",
      "title": "Menú → Catálogo de la Clínica → Medicamentos",
      "details": "Los medicamentos que se usan en recetas y en la medicación habitual del paciente."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.medications.filter.search",
      "title": "Buscá el medicamento",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.medications.section.first-row",
      "title": "Elegí el medicamento",
      "until": "clinic-catalog.medications.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "clinic-catalog.medications.btn.delete",
      "title": "Eliminar",
      "until": "clinic-catalog.medications.btn.delete-confirm"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "clinic-catalog.medications.btn.delete-confirm",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
