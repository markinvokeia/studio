{
  "id": "purchases.quotes.delete",
  "title": "Eliminar un presupuesto en borrador",
  "module": "Compras",
  "summary": "Borrar un presupuesto que no se confirmó (los confirmados no se eliminan).",
  "screens": [
    "purchases.quotes"
  ],
  "inputs": {
    "query": "Número o proveedor"
  },
  "keywords": [
    "eliminar presupuesto",
    "borrar presupuesto",
    "anular presupuesto"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/quotes",
      "title": "Menú → Compras → Presupuestos de Compra",
      "details": "La cotización de un proveedor: qué productos o servicios, a qué precio. Confirmada, se factura al recibirla."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.quotes.filter.search",
      "title": "Buscá el presupuesto",
      "details": "Por número o por proveedor.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.quotes.section.first-row",
      "title": "Abrí el presupuesto",
      "details": "Tocá el presupuesto en la lista. La guía sigue cuando se abre su detalle.",
      "until": "purchases.quotes.section.detail-header",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "purchases.quotes.btn.delete",
      "title": "Eliminar",
      "details": "Sólo en borradores.",
      "until": "purchases.quotes.btn.delete-confirm",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "purchases.quotes.btn.delete-confirm",
      "title": "Confirmar eliminación",
      "details": "No se puede deshacer.",
      "skipIfMissing": true
    }
  ]
}
