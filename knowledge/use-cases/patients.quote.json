{
  "id": "patients.quote",
  "title": "Hacer un presupuesto desde la ficha",
  "module": "Pacientes",
  "summary": "Crear → Presupuesto: fecha, moneda, doctor, sede y servicios del presupuesto.",
  "screens": [
    "patients"
  ],
  "group": "Finanzas",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente",
    "notes": "Notas del presupuesto",
    "service": "Servicio o producto",
    "quantity": "Cantidad"
  },
  "keywords": [
    "presupuesto",
    "cotización",
    "presupuestar",
    "plan de costos"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "patients.btn.create-menu",
      "title": "Crear",
      "details": "Todo lo que se puede crear para este paciente: clínico, financiero y agenda.",
      "until": "patients.btn.new-quote"
    },
    {
      "id": "item",
      "action": "click",
      "target": "patients.btn.new-quote",
      "title": "Presupuesto",
      "details": "Abre el presupuesto con el paciente cargado.",
      "until": "patients.field.currency"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "patients.field.created_at",
      "title": "Fecha",
      "skipIfMissing": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "patients.field.currency",
      "title": "Moneda"
    },
    {
      "id": "doctor",
      "action": "highlight",
      "target": "patients.field.doctor_id",
      "title": "Doctor",
      "skipIfMissing": true
    },
    {
      "id": "sede",
      "action": "highlight",
      "target": "patients.field.sede_id",
      "title": "Sede",
      "skipIfMissing": true
    },
    {
      "id": "add-item",
      "action": "click",
      "target": "patients.btn.add-item",
      "title": "Agregar artículo",
      "details": "Suma una línea a el presupuesto; sin al menos una no se puede guardar.",
      "until": "patients.field.items.service_id"
    },
    {
      "id": "service",
      "action": "fill",
      "target": "patients.field.items.service_id",
      "title": "Servicio",
      "details": "Elegí el servicio o producto; el precio unitario se completa solo desde el catálogo.",
      "value": "{{values.service}}",
      "ask": true
    },
    {
      "id": "qty",
      "action": "fill",
      "target": "patients.field.items.quantity",
      "title": "Cantidad",
      "details": "El total de la línea se recalcula con la cantidad.",
      "value": "{{values.quantity}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "fill",
      "target": "patients.field.notes",
      "title": "Notas",
      "value": "{{values.notes}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.submit",
      "title": "Guardar el presupuesto",
      "details": "Agregá los servicios y guardá. Aceptado, genera el plan de tratamiento."
    }
  ]
}
