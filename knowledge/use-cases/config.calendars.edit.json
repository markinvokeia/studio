{
  "id": "config.calendars.edit",
  "title": "Editar el calendario",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de un calendario existente.",
  "screens": [
    "config.calendars"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar calendario",
    "modificar calendario",
    "cambiar calendario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/calendars",
      "title": "Menú → Configuración de Negocio → Calendarios",
      "details": "Los consultorios o sillones: cada uno es una columna de la agenda, con su sede, color y quién atiende ahí."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.calendars.filter.search",
      "title": "Buscá el calendario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.calendars.section.first-row",
      "title": "Elegí el calendario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.calendars.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.calendars.btn.edit",
      "title": "Editar",
      "until": "config.calendars.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "config.calendars.field.name",
      "title": "Nombre",
      "details": "Consultorio 1, Sillón A…"
    },
    {
      "id": "sede_id",
      "action": "highlight",
      "target": "config.calendars.field.sede_id",
      "title": "Sede",
      "details": "Sede donde está."
    },
    {
      "id": "color",
      "action": "highlight",
      "target": "config.calendars.field.color",
      "title": "Color",
      "details": "Color con que se ve en la agenda.",
      "skipIfMissing": true
    },
    {
      "id": "google_calendar_id",
      "action": "highlight",
      "target": "config.calendars.field.google_calendar_id",
      "title": "Google Calendar",
      "details": "Opcional: para sincronizar con un Google Calendar.",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.calendars.field.is_active",
      "title": "Activo",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.calendars.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
