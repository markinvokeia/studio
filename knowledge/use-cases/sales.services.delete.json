{
  "id": "sales.services.delete",
  "title": "Eliminar un servicio",
  "module": "Ventas",
  "summary": "Borrarlo de la lista (pide confirmación). Si ya se usó, conviene desactivarlo.",
  "screens": [
    "sales.services"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar servicio",
    "borrar servicio"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/services",
      "title": "Menú → Ventas → Servicios",
      "details": "Lo que la clínica ofrece y cobra: precio, moneda, duración en la agenda, color, categoría y si se reserva en línea. Es la lista de precios de presupuestos, facturas y citas."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.services.filter.search",
      "title": "Buscá el servicio",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.services.section.first-row",
      "title": "Elegí el servicio",
      "details": "Tocalo para abrir su ficha.",
      "until": "sales.services.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "sales.services.btn.delete",
      "title": "Eliminar",
      "until": "sales.services.btn.delete-confirm"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "sales.services.btn.delete-confirm",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
