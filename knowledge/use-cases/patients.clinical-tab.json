{
  "id": "patients.clinical-tab",
  "title": "Recorrer la pestaña Historia clínica",
  "module": "Pacientes",
  "summary": "Anamnesis, línea de tiempo, planes de tratamiento, indicaciones y recetas, y documentos.",
  "screens": [
    "patients"
  ],
  "group": "Historia clínica",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente"
  },
  "keywords": [
    "pestaña historia clínica",
    "qué hay en la historia clínica",
    "recorrer historia clínica"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "patients.tab.clinical",
      "title": "Historia clínica",
      "until": "patients.tab.anamnesis"
    },
    {
      "id": "anamnesis",
      "action": "click",
      "target": "patients.tab.anamnesis",
      "title": "Anamnesis",
      "details": "Antecedentes, medicación, alergias y hábitos.",
      "until": "patients.section.anamnesis-personal"
    },
    {
      "id": "anamnesis-body",
      "action": "highlight",
      "target": "patients.section.anamnesis-allergies",
      "title": "Alergias",
      "details": "Lo que se carga acá aparece como alerta en la ficha."
    },
    {
      "id": "history",
      "action": "click",
      "target": "patients.tab.clinical-history",
      "title": "Línea de tiempo",
      "details": "Sesiones, odontogramas y citas.",
      "until": "patients.section.timeline"
    },
    {
      "id": "history-body",
      "action": "highlight",
      "target": "patients.section.timeline",
      "title": "Eventos",
      "details": "Tocá un evento para verlo; «+» agrega una sesión."
    },
    {
      "id": "plans",
      "action": "click",
      "target": "patients.tab.treatment-plans",
      "title": "Planes de tratamiento",
      "until": "patients.section.treatment-plans"
    },
    {
      "id": "plans-body",
      "action": "highlight",
      "target": "patients.section.treatment-plans",
      "title": "Planes",
      "details": "Etapas, citas y avance de cada plan."
    },
    {
      "id": "indications",
      "action": "click",
      "target": "patients.tab.medical-instructions",
      "title": "Indicaciones",
      "details": "Indicaciones médicas y recetas, cada una en su sub-pestaña."
    },
    {
      "id": "instructions",
      "action": "highlight",
      "target": "patients.btn.mi-new",
      "title": "Nueva indicación",
      "skipIfMissing": true
    },
    {
      "id": "prescriptions",
      "action": "click",
      "target": "patients.tab.prescriptions",
      "title": "Recetas",
      "skipIfMissing": true,
      "until": "patients.btn.rx-new"
    },
    {
      "id": "rx",
      "action": "highlight",
      "target": "patients.btn.rx-new",
      "title": "Nueva receta",
      "skipIfMissing": true
    },
    {
      "id": "documents",
      "action": "click",
      "target": "patients.tab.documents",
      "title": "Documentos",
      "skipIfMissing": true,
      "until": "patients.section.documents"
    },
    {
      "id": "documents-body",
      "action": "highlight",
      "target": "patients.section.documents",
      "title": "Documentos",
      "details": "Archivos subidos y adjuntos de las sesiones.",
      "skipIfMissing": true
    }
  ]
}
