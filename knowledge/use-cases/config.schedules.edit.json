{
  "id": "config.schedules.edit",
  "title": "Editar el horario",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de un horario existente.",
  "screens": [
    "config.schedules"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar horario",
    "modificar horario",
    "cambiar horario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/schedules",
      "title": "Menú → Configuración de Negocio → Horarios",
      "details": "El horario de atención de cada sede, por día. Fuera de este horario la agenda no ofrece turnos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.schedules.filter.search",
      "title": "Buscá el horario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.schedules.section.first-row",
      "title": "Elegí el horario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.schedules.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.schedules.btn.edit",
      "title": "Editar",
      "until": "config.schedules.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "days_of_week",
      "action": "highlight",
      "target": "config.schedules.field.day_of_week",
      "title": "Día",
      "details": "Al editar se cambia de a un día."
    },
    {
      "id": "start_time",
      "action": "highlight",
      "target": "config.schedules.field.start_time",
      "title": "Desde",
      "details": "Hora de apertura."
    },
    {
      "id": "end_time",
      "action": "highlight",
      "target": "config.schedules.field.end_time",
      "title": "Hasta",
      "details": "Hora de cierre."
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.schedules.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
