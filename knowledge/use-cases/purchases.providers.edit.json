{
  "id": "purchases.providers.edit",
  "title": "Editar los datos de un proveedor",
  "module": "Compras",
  "summary": "Pestaña Información de la ficha.",
  "screens": [
    "purchases.providers"
  ],
  "group": "Información",
  "inputs": {
    "query": "Nombre, correo o RUT",
    "identity_document": "Documento (sólo números, hasta 10)"
  },
  "keywords": [
    "editar proveedor",
    "cambiar datos del proveedor",
    "cuenta bancaria del proveedor"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/providers",
      "title": "Menú → Compras → Proveedores",
      "details": "Laboratorios, depósitos y servicios a los que la clínica les compra; con su cuenta: presupuestos, facturas y pagos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.providers.filter.search",
      "title": "Buscá el proveedor",
      "details": "Por nombre, correo o RUT.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.providers.section.first-row",
      "title": "Abrí su ficha",
      "until": "purchases.providers.section.detail",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "purchases.providers.tab.info",
      "title": "Información",
      "until": "purchases.providers.detail.field.name"
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "purchases.providers.detail.field.name",
      "title": "Nombre"
    },
    {
      "id": "email",
      "action": "highlight",
      "target": "purchases.providers.detail.field.email",
      "title": "Correo"
    },
    {
      "id": "doc",
      "action": "fill",
      "target": "purchases.providers.detail.field.identity_document",
      "title": "RUT",
      "value": "{{values.identity_document}}",
      "details": "Obligatorio: sólo números, hasta 10 dígitos."
    },
    {
      "id": "bank",
      "action": "highlight",
      "target": "purchases.providers.detail.field.bank_account",
      "title": "Cuenta bancaria",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.providers.detail.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
