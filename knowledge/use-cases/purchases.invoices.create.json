{
  "id": "purchases.invoices.create",
  "title": "Crear una factura de compra",
  "module": "Compras",
  "summary": "Factura directa (sin presupuesto): proveedor, fechas, moneda, sede e ítems. Queda en borrador.",
  "screens": [
    "purchases.invoices"
  ],
  "inputs": {
    "party": "Proveedor",
    "service": "Servicio o producto",
    "quantity": "Cantidad"
  },
  "keywords": [
    "cargar factura de proveedor",
    "nueva factura de compra"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/invoices",
      "title": "Menú → Compras → Facturas de Compra",
      "details": "Lo que la clínica le debe a un proveedor: sale de un presupuesto de compra o se carga/importa directo."
    },
    {
      "id": "new",
      "action": "click",
      "target": "purchases.invoices.btn.new",
      "title": "Crear",
      "until": "purchases.invoices.field.user_id"
    },
    {
      "id": "party",
      "action": "fill",
      "target": "purchases.invoices.field.user_id",
      "title": "Proveedor",
      "value": "{{values.party}}"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "purchases.invoices.field.created_at",
      "title": "Fecha",
      "skipIfMissing": true
    },
    {
      "id": "due",
      "action": "highlight",
      "target": "purchases.invoices.field.due_date",
      "title": "Vencimiento",
      "details": "Después de esta fecha la deuda figura como vencida.",
      "skipIfMissing": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "purchases.invoices.field.currency",
      "title": "Moneda"
    },
    {
      "id": "sede",
      "action": "highlight",
      "target": "purchases.invoices.field.sede_id",
      "title": "Sede",
      "skipIfMissing": true
    },
    {
      "id": "service",
      "action": "fill",
      "target": "purchases.invoices.field.items.service_id",
      "title": "Producto o servicio",
      "value": "{{values.service}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "qty",
      "action": "fill",
      "target": "purchases.invoices.field.items.quantity",
      "title": "Cantidad",
      "value": "{{values.quantity}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "historical",
      "action": "highlight",
      "target": "purchases.invoices.field.is_historical",
      "title": "Histórico",
      "details": "Para cargar facturas viejas sin que afecten la caja de hoy.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.invoices.btn.submit",
      "title": "Guardar",
      "details": "Queda en borrador; confirmala para poder pagarla."
    }
  ]
}
