{
  "id": "config.doctor-availability.overview",
  "title": "Recorrer Disponibilidad Médica",
  "module": "Configuración de Negocio",
  "summary": "Cuándo atiende cada profesional: días y horas, desde y hasta cuándo. La agenda sólo ofrece turnos dentro de esta disponibilidad.",
  "screens": [
    "config.doctor-availability"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "disponibilidad médica",
    "regla de disponibilidad",
    "ver regla de disponibilidad",
    "qué es regla de disponibilidad"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctor-availability",
      "title": "Menú → Configuración de Negocio → Disponibilidad Médica",
      "details": "Cuándo atiende cada profesional: días y horas, desde y hasta cuándo. La agenda sólo ofrece turnos dentro de esta disponibilidad."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.doctor-availability.filter.search",
      "title": "Buscá la regla de disponibilidad",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.doctor-availability.section.first-row",
      "title": "Elegí la regla de disponibilidad",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.doctor-availability.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.doctor-availability.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.doctor-availability.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.doctor-availability.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.doctor-availability.btn.new",
      "title": "Crear",
      "details": "Agrega una nueva regla de disponibilidad.",
      "skipIfMissing": true
    }
  ]
}
