{
  "id": "sales.payments.prepaid",
  "title": "Registrar un prepago",
  "module": "Ventas",
  "summary": "Pago a cuenta sin factura; queda como saldo para aplicar después.",
  "screens": [
    "sales.payments"
  ],
  "inputs": {
    "party": "Paciente",
    "amount": "Monto",
    "notes": "Notas",
    "payment_method": "Medio de pago (ej. Efectivo)"
  },
  "keywords": [
    "prepago",
    "seña",
    "pago a cuenta",
    "anticipo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/payments",
      "title": "Menú → Ventas → Pagos",
      "details": "Los cobros a pacientes: pagos de facturas y prepagos (dinero a cuenta que después se aplica a facturas)."
    },
    {
      "id": "new",
      "action": "click",
      "target": "sales.payments.btn.new",
      "title": "Crear prepago",
      "details": "Dinero que el paciente deja a cuenta; después se aplica a facturas.",
      "until": "sales.payments.field.payment_amount"
    },
    {
      "id": "party",
      "action": "fill",
      "target": "sales.payments.field.user_id",
      "title": "Paciente",
      "value": "{{values.party}}"
    },
    {
      "id": "amount",
      "action": "fill",
      "target": "sales.payments.field.payment_amount",
      "title": "Monto",
      "value": "{{values.amount}}",
      "optional": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "sales.payments.field.currency",
      "title": "Moneda"
    },
    {
      "id": "method",
      "action": "fill",
      "target": "sales.payments.field.payment_method_id",
      "title": "Medio de pago",
      "details": "Obligatorio. Efectivo suma al arqueo de la caja abierta.",
      "value": "{{values.payment_method}}"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "sales.payments.field.created_at",
      "title": "Fecha",
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "fill",
      "target": "sales.payments.field.notes",
      "title": "Notas",
      "value": "{{values.notes}}",
      "optional": true
    },
    {
      "id": "historical",
      "action": "highlight",
      "target": "sales.payments.field.is_historical",
      "title": "Histórico",
      "details": "Para registrar pagos viejos sin caja abierta.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "sales.payments.btn.submit",
      "title": "Guardar",
      "details": "Pide una confirmación más antes de registrarlo."
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "sales.payments.btn.prepaid-confirm",
      "title": "Confirmar prepago",
      "details": "Queda como saldo a favor del paciente. Necesita la caja abierta.",
      "skipIfMissing": true
    }
  ]
}
