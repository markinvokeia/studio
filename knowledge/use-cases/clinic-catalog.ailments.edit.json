{
  "id": "clinic-catalog.ailments.edit",
  "title": "Editar el padecimiento",
  "module": "Catálogo de la Clínica",
  "summary": "Cambiar sus datos.",
  "screens": [
    "clinic-catalog.ailments"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar padecimiento",
    "modificar padecimiento"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/ailments",
      "title": "Menú → Catálogo de la Clínica → Padecimientos",
      "details": "Las enfermedades y condiciones que se cargan en la anamnesis; las de nivel de alerta alto aparecen como alerta en la ficha del paciente."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.ailments.filter.search",
      "title": "Buscá el padecimiento",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.ailments.section.first-row",
      "title": "Elegí el padecimiento",
      "until": "clinic-catalog.ailments.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "clinic-catalog.ailments.btn.edit",
      "title": "Editar",
      "until": "clinic-catalog.ailments.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "nombre",
      "action": "highlight",
      "target": "clinic-catalog.ailments.field.nombre",
      "title": "Nombre",
      "skipIfMissing": true
    },
    {
      "id": "categoria",
      "action": "highlight",
      "target": "clinic-catalog.ailments.field.categoria",
      "title": "Categoría",
      "skipIfMissing": true
    },
    {
      "id": "nivel_alerta",
      "action": "highlight",
      "target": "clinic-catalog.ailments.field.nivel_alerta",
      "title": "Nivel de alerta",
      "details": "Alto: se muestra como alerta en la ficha del paciente.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.ailments.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
