{
  "id": "permissions.edit",
  "title": "Editar un permiso",
  "module": "Sistema",
  "summary": "Pestaña Datos de la ficha.",
  "screens": [
    "permissions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar permiso",
    "modificar permiso"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/permissions",
      "title": "Menú → Sistema → Permisos",
      "details": "Cada acción que se puede habilitar (ver, crear, editar…) sobre cada pantalla."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "permissions.filter.search",
      "title": "Buscá el permiso",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "permissions.section.first-row",
      "title": "Elegí el permiso",
      "until": "permissions.section.detail",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "permissions.detail.tab.details",
      "title": "Datos",
      "until": "permissions.detail.field.name",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "permissions.detail.field.name",
      "title": "Nombre"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "permissions.detail.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
