{
  "id": "system.audit.overview",
  "title": "Consultar Registro de Auditoría",
  "module": "Sistema",
  "summary": "Qué cambió cada usuario: alta, edición o baja de registros, con el antes y el después.",
  "screens": [
    "system.audit"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "auditoría",
    "quién cambió",
    "historial de cambios"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/audit",
      "title": "Menú → Sistema → Registro de Auditoría",
      "details": "Qué cambió cada usuario: alta, edición o baja de registros, con el antes y el después."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.audit.filter.search",
      "title": "Buscar",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.audit.section.first-row",
      "title": "El más reciente",
      "details": "Tocalo para ver el detalle.",
      "until": "system.audit.section.detail",
      "autoClick": true,
      "skipIfMissing": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "system.audit.section.detail",
      "title": "Detalle",
      "skipIfMissing": true
    }
  ]
}
