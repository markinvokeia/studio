{
  "id": "purchases.providers.email",
  "title": "Enviar un email al proveedor",
  "module": "Compras",
  "summary": "Botón Email de la ficha.",
  "screens": [
    "purchases.providers"
  ],
  "group": "Comunicación y estado",
  "inputs": {
    "query": "Nombre, correo o RUT",
    "subject": "Asunto"
  },
  "keywords": [
    "email al proveedor",
    "correo al proveedor"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/providers",
      "title": "Menú → Compras → Proveedores",
      "details": "Laboratorios, depósitos y servicios a los que la clínica les compra; con su cuenta: presupuestos, facturas y pagos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.providers.filter.search",
      "title": "Buscá el proveedor",
      "details": "Por nombre, correo o RUT.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.providers.section.first-row",
      "title": "Abrí su ficha",
      "until": "purchases.providers.section.detail",
      "autoClick": true
    },
    {
      "id": "email",
      "action": "click",
      "target": "purchases.providers.btn.email",
      "title": "Email",
      "until": "purchases.providers.field.email-subject",
      "skipIfMissing": true
    },
    {
      "id": "to",
      "action": "highlight",
      "target": "purchases.providers.field.email-to",
      "title": "Para",
      "skipIfMissing": true
    },
    {
      "id": "subject",
      "action": "fill",
      "target": "purchases.providers.field.email-subject",
      "title": "Asunto",
      "value": "{{values.subject}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "send",
      "action": "confirm",
      "target": "purchases.providers.btn.email-send",
      "title": "Enviar",
      "skipIfMissing": true
    }
  ]
}
