{
  "id": "permissions.overview",
  "title": "Recorrer Permisos",
  "module": "Sistema",
  "summary": "Cada acción que se puede habilitar (ver, crear, editar…) sobre cada pantalla.",
  "screens": [
    "permissions"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "permisos",
    "permiso",
    "ver permiso"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/permissions",
      "title": "Menú → Sistema → Permisos",
      "details": "Cada acción que se puede habilitar (ver, crear, editar…) sobre cada pantalla."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "permissions.filter.search",
      "title": "Buscá el permiso",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "permissions.section.first-row",
      "title": "Elegí el permiso",
      "until": "permissions.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "permissions.section.detail",
      "title": "Ficha"
    },
    {
      "id": "tab-details",
      "action": "click",
      "target": "permissions.detail.tab.details",
      "title": "Datos",
      "skipIfMissing": true
    },
    {
      "id": "tab-users",
      "action": "click",
      "target": "permissions.detail.tab.users",
      "title": "Usuarios",
      "details": "Quiénes tienen este permiso por sus roles.",
      "skipIfMissing": true
    }
  ]
}
