{
  "id": "patients.notes",
  "title": "Anotar algo en la ficha del paciente",
  "module": "Pacientes",
  "summary": "Notas internas del paciente (no clínicas): preferencias, avisos para recepción.",
  "screens": [
    "patients"
  ],
  "group": "Información",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente",
    "notes": "Texto de la nota"
  },
  "keywords": [
    "notas",
    "anotar",
    "observaciones",
    "nota del paciente",
    "comentario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "info",
      "action": "click",
      "target": "patients.tab.info",
      "title": "Información",
      "skipIfMissing": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "patients.tab.notes",
      "title": "Notas",
      "details": "Texto libre interno; lo ve el equipo, no el paciente.",
      "until": "patients.section.notes"
    },
    {
      "id": "edit",
      "action": "click",
      "target": "patients.btn.notes-edit",
      "title": "Editar notas",
      "until": "patients.field.notes-text",
      "skipIfMissing": true
    },
    {
      "id": "text",
      "action": "fill",
      "target": "patients.field.notes-text",
      "title": "Escribí la nota",
      "value": "{{values.notes}}",
      "optional": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.notes-save",
      "title": "Guardar",
      "details": "Guarda la nota. Cancelar descarta lo escrito."
    }
  ]
}
