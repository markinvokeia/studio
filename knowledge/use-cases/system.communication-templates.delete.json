{
  "id": "system.communication-templates.delete",
  "title": "Eliminar la plantilla",
  "module": "Sistema",
  "summary": "Borrar (pide confirmación).",
  "screens": [
    "system.communication-templates"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar plantilla",
    "borrar plantilla"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/communication-templates",
      "title": "Menú → Sistema → Plantillas de Alertas",
      "details": "Los textos de correo, SMS y WhatsApp que usan las alertas, con variables del paciente y del caso."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.communication-templates.filter.search",
      "title": "Buscá la plantilla",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.communication-templates.section.first-row",
      "title": "Elegí la plantilla",
      "until": "system.communication-templates.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "system.communication-templates.btn.delete",
      "title": "Eliminar",
      "until": "system.communication-templates.btn.confirm-action",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "system.communication-templates.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer.",
      "skipIfMissing": true
    }
  ]
}
