{
  "id": "config.sequences.delete",
  "title": "Eliminar la secuencia",
  "module": "Configuración de Negocio",
  "summary": "Borrar una secuencia (pide confirmación).",
  "screens": [
    "config.sequences"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar secuencia",
    "borrar secuencia",
    "quitar secuencia"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/sequences",
      "title": "Menú → Configuración de Negocio → Secuencias",
      "details": "La numeración de facturas, presupuestos, órdenes y pagos: patrón con variables y cada cuánto se reinicia el contador."
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.sequences.section.first-row",
      "title": "Elegí la secuencia",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.sequences.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "config.sequences.btn.delete",
      "title": "Eliminar",
      "until": "config.sequences.btn.confirm-action"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "config.sequences.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
