{
  "id": "purchases.invoices.confirm",
  "title": "Confirmar una factura",
  "module": "Compras",
  "summary": "Pasar una factura de borrador a confirmada; recién ahí se puede pagar.",
  "screens": [
    "purchases.invoices"
  ],
  "inputs": {
    "query": "Número de factura"
  },
  "keywords": [
    "confirmar factura",
    "emitir factura",
    "asentar factura"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/invoices",
      "title": "Menú → Compras → Facturas de Compra",
      "details": "Lo que la clínica le debe a un proveedor: sale de un presupuesto de compra o se carga/importa directo."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.invoices.filter.search",
      "title": "Buscá la factura",
      "details": "Por número de documento.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.invoices.section.first-row",
      "title": "Abrí la factura",
      "details": "Tocala en la lista. La guía sigue cuando se abre su detalle.",
      "until": "purchases.invoices.section.summary",
      "autoClick": true
    },
    {
      "id": "confirm",
      "action": "click",
      "target": "purchases.invoices.btn.confirm",
      "title": "Confirmar",
      "details": "Sólo en borradores.",
      "until": "purchases.invoices.btn.confirm-ok",
      "skipIfMissing": true
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "purchases.invoices.btn.confirm-ok",
      "title": "Confirmar factura",
      "details": "Confirmada ya no se editan sus ítems.",
      "skipIfMissing": true
    }
  ]
}
