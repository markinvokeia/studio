{
  "id": "alerts.snooze",
  "title": "Pausar una alerta hasta otra fecha",
  "module": "Centro de Alertas",
  "summary": "Sacar una alerta de la bandeja hasta una fecha, con el motivo.",
  "screens": [
    "alerts"
  ],
  "inputs": {
    "quick": "1d | 3d | 1w",
    "date": "Fecha AAAA-MM-DDTHH:MM",
    "reason": "Motivo"
  },
  "keywords": [
    "pausar",
    "posponer",
    "mas tarde",
    "recordar despues",
    "snooze"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/alerts",
      "title": "Menú → Centro de Alertas",
      "details": "Lo que el sistema detectó con las reglas de alertas y el equipo tiene que trabajar."
    },
    {
      "id": "open",
      "action": "highlight",
      "target": "alerts.btn.snooze",
      "title": "Pausar",
      "until": "alerts.field.snooze-date",
      "autoClick": true,
      "details": "Tocá el reloj de la alerta. Hacelo en la alerta que quieras trabajar."
    },
    {
      "id": "quick",
      "action": "click",
      "target": "alerts.btn.snooze-{{values.quick}}",
      "optional": true,
      "title": "Opción rápida"
    },
    {
      "id": "date",
      "action": "fill",
      "target": "alerts.field.snooze-date",
      "value": "{{values.date}}",
      "optional": true,
      "ask": true,
      "title": "Hasta cuándo",
      "details": "Usá 1 día, 3 días o 1 semana, o elegí la fecha. Vuelve a aparecer ese día."
    },
    {
      "id": "reason",
      "action": "fill",
      "target": "alerts.field.snooze-reason",
      "value": "{{values.reason}}",
      "optional": true,
      "ask": true,
      "title": "Motivo"
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "alerts.btn.snooze-confirm",
      "title": "Pausar"
    }
  ]
}
