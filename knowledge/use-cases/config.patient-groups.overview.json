{
  "id": "config.patient-groups.overview",
  "title": "Recorrer Grupos de Pacientes",
  "module": "Configuración de Negocio",
  "summary": "Agrupaciones de pacientes (Ortodoncia, Convenio X) con sus servicios, para reportar lo producido y cobrado por grupo.",
  "screens": [
    "config.patient-groups"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "grupos de pacientes",
    "grupo de pacientes",
    "ver grupo de pacientes",
    "qué es grupo de pacientes"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/patient-groups",
      "title": "Menú → Configuración de Negocio → Grupos de Pacientes",
      "details": "Agrupaciones de pacientes (Ortodoncia, Convenio X) con sus servicios, para reportar lo producido y cobrado por grupo."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.patient-groups.filter.search",
      "title": "Buscá el grupo de pacientes",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.patient-groups.section.first-row",
      "title": "Elegí el grupo de pacientes",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.patient-groups.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.patient-groups.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.patient-groups.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.patient-groups.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.patient-groups.btn.new",
      "title": "Crear",
      "details": "Agrega un nuevo grupo de pacientes.",
      "skipIfMissing": true
    }
  ]
}
