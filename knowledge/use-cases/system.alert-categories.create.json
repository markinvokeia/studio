{
  "id": "system.alert-categories.create",
  "title": "Crear una categoría",
  "module": "Sistema",
  "summary": "Alta de una categoría.",
  "screens": [
    "system.alert-categories"
  ],
  "inputs": {
    "name": "Nombre",
    "code": "Código"
  },
  "keywords": [
    "nueva categoría",
    "nuevo categoría",
    "crear categoría"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/alert-categories",
      "title": "Menú → Sistema → Categorías de Alertas",
      "details": "Agrupan las alertas en el Centro de Alertas (cobranza, citas, cumpleaños…), con color, ícono y orden."
    },
    {
      "id": "new",
      "action": "click",
      "target": "system.alert-categories.btn.new",
      "title": "Crear",
      "until": "system.alert-categories.field.name"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "system.alert-categories.field.name",
      "title": "Nombre",
      "value": "{{values.name}}"
    },
    {
      "id": "code",
      "action": "fill",
      "target": "system.alert-categories.field.code",
      "title": "Código",
      "details": "Identificador interno, sin espacios.",
      "value": "{{values.code}}"
    },
    {
      "id": "color",
      "action": "highlight",
      "target": "system.alert-categories.field.color",
      "title": "Color",
      "skipIfMissing": true
    },
    {
      "id": "icon",
      "action": "highlight",
      "target": "system.alert-categories.field.icon",
      "title": "Ícono",
      "skipIfMissing": true
    },
    {
      "id": "internal_category_id",
      "action": "highlight",
      "target": "system.alert-categories.field.internal_category_id",
      "title": "Categoría interna",
      "details": "A qué módulo pertenece.",
      "skipIfMissing": true
    },
    {
      "id": "sort_order",
      "action": "highlight",
      "target": "system.alert-categories.field.sort_order",
      "title": "Orden",
      "details": "Posición en el Centro de Alertas.",
      "skipIfMissing": true
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "system.alert-categories.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "system.alert-categories.field.is_active",
      "title": "Activa",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.alert-categories.btn.submit",
      "title": "Guardar"
    }
  ]
}
