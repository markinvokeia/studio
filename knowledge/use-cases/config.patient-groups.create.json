{
  "id": "config.patient-groups.create",
  "title": "Crear un grupo de pacientes",
  "module": "Configuración de Negocio",
  "summary": "Alta de un grupo de pacientes.",
  "screens": [
    "config.patient-groups"
  ],
  "inputs": {
    "name": "Nombre"
  },
  "keywords": [
    "nuevo grupo de pacientes",
    "nueva grupo de pacientes",
    "crear grupo de pacientes",
    "agregar grupo de pacientes"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/patient-groups",
      "title": "Menú → Configuración de Negocio → Grupos de Pacientes",
      "details": "Agrupaciones de pacientes (Ortodoncia, Convenio X) con sus servicios, para reportar lo producido y cobrado por grupo."
    },
    {
      "id": "new",
      "action": "click",
      "target": "config.patient-groups.btn.new",
      "title": "Crear",
      "until": "config.patient-groups.field.name"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "config.patient-groups.field.name",
      "title": "Nombre",
      "details": "Ej.: Ortodoncia.",
      "value": "{{values.name}}"
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "config.patient-groups.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "user_id",
      "action": "highlight",
      "target": "config.patient-groups.field.user_id",
      "title": "Doctor responsable",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.patient-groups.field.is_active",
      "title": "Activo",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.patient-groups.btn.submit",
      "title": "Guardar"
    }
  ]
}
