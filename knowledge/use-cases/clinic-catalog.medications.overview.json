{
  "id": "clinic-catalog.medications.overview",
  "title": "Recorrer Medicamentos",
  "module": "Catálogo de la Clínica",
  "summary": "Los medicamentos que se usan en recetas y en la medicación habitual del paciente.",
  "screens": [
    "clinic-catalog.medications"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "medicamentos",
    "medicamento",
    "catálogo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/medications",
      "title": "Menú → Catálogo de la Clínica → Medicamentos",
      "details": "Los medicamentos que se usan en recetas y en la medicación habitual del paciente."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.medications.filter.search",
      "title": "Buscá el medicamento",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.medications.section.first-row",
      "title": "Elegí el medicamento",
      "until": "clinic-catalog.medications.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "clinic-catalog.medications.section.detail",
      "title": "Detalle"
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "clinic-catalog.medications.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "clinic-catalog.medications.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "clinic-catalog.medications.btn.new",
      "title": "Crear",
      "skipIfMissing": true
    }
  ]
}
