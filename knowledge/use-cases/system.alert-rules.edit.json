{
  "id": "system.alert-rules.edit",
  "title": "Editar la regla",
  "module": "Sistema",
  "summary": "Cambiar una regla existente.",
  "screens": [
    "system.alert-rules"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar regla",
    "modificar regla"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/system/alert-rules",
      "title": "Menú → Sistema → Reglas de Alertas",
      "details": "Qué genera una alerta y cuándo: tabla y fecha del evento, días antes o después, recurrencia, prioridad y las plantillas de correo, WhatsApp o SMS que se mandan."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "system.alert-rules.filter.search",
      "title": "Buscá la regla",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "system.alert-rules.section.first-row",
      "title": "Elegí la regla",
      "until": "system.alert-rules.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "system.alert-rules.btn.edit",
      "title": "Editar",
      "until": "system.alert-rules.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "system.alert-rules.field.name",
      "title": "Nombre",
      "skipIfMissing": true
    },
    {
      "id": "code",
      "action": "highlight",
      "target": "system.alert-rules.field.code",
      "title": "Código",
      "skipIfMissing": true
    },
    {
      "id": "category_id",
      "action": "highlight",
      "target": "system.alert-rules.field.category_id",
      "title": "Categoría",
      "details": "Dónde aparece en el Centro de Alertas.",
      "skipIfMissing": true
    },
    {
      "id": "source_table",
      "action": "highlight",
      "target": "system.alert-rules.field.source_table",
      "title": "Origen",
      "details": "De dónde salen los casos (citas, facturas, pacientes…).",
      "skipIfMissing": true
    },
    {
      "id": "event_field",
      "action": "highlight",
      "target": "system.alert-rules.field.event_field",
      "title": "Fecha del evento",
      "details": "La fecha contra la que se cuentan los días.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "system.alert-rules.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
