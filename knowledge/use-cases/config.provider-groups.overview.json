{
  "id": "config.provider-groups.overview",
  "title": "Recorrer Grupos de Proveedores",
  "module": "Configuración de Negocio",
  "summary": "Agrupaciones de proveedores para ordenar compras y reportes.",
  "screens": [
    "config.provider-groups"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "grupos de proveedores",
    "grupo de proveedores",
    "ver grupo de proveedores",
    "qué es grupo de proveedores"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/provider-groups",
      "title": "Menú → Configuración de Negocio → Grupos de Proveedores",
      "details": "Agrupaciones de proveedores para ordenar compras y reportes."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.provider-groups.filter.search",
      "title": "Buscá el grupo de proveedores",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.provider-groups.section.first-row",
      "title": "Elegí el grupo de proveedores",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.provider-groups.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.provider-groups.section.detail",
      "title": "Detalle",
      "details": "Los datos del registro elegido."
    },
    {
      "id": "edit",
      "action": "highlight",
      "target": "config.provider-groups.btn.edit",
      "title": "Editar",
      "skipIfMissing": true
    },
    {
      "id": "delete",
      "action": "highlight",
      "target": "config.provider-groups.btn.delete",
      "title": "Eliminar",
      "details": "Pide confirmación.",
      "skipIfMissing": true
    },
    {
      "id": "new",
      "action": "highlight",
      "target": "config.provider-groups.btn.new",
      "title": "Crear",
      "details": "Agrega un nuevo grupo de proveedores.",
      "skipIfMissing": true
    }
  ]
}
