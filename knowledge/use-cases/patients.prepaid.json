{
  "id": "patients.prepaid",
  "title": "Registrar un prepago",
  "module": "Pacientes",
  "summary": "Crear → Prepago: dinero que el paciente deja a cuenta; se usa después para pagar facturas.",
  "screens": [
    "patients"
  ],
  "group": "Finanzas",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente",
    "amount": "Monto",
    "notes": "Notas"
  },
  "keywords": [
    "prepago",
    "seña",
    "pago a cuenta",
    "anticipo",
    "adelanto"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "patients.btn.create-menu",
      "title": "Crear",
      "details": "Todo lo que se puede crear para este paciente: clínico, financiero y agenda.",
      "until": "patients.btn.new-prepaid"
    },
    {
      "id": "item",
      "action": "click",
      "target": "patients.btn.new-prepaid",
      "title": "Prepago",
      "details": "Abre el registro de prepago. Necesita la caja abierta.",
      "until": "patients.field.payment_amount"
    },
    {
      "id": "amount",
      "action": "fill",
      "target": "patients.field.payment_amount",
      "title": "Monto",
      "value": "{{values.amount}}",
      "optional": true
    },
    {
      "id": "currency",
      "action": "highlight",
      "target": "patients.field.currency",
      "title": "Moneda"
    },
    {
      "id": "method",
      "action": "highlight",
      "target": "patients.field.payment_method_id",
      "title": "Medio de pago",
      "details": "Efectivo suma al arqueo de caja."
    },
    {
      "id": "notes",
      "action": "fill",
      "target": "patients.field.notes",
      "title": "Notas",
      "value": "{{values.notes}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.submit",
      "title": "Guardar el prepago",
      "details": "Queda como saldo a favor del paciente."
    }
  ]
}
