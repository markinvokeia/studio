{
  "id": "permissions.create",
  "title": "Crear un permiso",
  "module": "Sistema",
  "summary": "Alta de un permiso.",
  "screens": [
    "permissions"
  ],
  "inputs": {
    "name": "Nombre"
  },
  "keywords": [
    "nuevo permiso",
    "crear permiso"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/permissions",
      "title": "Menú → Sistema → Permisos",
      "details": "Cada acción que se puede habilitar (ver, crear, editar…) sobre cada pantalla."
    },
    {
      "id": "new",
      "action": "click",
      "target": "permissions.btn.new",
      "title": "Crear",
      "until": "permissions.field.name"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "permissions.field.name",
      "title": "Nombre",
      "value": "{{values.name}}"
    },
    {
      "id": "action",
      "action": "highlight",
      "target": "permissions.field.action",
      "title": "Acción",
      "skipIfMissing": true
    },
    {
      "id": "resource",
      "action": "highlight",
      "target": "permissions.field.resource",
      "title": "Recurso",
      "skipIfMissing": true
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "permissions.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "permissions.btn.submit",
      "title": "Guardar"
    }
  ]
}
