{
  "id": "purchases.invoices.import",
  "title": "Importar facturas de proveedores",
  "module": "Compras",
  "summary": "Cargar facturas de compra desde un archivo.",
  "screens": [
    "purchases.invoices"
  ],
  "keywords": [
    "importar facturas",
    "cargar archivo",
    "subir facturas"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/invoices",
      "title": "Menú → Compras → Facturas de Compra",
      "details": "Lo que la clínica le debe a un proveedor: sale de un presupuesto de compra o se carga/importa directo."
    },
    {
      "id": "import",
      "action": "click",
      "target": "purchases.invoices.btn.import",
      "title": "Importar",
      "until": "purchases.invoices.btn.import-submit"
    },
    {
      "id": "file",
      "action": "highlight",
      "target": "purchases.invoices.field.import-file",
      "title": "Archivo",
      "details": "Tocá o arrastrá el archivo.",
      "skipIfMissing": true
    },
    {
      "id": "run",
      "action": "confirm",
      "target": "purchases.invoices.btn.import-submit",
      "title": "Importar",
      "details": "Se habilita cuando elegiste el archivo."
    }
  ]
}
