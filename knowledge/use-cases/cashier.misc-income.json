{
  "id": "cashier.misc-income",
  "title": "Registrar un ingreso de caja",
  "module": "Caja",
  "summary": "Entrada de dinero que no es un cobro a un paciente (aporte para cambio, reintegro, venta menor).",
  "screens": [
    "cashier.miscellaneous-transactions",
    "cashier"
  ],
  "inputs": {
    "category": "Nombre de la categoría",
    "beneficiary": "Nombre",
    "date": "Fecha AAAA-MM-DD",
    "payment_method": "Medio de pago (ej. Efectivo)",
    "amount": "Monto (número)",
    "currency": "Moneda",
    "description": "Descripción",
    "reference": "Nro. de comprobante",
    "tags": "Etiquetas separadas por coma"
  },
  "keywords": [
    "ingreso",
    "entrada de caja",
    "aporte",
    "reintegro",
    "deposito en caja"
  ],
  "steps": [
    {
      "id": "closed",
      "action": "highlight",
      "target": "cashier.section.cash-points",
      "title": "Primero abrí la caja",
      "details": "Los movimientos se registran en la sesión de caja abierta: te guío por la apertura y después volvemos.",
      "onlyIf": "cash-session-closed@start",
      "skipIfMissing": true
    },
    {
      "id": "o-go",
      "action": "navigate",
      "route": "/cashier",
      "title": "Menú → Caja → Caja",
      "details": "La caja del día: apertura, movimientos y cierre.",
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-point",
      "action": "highlight",
      "target": "cashier.btn.open-session",
      "title": "Elegí la caja a abrir",
      "details": "Cada caja física (recepción, otra sede) se abre por separado. Si ya tenés una caja abierta, las demás quedan deshabilitadas.",
      "until": [
        "cashier.field.date-rate",
        "cashier.section.count"
      ],
      "autoClick": true,
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-rate",
      "action": "fill",
      "target": "cashier.field.date-rate",
      "value": "{{values.exchange_rate}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true,
      "title": "Tipo de cambio",
      "details": "Sólo si la clínica trabaja con dos monedas: el tipo de cambio del día para convertir entre ellas. Se trae solo; podés corregirlo.",
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-currency",
      "action": "highlight",
      "target": "cashier.field.open-currency",
      "title": "Moneda principal",
      "details": "La moneda en la que se lleva la caja.",
      "skipIfMissing": true,
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-next-config",
      "action": "highlight",
      "target": "cashier.btn.open-next",
      "title": "Siguiente",
      "details": "Pasa al conteo del efectivo.",
      "until": "cashier.section.count",
      "autoClick": true,
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-prefill",
      "action": "click",
      "target": "cashier.btn.prefill-{{values.prefill}}",
      "title": "Rellenar el conteo",
      "optional": true,
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-count",
      "action": "highlight",
      "target": "cashier.section.count",
      "title": "Contá el efectivo de apertura",
      "details": "Cuántos billetes y monedas de cada valor hay en la caja al abrir; arriba se ve el total. «Rellenar con último cierre» copia lo que quedó en el cierre anterior; «Rellenar con 0» si la caja empieza vacía.",
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-next",
      "action": "highlight",
      "target": "cashier.btn.open-next",
      "title": "Siguiente",
      "details": "Si hay más de una moneda, se cuenta cada una.",
      "until": "cashier.section.open-summary",
      "autoClick": true,
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-summary",
      "action": "highlight",
      "target": "cashier.section.open-summary",
      "title": "Revisá la apertura",
      "details": "Caja, usuario, fecha, moneda, tipo de cambio y el total contado por moneda (con su desglose).",
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "o-confirm",
      "action": "confirm",
      "target": "cashier.btn.open-confirm",
      "title": "Confirmar y abrir",
      "details": "Desde ahora los cobros, pagos y movimientos varios se registran en esta caja.",
      "onlyIf": "cash-session-closed@start"
    },
    {
      "id": "go",
      "action": "navigate",
      "route": "/cashier/miscellaneous-transactions",
      "title": "Menú → Caja → Transacciones Misceláneas",
      "details": "Entradas y salidas de dinero que no son cobros a pacientes: gastos menores, retiros, aportes."
    },
    {
      "id": "new",
      "action": "click",
      "target": "cashier.miscellaneous-transactions.btn.new",
      "title": "Nueva transacción"
    },
    {
      "id": "category",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.category_id",
      "value": "{{values.category}}",
      "title": "Categoría",
      "details": "La categoría define si es ingreso. Ejemplo: «Aporte de socios». Las categorías se crean en Caja → Categorías."
    },
    {
      "id": "beneficiary",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.beneficiary_name",
      "value": "{{values.beneficiary}}",
      "optional": true,
      "ask": true,
      "title": "Quién lo entrega",
      "details": "Ejemplo: «Dra. Lucía Pereira»."
    },
    {
      "id": "date",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.transaction_date",
      "value": "{{values.date}}",
      "optional": true,
      "ask": true,
      "title": "Fecha"
    },
    {
      "id": "method",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.payment_method_id",
      "value": "{{values.payment_method}}",
      "title": "Medio de pago",
      "details": "Efectivo mueve el efectivo en mano de la caja; con otro medio queda registrado pero no cambia el conteo."
    },
    {
      "id": "amount",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.amount",
      "value": "{{values.amount}}",
      "title": "Monto",
      "details": "Ejemplo: 5000."
    },
    {
      "id": "currency",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.currency",
      "value": "{{values.currency}}",
      "optional": true,
      "ask": true,
      "title": "Moneda"
    },
    {
      "id": "description",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.description",
      "value": "{{values.description}}",
      "title": "Descripción",
      "details": "Ejemplo: «Aporte de efectivo para cambio»."
    },
    {
      "id": "reference",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.external_reference",
      "value": "{{values.reference}}",
      "optional": true,
      "ask": true,
      "title": "Referencia",
      "details": "Número de factura o ticket del comprobante."
    },
    {
      "id": "tags",
      "action": "fill",
      "target": "cashier.miscellaneous-transactions.field.tags",
      "value": "{{values.tags}}",
      "optional": true,
      "ask": true,
      "title": "Etiquetas",
      "details": "Separadas por coma, para agrupar en reportes."
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "cashier.miscellaneous-transactions.btn.submit",
      "title": "Crear",
      "details": "Queda en la sesión de caja abierta como ingreso."
    }
  ]
}
