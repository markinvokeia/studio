{
  "id": "sales.invoices.items",
  "title": "Ver y cambiar los ítems de una factura",
  "module": "Ventas",
  "summary": "Pestaña Artículos; en borrador se agregan, editan o quitan líneas.",
  "screens": [
    "sales.invoices"
  ],
  "inputs": {
    "query": "Número de factura"
  },
  "keywords": [
    "ítems de la factura",
    "líneas de la factura",
    "agregar a la factura"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/sales/invoices",
      "title": "Menú → Ventas → Facturas",
      "details": "Lo que se le cobra al paciente: sale de un presupuesto confirmado, de un cobro rápido o se carga directo."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "sales.invoices.filter.search",
      "title": "Buscá la factura",
      "details": "Por número de documento.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "sales.invoices.section.first-row",
      "title": "Abrí la factura",
      "details": "Tocala en la lista. La guía sigue cuando se abre su detalle.",
      "until": "sales.invoices.section.summary",
      "autoClick": true
    },
    {
      "id": "tab",
      "action": "click",
      "target": "sales.invoices.tab.items",
      "title": "Artículos"
    },
    {
      "id": "row",
      "action": "highlight",
      "target": "sales.invoices.detail.section.first-row",
      "title": "Un ítem",
      "skipIfMissing": true
    },
    {
      "id": "add",
      "action": "highlight",
      "target": "sales.invoices.detail.btn.new",
      "title": "Agregar ítem",
      "details": "Sólo en borradores.",
      "skipIfMissing": true
    }
  ]
}
