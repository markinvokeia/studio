{
  "id": "config.patient-groups.edit",
  "title": "Editar el grupo de pacientes",
  "module": "Configuración de Negocio",
  "summary": "Cambiar los datos de un grupo de pacientes existente.",
  "screens": [
    "config.patient-groups"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar grupo de pacientes",
    "modificar grupo de pacientes",
    "cambiar grupo de pacientes"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/patient-groups",
      "title": "Menú → Configuración de Negocio → Grupos de Pacientes",
      "details": "Agrupaciones de pacientes (Ortodoncia, Convenio X) con sus servicios, para reportar lo producido y cobrado por grupo."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.patient-groups.filter.search",
      "title": "Buscá el grupo de pacientes",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.patient-groups.section.first-row",
      "title": "Elegí el grupo de pacientes",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.patient-groups.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "config.patient-groups.btn.edit",
      "title": "Editar",
      "until": "config.patient-groups.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "name",
      "action": "highlight",
      "target": "config.patient-groups.field.name",
      "title": "Nombre",
      "details": "Ej.: Ortodoncia."
    },
    {
      "id": "description",
      "action": "highlight",
      "target": "config.patient-groups.field.description",
      "title": "Descripción",
      "skipIfMissing": true
    },
    {
      "id": "user_id",
      "action": "highlight",
      "target": "config.patient-groups.field.user_id",
      "title": "Doctor responsable",
      "skipIfMissing": true
    },
    {
      "id": "is_active",
      "action": "highlight",
      "target": "config.patient-groups.field.is_active",
      "title": "Activo",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "config.patient-groups.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
