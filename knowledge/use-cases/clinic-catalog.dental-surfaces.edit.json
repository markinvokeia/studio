{
  "id": "clinic-catalog.dental-surfaces.edit",
  "title": "Editar la superficie dental",
  "module": "Catálogo de la Clínica",
  "summary": "Cambiar sus datos.",
  "screens": [
    "clinic-catalog.dental-surfaces"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "editar superficie dental",
    "modificar superficie dental"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/clinic-catalog/dental-surfaces",
      "title": "Menú → Catálogo de la Clínica → Superficies Dentales",
      "details": "Las caras de cada pieza (oclusal, mesial, distal…) que se eligen en el odontograma."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "clinic-catalog.dental-surfaces.filter.search",
      "title": "Buscá la superficie dental",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "clinic-catalog.dental-surfaces.section.first-row",
      "title": "Elegí la superficie dental",
      "until": "clinic-catalog.dental-surfaces.section.detail",
      "autoClick": true
    },
    {
      "id": "edit",
      "action": "click",
      "target": "clinic-catalog.dental-surfaces.btn.edit",
      "title": "Editar",
      "until": "clinic-catalog.dental-surfaces.btn.submit",
      "skipIfMissing": true
    },
    {
      "id": "nombre",
      "action": "highlight",
      "target": "clinic-catalog.dental-surfaces.field.nombre",
      "title": "Nombre",
      "skipIfMissing": true
    },
    {
      "id": "codigo",
      "action": "highlight",
      "target": "clinic-catalog.dental-surfaces.field.codigo",
      "title": "Código",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "clinic-catalog.dental-surfaces.btn.submit",
      "title": "Guardar cambios"
    }
  ]
}
