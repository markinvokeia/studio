{
  "id": "purchases.payments.send",
  "title": "Imprimir o enviar un recibo",
  "module": "Compras",
  "summary": "Imprimir el recibo de un pago o mandarlo por correo en PDF.",
  "screens": [
    "purchases.payments"
  ],
  "inputs": {
    "query": "Número de pago"
  },
  "keywords": [
    "recibo",
    "imprimir recibo",
    "enviar recibo",
    "comprobante de pago"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/payments",
      "title": "Menú → Compras → Pagos de Compra",
      "details": "Lo que la clínica le paga a proveedores: pagos de facturas de compra y anticipos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.payments.filter.search",
      "title": "Buscá el pago",
      "details": "Por número de documento.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.payments.section.first-row",
      "title": "Abrí el pago",
      "details": "Tocalo en la lista. La guía sigue cuando se abre su detalle.",
      "until": "purchases.payments.section.detail-header",
      "autoClick": true
    },
    {
      "id": "print",
      "action": "highlight",
      "target": "purchases.payments.btn.print",
      "title": "Imprimir recibo"
    },
    {
      "id": "email",
      "action": "click",
      "target": "purchases.payments.btn.email",
      "title": "Enviar por correo",
      "until": "purchases.payments.field.doc-email-to"
    },
    {
      "id": "to",
      "action": "highlight",
      "target": "purchases.payments.field.doc-email-to",
      "title": "Destinatarios"
    },
    {
      "id": "send",
      "action": "confirm",
      "target": "purchases.payments.btn.doc-email-send",
      "title": "Enviar"
    }
  ]
}
