{
  "id": "config.doctors.overview",
  "title": "Recorrer Doctores",
  "module": "Configuración de Negocio",
  "summary": "Listado, ficha con pestañas y acceso al sistema.",
  "screens": [
    "config.doctors"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "doctores",
    "ver profesional"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctors",
      "title": "Menú → Configuración de Negocio → Doctores"
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.doctors.filter.search",
      "title": "Buscá",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.doctors.section.first-row",
      "title": "Elegí al profesional",
      "until": "config.doctors.section.detail",
      "autoClick": true
    },
    {
      "id": "detail",
      "action": "highlight",
      "target": "config.doctors.section.detail",
      "title": "Ficha"
    },
    {
      "id": "tab-details",
      "action": "click",
      "target": "config.doctors.tab.details",
      "title": "Datos",
      "details": "Nombre, contacto, sede activa, color y calendario de Google.",
      "skipIfMissing": true
    },
    {
      "id": "tab-services",
      "action": "click",
      "target": "config.doctors.tab.services",
      "title": "Servicios",
      "details": "Qué servicios atiende: la agenda sólo le ofrece esos.",
      "skipIfMissing": true
    },
    {
      "id": "tab-calendars",
      "action": "click",
      "target": "config.doctors.tab.calendars",
      "title": "Calendarios",
      "details": "En qué consultorios atiende.",
      "skipIfMissing": true
    },
    {
      "id": "tab-availability",
      "action": "click",
      "target": "config.doctors.tab.availability",
      "title": "Disponibilidad",
      "details": "Sus reglas de días y horas.",
      "skipIfMissing": true
    },
    {
      "id": "tab-exceptions",
      "action": "click",
      "target": "config.doctors.tab.exceptions",
      "title": "Excepciones",
      "details": "Licencias y días extra.",
      "skipIfMissing": true
    },
    {
      "id": "tab-signature",
      "action": "click",
      "target": "config.doctors.tab.signature",
      "title": "Firma",
      "details": "La firma que va en recetas e indicaciones.",
      "skipIfMissing": true
    },
    {
      "id": "tab-preferences",
      "action": "click",
      "target": "config.doctors.tab.preferences",
      "title": "Preferencias",
      "details": "Vista de agenda y avisos del profesional.",
      "skipIfMissing": true
    },
    {
      "id": "pw",
      "action": "highlight",
      "target": "config.doctors.btn.initial-password",
      "title": "Contraseña inicial",
      "details": "Le envía por correo una contraseña para entrar. Se envía al tocarlo.",
      "skipIfMissing": true
    }
  ]
}
