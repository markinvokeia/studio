{
  "id": "config.provider-groups.members",
  "title": "Agregar proveedores a un grupo",
  "module": "Configuración de Negocio",
  "summary": "Pestaña Proveedores del grupo.",
  "screens": [
    "config.provider-groups"
  ],
  "keywords": [
    "proveedores del grupo",
    "agregar proveedor al grupo"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/provider-groups",
      "title": "Menú → Configuración de Negocio → Grupos de Proveedores"
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.provider-groups.section.first-row",
      "title": "Elegí el grupo",
      "until": "config.provider-groups.section.detail",
      "autoClick": true
    },
    {
      "id": "providers",
      "action": "click",
      "target": "config.provider-groups.tab.providers",
      "title": "Proveedores",
      "details": "Agregá o quitá proveedores."
    },
    {
      "id": "info",
      "action": "click",
      "target": "config.provider-groups.tab.info",
      "title": "Información"
    }
  ]
}
