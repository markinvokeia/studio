    {
      "id": "currency",
      "action": "highlight",
      "target": "config.clinics.field.clinic-currency",
      "title": "Moneda principal"
    },
    {
      "id": "second",
      "action": "highlight",
      "target": "config.clinics.field.clinic-secondary-currency",
