{
  "id": "config.calendars.delete",
  "title": "Eliminar el calendario",
  "module": "Configuración de Negocio",
  "summary": "Borrar un calendario (pide confirmación).",
  "screens": [
    "config.calendars"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar calendario",
    "borrar calendario",
    "quitar calendario"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/calendars",
      "title": "Menú → Configuración de Negocio → Calendarios",
      "details": "Los consultorios o sillones: cada uno es una columna de la agenda, con su sede, color y quién atiende ahí."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.calendars.filter.search",
      "title": "Buscá el calendario",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.calendars.section.first-row",
      "title": "Elegí el calendario",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.calendars.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "config.calendars.btn.delete",
      "title": "Eliminar",
      "until": "config.calendars.btn.confirm-action"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "config.calendars.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
