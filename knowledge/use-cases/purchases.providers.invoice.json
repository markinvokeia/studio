{
  "id": "purchases.providers.invoice",
  "title": "Registrar una factura del proveedor",
  "module": "Compras",
  "summary": "Crear → Factura: lo que le debemos.",
  "screens": [
    "purchases.providers"
  ],
  "group": "Compras al proveedor",
  "inputs": {
    "query": "Nombre, correo o RUT",
    "service": "Producto o servicio",
    "quantity": "Cantidad"
  },
  "keywords": [
    "registrar una factura del proveedor",
    "proveedor"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/purchases/providers",
      "title": "Menú → Compras → Proveedores",
      "details": "Laboratorios, depósitos y servicios a los que la clínica les compra; con su cuenta: presupuestos, facturas y pagos."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "purchases.providers.filter.search",
      "title": "Buscá el proveedor",
      "details": "Por nombre, correo o RUT.",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "purchases.providers.section.first-row",
      "title": "Abrí su ficha",
      "until": "purchases.providers.section.detail",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "purchases.providers.btn.create-menu",
      "title": "Crear",
      "until": "purchases.providers.btn.new-invoice"
    },
    {
      "id": "item",
      "action": "click",
      "target": "purchases.providers.btn.new-invoice",
      "title": "Registrar una factura del proveedor",
      "details": "Crear → Factura: lo que le debemos.",
      "until": "purchases.providers.btn.submit"
    },
    {
      "id": "add-item",
      "action": "click",
      "target": "purchases.providers.btn.add-item",
      "title": "Agregar artículo",
      "details": "Suma una línea a la factura; sin al menos una no se puede guardar.",
      "until": "purchases.providers.field.items.service_id"
    },
    {
      "id": "service",
      "action": "fill",
      "target": "purchases.providers.field.items.service_id",
      "title": "Producto o servicio",
      "details": "Elegí el producto o servicio comprado; el precio unitario se completa solo desde el catálogo.",
      "value": "{{values.service}}",
      "ask": true
    },
    {
      "id": "qty",
      "action": "fill",
      "target": "purchases.providers.field.items.quantity",
      "title": "Cantidad",
      "details": "El total de la línea se recalcula con la cantidad.",
      "value": "{{values.quantity}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "purchases.providers.btn.submit",
      "title": "Guardar",
      "details": "Completá los datos del formulario y guardá."
    }
  ]
}
