{
  "id": "patients.clinical-session",
  "title": "Registrar una sesión clínica",
  "module": "Pacientes",
  "summary": "Desde la ficha: Crear → Sesión clínica. Procedimiento, diagnóstico, notas, plan de la próxima sesión y tratamientos realizados.",
  "screens": [
    "patients"
  ],
  "group": "Historia clínica",
  "inputs": {
    "patient": "Nombre, correo o documento del paciente",
    "procedure": "Procedimiento realizado",
    "diagnosis": "Diagnóstico",
    "notes": "Notas",
    "next_plan": "Plan de la próxima sesión",
    "doctor": "Profesional (ej. Dra. Lucía Fernández)"
  },
  "keywords": [
    "sesión clínica",
    "registrar atención",
    "evolución",
    "cargar sesión",
    "procedimiento",
    "consulta"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/patients",
      "title": "Menú → Pacientes",
      "details": "Listado de pacientes; al tocar uno se abre su ficha a la derecha."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "patients.filter.search",
      "title": "Buscá al paciente",
      "details": "Por nombre, correo o documento.",
      "value": "{{values.patient}}",
      "optional": true,
      "ask": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "patients.section.first-row",
      "title": "Abrí su ficha",
      "details": "Tocá al paciente en la lista. La guía sigue cuando su ficha está abierta.",
      "until": "patients.section.header",
      "autoClick": true
    },
    {
      "id": "menu",
      "action": "click",
      "target": "patients.btn.create-menu",
      "title": "Crear",
      "details": "Todo lo que se puede crear para este paciente: clínico, financiero y agenda.",
      "until": "patients.btn.new-session"
    },
    {
      "id": "item",
      "action": "click",
      "target": "patients.btn.new-session",
      "title": "Sesión clínica",
      "details": "Abre la historia clínica y el formulario de nueva sesión.",
      "until": "patients.field.session-procedure"
    },
    {
      "id": "date",
      "action": "highlight",
      "target": "patients.field.session-date",
      "title": "Fecha de la sesión",
      "skipIfMissing": true
    },
    {
      "id": "doctor",
      "action": "fill",
      "target": "patients.field.session-doctor",
      "title": "Profesional",
      "details": "Quien atendió.",
      "skipIfMissing": true,
      "value": "{{values.doctor}}",
      "ask": true
    },
    {
      "id": "procedure",
      "action": "fill",
      "target": "patients.field.session-procedure",
      "title": "Procedimiento",
      "details": "Lo que se hizo en la sesión.",
      "value": "{{values.procedure}}"
    },
    {
      "id": "diagnosis",
      "action": "fill",
      "target": "patients.field.session-diagnosis",
      "title": "Diagnóstico",
      "value": "{{values.diagnosis}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "notes",
      "action": "fill",
      "target": "patients.field.session-notes",
      "title": "Notas",
      "value": "{{values.notes}}",
      "optional": true,
      "skipIfMissing": true
    },
    {
      "id": "plan",
      "action": "fill",
      "target": "patients.field.session-next-plan",
      "title": "Plan de la próxima sesión",
      "details": "Se muestra al doctor en la próxima cita.",
      "value": "{{values.next_plan}}",
      "optional": true
    },
    {
      "id": "treatments",
      "action": "highlight",
      "target": "patients.field.session-treatments",
      "title": "Tratamientos",
      "details": "Marcá los del presupuesto que se hicieron hoy: quedan listos para facturar.",
      "skipIfMissing": true
    },
    {
      "id": "attachments",
      "action": "highlight",
      "target": "patients.field.session-attachments",
      "title": "Adjuntos",
      "details": "Radiografías, fotos o estudios de esta sesión.",
      "skipIfMissing": true
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "patients.btn.submit",
      "title": "Guardar la sesión",
      "details": "Queda en la línea de tiempo del paciente."
    }
  ]
}
