{
  "id": "config.doctor-availability.delete",
  "title": "Eliminar la regla de disponibilidad",
  "module": "Configuración de Negocio",
  "summary": "Borrar una regla de disponibilidad (pide confirmación).",
  "screens": [
    "config.doctor-availability"
  ],
  "inputs": {
    "query": "Buscar"
  },
  "keywords": [
    "eliminar regla de disponibilidad",
    "borrar regla de disponibilidad",
    "quitar regla de disponibilidad"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/config/doctor-availability",
      "title": "Menú → Configuración de Negocio → Disponibilidad Médica",
      "details": "Cuándo atiende cada profesional: días y horas, desde y hasta cuándo. La agenda sólo ofrece turnos dentro de esta disponibilidad."
    },
    {
      "id": "search",
      "action": "fill",
      "target": "config.doctor-availability.filter.search",
      "title": "Buscá la regla de disponibilidad",
      "value": "{{values.query}}",
      "optional": true,
      "ask": true,
      "skipIfMissing": true
    },
    {
      "id": "pick",
      "action": "highlight",
      "target": "config.doctor-availability.section.first-row",
      "title": "Elegí la regla de disponibilidad",
      "details": "Tocalo en la lista para ver su detalle.",
      "until": "config.doctor-availability.section.detail",
      "autoClick": true
    },
    {
      "id": "delete",
      "action": "click",
      "target": "config.doctor-availability.btn.delete",
      "title": "Eliminar",
      "until": "config.doctor-availability.btn.confirm-action"
    },
    {
      "id": "ok",
      "action": "confirm",
      "target": "config.doctor-availability.btn.confirm-action",
      "title": "Confirmar",
      "details": "No se puede deshacer."
    }
  ]
}
