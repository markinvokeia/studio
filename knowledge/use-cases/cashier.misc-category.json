{
  "id": "cashier.misc-category",
  "title": "Crear una categoría de gastos o ingresos",
  "module": "Caja",
  "summary": "Las categorías ordenan los movimientos varios y definen si son ingreso o gasto.",
  "screens": [
    "cashier.miscellaneous-categories"
  ],
  "inputs": {
    "name": "Nombre",
    "code": "Código",
    "description": "Descripción",
    "type": "Ingreso | Gasto"
  },
  "keywords": [
    "categoria",
    "tipo de gasto",
    "rubro",
    "clasificar gastos",
    "nueva categoria"
  ],
  "steps": [
    {
      "id": "go",
      "action": "navigate",
      "route": "/cashier/miscellaneous-categories",
      "title": "Menú → Caja → Categorías"
    },
    {
      "id": "new",
      "action": "click",
      "target": "cashier.miscellaneous-categories.btn.new",
      "title": "Nueva categoría"
    },
    {
      "id": "name",
      "action": "fill",
      "target": "cashier.miscellaneous-categories.field.name",
      "value": "{{values.name}}",
      "title": "Nombre",
      "details": "Ejemplos de gasto: Limpieza, Librería, Envíos. De ingreso: Aporte de socios, Reintegros."
    },
    {
      "id": "code",
      "action": "fill",
      "target": "cashier.miscellaneous-categories.field.code",
      "value": "{{values.code}}",
      "title": "Código",
      "details": "Corto y único, para los reportes (ej. LIMP)."
    },
    {
      "id": "description",
      "action": "fill",
      "target": "cashier.miscellaneous-categories.field.description",
      "value": "{{values.description}}",
      "optional": true,
      "ask": true,
      "title": "Descripción"
    },
    {
      "id": "type",
      "action": "fill",
      "target": "cashier.miscellaneous-categories.field.type",
      "value": "{{values.type}}",
      "title": "Tipo",
      "details": "Gasto: sale dinero de la caja. Ingreso: entra. No se puede cambiar después si ya tiene movimientos."
    },
    {
      "id": "active",
      "action": "highlight",
      "target": "cashier.miscellaneous-categories.field.is_active",
      "title": "Activa",
      "details": "Sólo las activas se ofrecen al registrar un movimiento."
    },
    {
      "id": "save",
      "action": "confirm",
      "target": "cashier.miscellaneous-categories.btn.submit",
      "title": "Crear"
    }
  ]
}
